import HardDiskB5Lean.Heads
import Solution
import Lean

/-!
# Axiom and placeholder audit (GENERATED by the release assembler; part of the default build)

Mode: release (no placeholder). Every failing check is logged as an error, so the build fails unless
1. each head theorem depends only on propext, Classical.choice, Quot.sound, judged head by head: sorryAx is allowed
   only for a head whose import closure contains an open placeholder (flag `true` below); a closed head (flag `false`)
   must use the standard three axioms only;
2. the constants of `HardDiskB5Lean.*` modules that use `sorry` directly are exactly the open placeholders below
   ("remaining sorry = remaining nodes"), and no constant of the generated band modules (`-`, built from
   the untrusted generator's output during `lake build`) uses `sorry` directly.
-/

open Lean Elab Command

elab "#repo_audit" : command => do
  let env ← getEnv
  let std : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let expected : List Name := []
  -- (head theorem, sorryAx allowed = its import closure contains an open placeholder)
  let heads : List (Name × Bool) := [(``HardDiskB5Lean.theorem_1_1, false),
    (``theorem_1_1, false)]
  for (h, allowSorry) in heads do
    let axs := (← liftCoreM <| Lean.collectAxioms h).toList
    logInfo m!"AUDIT axioms {h}: {axs} (sorryAx allowed: {allowSorry})"
    for a in axs do
      unless std.contains a || (allowSorry && a == ``sorryAx) do
        logError m!"AUDIT FAIL {h}: forbidden axiom {a}"
  let mods := env.header.moduleNames
  let direct := env.constants.map₁.fold (init := (#[] : Array Name)) fun acc n ci =>
    match env.getModuleIdxFor? n with
    | some idx =>
      if (mods[idx.toNat]!.getRoot == `HardDiskB5Lean || false) && ci.getUsedConstantsAsSet.contains ``sorryAx then
        acc.push n
      else acc
    | none => acc
  let found := (direct.qsort Name.lt).toList
  let want := (expected.toArray.qsort Name.lt).toList
  logInfo m!"AUDIT placeholders ({found.length}): {found}"
  unless found == want do
    logError m!"AUDIT FAIL placeholder mismatch (direct sorryAx users ≠ open nodes): found {found}, expected {want}"

#repo_audit
