namespace HardDiskB5.Lean

open scoped Classical in
/-- Factor of the ordered pair `a < b` in `V_{H,F}`: `1[|x_a-x_b|<1]` for an edge of `H`,
`1[|x_a-x_b| ≥ 1]` for a pair of `F` (not an edge of `H`), `1` otherwise. -/
def pairFactor {m : ℕ} (H F : SimpleGraph (Fin m)) (x : Fin m → Pt) (a b : Fin m) : ℝ :=
  if a < b ∧ H.Adj a b then ovl (x a) (x b)
  else if a < b ∧ F.Adj a b then (if 1 ≤ dist (x a) (x b) then 1 else 0) else 1

/-- `∏_{ij∈H} 1[|x_i-x_j|<1] ∏_{ij∈F} 1[|x_i-x_j|≥1]`. -/
def contactWeight {m : ℕ} (H F : SimpleGraph (Fin m)) (x : Fin m → Pt) : ℝ :=
  ∏ a : Fin m, ∏ b : Fin m, pairFactor H F x a b

/-- `V_{H,F}` (A Lemma 3.4) for a graph on `n+1` vertices, `x_0 = 0`. -/
def VHF {n : ℕ} (H F : SimpleGraph (Fin (n + 1))) : ℝ :=
  ∫ y : Fin n → Pt, contactWeight H F (Fin.cons (0 : Pt) y : Fin (n + 1) → Pt)

/-- `V_H = V_{H,∅}` (A §2): volume of configurations in which every edge of `H` is an overlap. -/
def VH {n : ℕ} (H : SimpleGraph (Fin (n + 1))) : ℝ := VHF H ⊥

/-- Configuration with `x_i = 0`, `x_j = p` and the other points given by `y`. -/
def pinConfig {m : ℕ} (i j : Fin m) (p : Pt) (y : {k : Fin m // k ≠ i ∧ k ≠ j} → Pt) :
    Fin m → Pt :=
  fun k => if hi : k = i then 0 else if hj : k = j then p else y ⟨k, hi, hj⟩

open scoped Classical in
/-- The product of `V_{H,F}` without the factor of the pair `{i,j}`. -/
def contactWeightExcept {m : ℕ} (H F : SimpleGraph (Fin m)) (i j : Fin m) (x : Fin m → Pt) : ℝ :=
  ∏ a : Fin m, ∏ b : Fin m,
    if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then 1 else pairFactor H F x a b

/-- Pinned integral: the product without the factor of `ij`, `x_i = 0`, `x_j = p`, integrated over the
positions of the other `m-2` points. `V^{ij}_{H,F} = Vpin H F i j e` for `|e| = 1` (A Lemma 3.4). -/
def Vpin {m : ℕ} (H F : SimpleGraph (Fin m)) (i j : Fin m) (p : Pt) : ℝ :=
  ∫ y : {k : Fin m // k ≠ i ∧ k ≠ j} → Pt, contactWeightExcept H F i j (pinConfig i j p y)

