def HD1L.shift (m : HD1L.M) (q : ℚ) (T : HD1L.T) : HD1L.T :=
  T.map fun a => (HD1L.am m a.1, q*a.2)
theorem HD1L.ev_shift (m : HD1L.M) (q : ℚ) (T : HD1L.T)
    (u : Fin 5 → ℂ) (hn : ∀ l, u l ≠ 0) :
    HD1L.ev (HD1L.shift m q T) u = (q : ℂ)*HD1L.em m u*HD1L.ev T u := by
  induction T with
  | nil => simp [HD1L.shift, HD1L.ev]
  | cons a T ih =>
    simp only [HD1L.shift, List.map_cons, HD1L.ev_cons, Rat.cast_mul, HD1L.em_mul _ _ u hn] at *
    rw [ih]
    ring

