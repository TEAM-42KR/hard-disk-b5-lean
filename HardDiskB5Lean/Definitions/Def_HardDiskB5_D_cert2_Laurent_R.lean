  Laurent.fsum fun i : Fin 5 => Laurent.X i n
def HardDiskB5.D.cert2.Laurent.certPart (i : Fin 5) : Laurent :=
  ((Laurent.closure 1).mul (Laurent.seedShift i)).add
    ((Laurent.closure (-1)).mul (Laurent.seedInvShift i))
