        (rE u (i+j.castSucc) (i+2) - rE u (i+j.castSucc) i) := by
  simp only [Laurent.T0,Laurent.eval_fsum,Laurent.eval_mul u hn,Laurent.eval_sub,
    Laurent.eval_E u hn,Laurent.eval_H u hn]
  apply Finset.sum_congr rfl
  intro j _
  have hz : Dshift u 0 = u := by
    funext l
    simp [Dshift]
  rw [hz]
  ring

theorem HardDiskB5.D.cert2.Laurent.eval_T2 (u : Fin 5 → ℂ) (hn : ∀ i, u i ≠ 0)
    (i : Fin 5) :
    (Laurent.T2 i).eval u = (DGt4.map fun a => (a.2:ℂ) * rS (Dshift u i) a.1 *
      (∑ l : Fin 5, (a.1.getD l.val 0 : ℂ) * rE (Dshift u i) 0 l)).sum := by
  simp only [Laurent.T2,Laurent.eval_sum,List.map_map,Laurent.eval_mul u hn,
    Laurent.eval_scale,Laurent.eval_S u hn,Laurent.eval_V u hn]
  congr 1
  apply List.map_congr_left
  intro a _
  dsimp
  simp only [Laurent.eval_mul u hn,Laurent.eval_scale,Laurent.eval_S u hn,Laurent.eval_V u hn]
  ring

theorem HardDiskB5.D.cert2.Laurent.eval_R (u : Fin 5 → ℂ) (hn : ∀ i, u i ≠ 0) :
    Laurent.R.eval u = HardDiskB5.D.cert2.R u := by
  simp only [Laurent.R,Laurent.eval_sub,Laurent.eval_fsum,Laurent.eval_scale,
    Laurent.eval_T0 u hn,Laurent.eval_p u hn,Laurent.eval_T2 u hn]
  change _ = (∑ i : Fin 5, ∑ j : Fin 4,
      ((DGt j).map fun a => (a.2:ℂ) * rS (Dshift u i) a.1).sum *
        (rE u (i+j.castSucc) (i+2) - rE u (i+j.castSucc) i)) -
      (∑ i : Fin 5, rp u i) / 4 -
      ∑ i : Fin 5, (DGt4.map fun a => (a.2:ℂ) * rS (Dshift u i) a.1 *
        (∑ l : Fin 5, (a.1.getD l.val 0 : ℂ) * rE (Dshift u i) 0 l)).sum
  norm_num
  ring

