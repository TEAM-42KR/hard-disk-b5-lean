/-- The unit-circle point at angle `θ` (counterclockwise from `e1`). -/
def circPt (θ : ℝ) : Pt := Real.cos θ • e1 + Real.sin θ • e2

/-- Arc-length measure on the unit circle `∂D(0)` (image of Lebesgue measure on `[0,2π)` under `θ ↦ circPt θ`). -/
def arcMeasure : Measure Pt := Measure.map circPt (volume.restrict (Set.Ico 0 (2 * Real.pi)))

/-- Rotation by `+π/2`: `(a,b) ↦ (-b,a)`. -/
def rot90 (u : Pt) : Pt := (-(u 1)) • e1 + (u 0) • e2

/-- `u = e - ζ₁ - ζ₂` for the angles `θ = (θ₁, θ₂)` of the first two sides. -/
def pentU (θ : ℝ × ℝ) : Pt := e1 - circPt θ.1 - circPt θ.2

/-- Half-chord vector `v = (√(4-|u|²)/(2|u|)) u^⊥`, so that `u/2 ± v` are unit vectors with sum `u`. -/
def pentV (θ : ℝ × ℝ) : Pt :=
  (Real.sqrt (4 - ‖pentU θ‖ ^ 2) / (2 * ‖pentU θ‖)) • rot90 (pentU θ)

/-- The two points of `𝓜` over `(θ₁,θ₂)`: `(ζ₁,ζ₂,ζ₃,ζ₄) = (circPt θ₁, circPt θ₂, u/2 ± v, u/2 ∓ v)`. -/
def pentPoint (s : Bool) (θ : ℝ × ℝ) : Fin 4 → Pt :=
  ![circPt θ.1, circPt θ.2,
    (1 / 2 : ℝ) • pentU θ + (if s then pentV θ else -pentV θ),
    (1 / 2 : ℝ) • pentU θ - (if s then pentV θ else -pentV θ)]

/-- Weight `2/(|u|√(4-|u|²))` for `0 < |u| < 2`, else `0`. -/
def pentWeight (θ : ℝ × ℝ) : ℝ :=
  if 0 < ‖pentU θ‖ ∧ ‖pentU θ‖ < 2 then 2 / (‖pentU θ‖ * Real.sqrt (4 - ‖pentU θ‖ ^ 2)) else 0

/-- The Gelfand–Leray measure `m` of the surface `𝓜` of closed unit pentagons (A l.418), on `(ℝ²)⁴`. -/
def pentMeasure : Measure (Fin 4 → Pt) :=
  ∑ s : Bool, Measure.map (pentPoint s)
    ((volume.restrict (Set.Ico 0 (2 * Real.pi) ×ˢ Set.Ico 0 (2 * Real.pi))).withDensity
      (fun θ => ENNReal.ofReal (pentWeight θ)))

/-- The surface `𝓜` of closed unit pentagons: unit `ζ₁,…,ζ₄` with `ζ₁+ζ₂+ζ₃+ζ₄ = e` (`ζ₅ = -e`). -/
def pentSurface : Set (Fin 4 → Pt) := {x | (∀ i, ‖x i‖ = 1) ∧ ∑ i, x i = e1}

/-- The five steps `x₁,…,x₄, x₅ = -e` (Lean indices `0..4`). -/
def xExt (x : Fin 4 → Pt) (k : Fin 5) : Pt := if h : (k : ℕ) < 4 then x ⟨k, h⟩ else -e1

/-- Pair sum `x_{ij} = x_i + x_j` for `i, j ∈ {1,…,5}` (Lean `Fin 5`). -/
def pairSum (x : Fin 4 → Pt) (i j : Fin 5) : Pt := xExt x i + xExt x j

/-- The pair `{i,j}` is near: `|x_{ij}| < 1` (for `j = 5` this is `|x_i - e| < 1`). -/
def IsNear (x : Fin 4 → Pt) (i j : Fin 5) : Prop := ‖pairSum x i j‖ < 1

/-- The pair `{i,j}` is far: `|x_{ij}| > 1`. -/
def IsFar (x : Fin 4 → Pt) (i j : Fin 5) : Prop := 1 < ‖pairSum x i j‖

/-- Angle of `z ≠ 0` measured counterclockwise from `e = e1`, in `(0, 2π]` (`= 2π` only at the direction of `e`). -/
def angE (z : Pt) : ℝ :=
  if 0 < Complex.arg ⟨z 0, z 1⟩ then Complex.arg ⟨z 0, z 1⟩ else Complex.arg ⟨z 0, z 1⟩ + 2 * Real.pi

