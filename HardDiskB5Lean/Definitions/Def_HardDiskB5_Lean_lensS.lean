/-- The lens `L_λ = D(0) ∩ D(λ e)`, `e = e1` (A §3.1). -/
def lensAt (lam : ℝ) : Set Pt := disk 0 ∩ disk (lam • e1)

/-- `N_λ(o) = |L_λ ∩ D(o)|` (A §3.1). -/
def lensN (lam : ℝ) (o : Pt) : ℝ := (volume (lensAt lam ∩ disk o)).toReal

