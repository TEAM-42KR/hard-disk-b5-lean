namespace HardDiskB5.Lean

open scoped Classical in
/-- Factor of the ordered pair `a < b` at scale `s a b`: `1[|x_a-x_b| < s a b]` for an edge of `H`,
`1[|x_a-x_b| ≥ s a b]` for a pair of `F`, `1` otherwise. -/
def pairFactorSc {m : ℕ} (H F : SimpleGraph (Fin m)) (s : Fin m → Fin m → ℝ) (x : Fin m → Pt)
    (a b : Fin m) : ℝ :=
  if a < b ∧ H.Adj a b then (if dist (x a) (x b) < s a b then 1 else 0)
  else if a < b ∧ F.Adj a b then (if s a b ≤ dist (x a) (x b) then 1 else 0) else 1

/-- `∏_{ij∈H} 1[|x_i-x_j| < s_ij] ∏_{ij∈F} 1[|x_i-x_j| ≥ s_ij]`. -/
def contactWeightSc {m : ℕ} (H F : SimpleGraph (Fin m)) (s : Fin m → Fin m → ℝ) (x : Fin m → Pt) : ℝ :=
  ∏ a : Fin m, ∏ b : Fin m, pairFactorSc H F s x a b

/-- `V_{H,F}` with the factor of each pair `a < b` at scale `s a b`; `x_0 = 0`. -/
def VHFsc {n : ℕ} (H F : SimpleGraph (Fin (n + 1))) (s : Fin (n + 1) → Fin (n + 1) → ℝ) : ℝ :=
  ∫ y : Fin n → Pt, contactWeightSc H F s (Fin.cons (0 : Pt) y : Fin (n + 1) → Pt)

open scoped Classical in
/-- The scaled product without the factor of the pair `{i,j}`. -/
def contactWeightExceptSc {m : ℕ} (H F : SimpleGraph (Fin m)) (s : Fin m → Fin m → ℝ) (i j : Fin m)
    (x : Fin m → Pt) : ℝ :=
  ∏ a : Fin m, ∏ b : Fin m,
    if (a = i ∧ b = j) ∨ (a = j ∧ b = i) then 1 else pairFactorSc H F s x a b

/-- Pinned scaled integral (B's `f_l(y;ε)`): the scaled product without the factor of `ij`, `x_i = 0`,
`x_j = p`, integrated over the positions of the other `m-2` points. -/
def VpinSc {m : ℕ} (H F : SimpleGraph (Fin m)) (s : Fin m → Fin m → ℝ) (i j : Fin m) (p : Pt) : ℝ :=
  ∫ y : {k : Fin m // k ≠ i ∧ k ≠ j} → Pt, contactWeightExceptSc H F s i j (pinConfig i j p y)

