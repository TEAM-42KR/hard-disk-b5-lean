  · apply (hfull0.sub (SF.farO false false)).congr' _ Filter.EventuallyEq.rfl
    exact Filter.Eventually.of_forall (fun k => by
      change 2 * Real.pi * J0 k ^ 2 - hankel (farPart C1.a) k = hankel (nearPart C1.a) k
      rw [SF.hankel_split SF.integrable_a, HardDiskB5.C3.full_transforms.1 k])
  · apply (hfull1.sub (SF.farO false true)).congr' _ Filter.EventuallyEq.rfl
    filter_upwards [eventually_gt_atTop (0 : ℝ)] with k hk
    change 2 * Real.pi * J0 k * J1 k / k - hankel (farPart C1.b) k = hankel (nearPart C1.b) k
    rw [SF.hankel_split SF.integrable_b, HardDiskB5.C3.full_transforms.2.1 k hk.ne']

private theorem SF.spectral_integrable (s t u : Bool) :
    IntegrableOn (fun k : ℝ => J1 k * hankel (farPart (pairDensity s t)) k *
      hankel (nearPart (pairDensity false u)) k) (Ioi (0 : ℝ)) := by
  have hc := HardDiskB5.C3.bessel_basic.2.2.2.2.1.mul
    (SF.hankel_cont (SF.int_far (SF.integrable_pair s t)))
  have hc' := hc.mul (SF.hankel_cont (SF.int_near (SF.integrable_pair false u)))
  have hb1 : Asymptotics.IsBigO atTop
      (fun k : ℝ => J1 k * hankel (farPart (pairDensity s t)) k)
      (fun k : ℝ => k ^ (-1 : ℝ)) :=
    Asymptotics.IsBigO.mul_atTop_rpow_of_isBigO_rpow (-(1 / 2 : ℝ)) (-(1 / 2 : ℝ)) (-1)
      (SF.besselO true) (SF.farO s t) (by norm_num)
  have hb' : Asymptotics.IsBigO atTop
      (fun k : ℝ => J1 k * hankel (farPart (pairDensity s t)) k * hankel (nearPart (pairDensity false u)) k)
      (fun k : ℝ => k ^ (-(3 / 2 : ℝ))) :=
    Asymptotics.IsBigO.mul_atTop_rpow_of_isBigO_rpow (-1) (-(1 / 2 : ℝ)) (-(3 / 2 : ℝ))
      hb1 (SF.nearO u) (by norm_num)
  have hr : IntegrableAtFilter (fun k : ℝ => k ^ (-(3 / 2 : ℝ))) atTop :=
    ⟨Ioi (1 : ℝ), Ioi_mem_atTop 1,
      integrableOn_Ioi_rpow_of_lt (by norm_num) (by norm_num)⟩
  exact ((hc'.continuousOn.locallyIntegrableOn measurableSet_Ici).integrableOn_of_isBigO_atTop hb' hr).mono_set Ioi_subset_Ici_self

private theorem SF.pairing (s t u : Bool) :
    (∫ w, nearPart (radConv (farPart (pairDensity s t)) SF.D) ‖e1 - w‖ ∂(stepLaw u)) =
      2 * Real.pi * ∫ k in Ioi (0 : ℝ), J1 k * hankel (farPart (pairDensity s t)) k *
        hankel (nearPart (pairDensity false u)) k := by
  let f := farPart (pairDensity s t)
  let g := radConv f SF.D
  have hmF : Measurable f := SF.meas_far (SF.meas_pair s t)
  have hiF : Integrable (fun z : Pt => f ‖z‖) := SF.int_far (SF.integrable_pair s t)
  have hmG : Measurable g := SF.conv_meas hmF
  have hbG := SF.conv_bound hiF
  have hbNear : ∃ C : ℝ, ∀ r : ℝ, |nearPart g r| ≤ C := by
    obtain ⟨C, hC⟩ := hbG
    refine ⟨C, fun r => ?_⟩
    have hC0 : 0 ≤ C := (abs_nonneg (g 0)).trans (hC 0)
    unfold nearPart
    split_ifs
    · exact hC r
    · simpa only [abs_zero] using hC0
  have hprops := HardDiskB5.C3.hankel_conv f SF.D hmF SF.meas_D hiF SF.integrable_D
  have hfreq (k : ℝ) (hk : k ∈ Ioi (0 : ℝ)) :
      k * J0 (k * ‖(0 : Pt)‖) * hankel g k * hankel (nearPart (pairDensity false u)) k =
      (2 * Real.pi) * (J1 k * hankel f k * hankel (nearPart (pairDensity false u)) k) := by
    change 0 < k at hk
    rw [norm_zero, mul_zero, HardDiskB5.C3.bessel_basic.2.1, mul_one]
    rw [show hankel g k = 2 * Real.pi * hankel f k * hankel SF.D k from hprops.2.2 k]
    rw [show hankel SF.D k = J1 k / k from (HardDiskB5.C3.elem_hankels k hk.ne').1]
    field_simp [hk.ne']
    <;> ring
  have hiFreq : IntegrableOn (fun k : ℝ => k * J0 (k * ‖(0 : Pt)‖) * hankel g k *
      hankel (nearPart (pairDensity false u)) k) (Ioi (0 : ℝ)) := by
    apply ((SF.spectral_integrable s t u).const_mul (2 * Real.pi)).congr
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with k hk
    exact (hfreq k hk).symm
  have hp := HardDiskB5.C3.hankel_parseval g (nearPart (pairDensity false u)) 0 hmG
    (SF.meas_near (SF.meas_pair false u)) hbG hprops.2.1
    (SF.int_near (SF.integrable_pair false u)) hiFreq
  have hfint : (∫ k in Ioi (0 : ℝ), k * J0 (k * ‖(0 : Pt)‖) * hankel g k *
      hankel (nearPart (pairDensity false u)) k) =
      (2 * Real.pi) * ∫ k in Ioi (0 : ℝ), J1 k * hankel f k * hankel (nearPart (pairDensity false u)) k := by
    rw [← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Ioi hfreq
  rw [hfint] at hp
  have ha := HardDiskB5.C3.circle_average (nearPart g) u (SF.meas_near hmG) hbNear
  have hplane : (∫ z : Pt, nearPart g ‖z‖ * pairDensity false u ‖z‖) =
      ∫ z : Pt, g ‖z‖ * nearPart (pairDensity false u) ‖(0 : Pt) - z‖ := by
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun z => by
      simp only [zero_sub, norm_neg, nearPart]
      split_ifs <;> ring)
  rw [hplane, hp] at ha
  change (∫ w, nearPart g ‖e1 - w‖ ∂(stepLaw u)) = _
  rw [ha]
  field_simp [Real.pi_ne_zero]
  <;> ring

private instance SF.stepFinite (b : Bool) : IsFiniteMeasure (stepLaw b) := by
  cases b
  · change IsFiniteMeasure arcMeasure
    unfold arcMeasure
    infer_instance
  · change IsFiniteMeasure (volume.restrict (disk (0 : Pt)))
    exact ⟨by simpa only [Measure.restrict_apply_univ, disk] using
      (measure_ball_lt_top (x := (0 : Pt)) (r := (1 : ℝ)))⟩

private theorem SF.mass_to_conv (K : Finset (Fin 4)) (i j a l : Fin 4)
    (hij : i ≠ j) (hia : i ≠ a) (hil : i ≠ l) (hja : j ≠ a)
    (hjl : j ≠ l) (hal : a ≠ l) (ha : a ∈ K) :
    (walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1}).toReal =
    ∫ w, nearPart (radConv (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) SF.D)
      ‖e1 - w‖ ∂(stepLaw (decide (l ∈ K))) := by
  let ρ := pairDensity (decide (i ∈ K)) (decide (j ∈ K))
  let f := farPart ρ
  let g := radConv f SF.D
  let h := nearPart g
  let F : Pt → Pt → ENNReal := fun z w => if 1 < ‖z‖ ∧ ‖e1 - w‖ < 1 then 1 else 0
  have hmF : Measurable f := SF.meas_far (SF.meas_pair _ _)
  have hiF : Integrable (fun z : Pt => f ‖z‖) := SF.int_far (SF.integrable_pair _ _)
  have hnF (r : ℝ) : 0 ≤ f r := by
    dsimp [f, farPart]
    split_ifs
    · exact SF.nonneg_pair _ _ _
    · rfl
  have hmG : Measurable g := SF.conv_meas hmF
  have hnG (r : ℝ) : 0 ≤ g r := SF.conv_nonneg hnF r
  have hmH : Measurable h := SF.meas_near hmG
  have hnH (r : ℝ) : 0 ≤ h r := by
    dsimp [h, nearPart]
    split_ifs
    · exact hnG r
    · rfl
  have hiH : Integrable (fun w : Pt => h ‖e1 - w‖) (stepLaw (decide (l ∈ K))) := by
    obtain ⟨C, hC⟩ := SF.conv_bound hiF
    have hC0 : 0 ≤ C := (abs_nonneg (g 0)).trans (hC 0)
    apply Integrable.of_bound (hmH.comp (by fun_prop)).aestronglyMeasurable C
    exact Filter.Eventually.of_forall (fun w => by
      rw [Real.norm_eq_abs]
      dsimp [h, nearPart]
      split_ifs
      · exact hC _
      · simpa only [abs_zero] using hC0)
  have hFm : Measurable (Function.uncurry F) := by
    apply Measurable.ite _ measurable_const measurable_const
    exact ((isOpen_lt continuous_const continuous_fst.norm).inter
      (isOpen_lt (continuous_const.sub continuous_snd).norm continuous_const)).measurableSet
  have hprops := HardDiskB5.C3.hankel_conv f SF.D hmF SF.meas_D hiF SF.integrable_D
  have hB (z w : Pt) :
      ENNReal.ofReal (ρ ‖z‖) * (disk 0).indicator (fun _ => (1 : ENNReal)) (e1 - z - w) * F z w =
      ENNReal.ofReal (f ‖z‖ * SF.D ‖e1 - w - z‖ * SF.D ‖e1 - w‖) := by
    have he : e1 - z - w = e1 - w - z := by abel
    by_cases hz : 1 < ‖z‖ <;> by_cases hw : ‖e1 - w‖ < 1 <;> by_cases hd : ‖e1 - w - z‖ < 1 <;>
      simp [F, f, farPart, SF.D, disk, Set.indicator_apply, he, hz, hw, hd]
  have hmB : Measurable (fun p : Pt × Pt =>
      ENNReal.ofReal (f ‖p.1‖ * SF.D ‖e1 - p.2 - p.1‖ * SF.D ‖e1 - p.2‖)) := by
    apply Measurable.ennreal_ofReal
    exact ((hmF.comp (by fun_prop)).mul (SF.meas_D.comp (by fun_prop))).mul
      (SF.meas_D.comp (by fun_prop))
  have hmass :
      walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1} =
      ENNReal.ofReal (∫ w : Pt, h ‖e1 - w‖ ∂(stepLaw (decide (l ∈ K)))) := by
    calc
      _ = walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1} :=
        SF.event_marginal K i j a l hij hia hil hja hjl hal ha
      _ = ∫⁻ x, F (x i + x j) (x l) ∂(walkK K) := by
        have he : (fun x : Fin 4 → Pt => F (x i + x j) (x l)) =
            ({x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1}).indicator 1 := by
          funext x
          by_cases hx : 1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1 <;>
            simp [F, Set.indicator_apply, hx]
        rw [he]
        have hs : MeasurableSet {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1} := by
          have hs1 : IsOpen {x : Fin 4 → Pt | 1 < ‖x i + x j‖} :=
            isOpen_lt continuous_const ((continuous_apply i).add (continuous_apply j)).norm
          have hs2 : IsOpen {x : Fin 4 → Pt | ‖e1 - x l‖ < 1} :=
            isOpen_lt (continuous_const.sub (continuous_apply l)).norm continuous_const
          exact (hs1.inter hs2).measurableSet
        exact (lintegral_indicator_one hs).symm
      _ = ∫⁻ z : Pt, ∫⁻ w, ENNReal.ofReal (ρ ‖z‖) *
          (disk 0).indicator (fun _ => (1 : ENNReal)) (e1 - z - w) * F z w
          ∂(stepLaw (decide (l ∈ K))) :=
        HardDiskB5.C3.walk_disk_solve K i j a l hij hia hil hja hjl hal ha F hFm
      _ = ∫⁻ z : Pt, ∫⁻ w, ENNReal.ofReal (f ‖z‖ * SF.D ‖e1 - w - z‖ * SF.D ‖e1 - w‖)
          ∂(stepLaw (decide (l ∈ K))) := by
        apply lintegral_congr
        intro z
        apply lintegral_congr
        exact hB z
      _ = ∫⁻ w, (∫⁻ z : Pt, ENNReal.ofReal (f ‖z‖ * SF.D ‖e1 - w - z‖ * SF.D ‖e1 - w‖))
          ∂(stepLaw (decide (l ∈ K))) := lintegral_lintegral_swap hmB.aemeasurable
      _ = ∫⁻ w, ENNReal.ofReal (h ‖e1 - w‖) ∂(stepLaw (decide (l ∈ K))) := by
        apply lintegral_congr
        intro w
        rw [← ofReal_integral_eq_lintegral_ofReal
          ((SF.conv_section hmF hiF (e1 - w)).mul_const (SF.D ‖e1 - w‖))
          (Filter.Eventually.of_forall (fun z =>
            mul_nonneg (mul_nonneg (hnF _) (SF.nonneg_D _)) (SF.nonneg_D _)))]
        rw [integral_mul_const, hprops.1 (e1 - w)]
        congr 1
        dsimp [h, nearPart, SF.D]
        split_ifs <;> ring
      _ = _ := (ofReal_integral_eq_lintegral_ofReal hiH (Filter.Eventually.of_forall (fun w => hnH _))).symm
  rw [hmass, ENNReal.toReal_ofReal (integral_nonneg (fun w => hnH _))]

theorem solution_s12569047 :
    ∀ (K : Finset (Fin 4)) (i j a l : Fin 4), i ≠ j → i ≠ a → i ≠ l → j ≠ a → j ≠ l → a ≠ l → a ∈ K →
      (walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1}).toReal =
        2 * Real.pi * ∫ k in Set.Ioi (0 : ℝ), J1 k * hankel (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) k * hankel (nearPart (pairDensity false (decide (l ∈ K)))) k  := by
  intro K i j a l hij hia hil hja hjl hal ha
  exact (SF.mass_to_conv K i j a l hij hia hil hja hjl hal ha).trans
    (SF.pairing (decide (i ∈ K)) (decide (j ∈ K)) (decide (l ∈ K)))
