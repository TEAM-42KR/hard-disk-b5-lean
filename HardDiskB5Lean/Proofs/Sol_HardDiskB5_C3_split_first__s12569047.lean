private theorem SF.besselO (n : Bool) :
    Asymptotics.IsBigO atTop (if n then J1 else J0) (fun k : ℝ => k ^ (-(1 / 2 : ℝ))) := by
  apply Asymptotics.IsBigO.of_bound (10 / Real.pi)
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with k hk
  have hk0 : 0 < k := lt_of_lt_of_le zero_lt_one hk
  have he : 10 / (Real.pi * Real.sqrt k) = (10 / Real.pi) * k ^ (-(1 / 2 : ℝ)) := by
    rw [Real.rpow_neg hk0.le, ← Real.sqrt_eq_rpow]
    ring
  have hb : |(if n then J1 else J0) k| ≤ 10 / (Real.pi * Real.sqrt k) := by
    cases n
    · exact (HardDiskB5.C3.bessel_decay k hk).1
    · exact (HardDiskB5.C3.bessel_decay k hk).2.1
  simpa only [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg hk0.le _), he] using hb

