private theorem SF.hankel_split {f : ℝ → ℝ} (hi : Integrable (fun z : Pt => f ‖z‖)) (k : ℝ) :
    hankel (nearPart f) k = hankel f k - hankel (farPart f) k := by
  have hn := SF.hankel_int (SF.int_near hi) k
  have hf := SF.hankel_int (SF.int_far hi) k
  have he : hankel f k = hankel (nearPart f) k + hankel (farPart f) k := by
    unfold hankel
    rw [← integral_add hn hf]
    apply integral_congr_ae
    have hr1 : ∀ᵐ r : ℝ, r ≠ 1 := by simp [ae_iff]
    filter_upwards [ae_restrict_of_ae hr1] with r hr
    by_cases h : r < 1
    · have h' : ¬ 1 < r := not_lt.mpr h.le
      simp only [nearPart, farPart, if_pos h, if_neg h', mul_zero, zero_mul, add_zero]
    · have h' : 1 < r := lt_of_le_of_ne (le_of_not_gt h) (Ne.symm hr)
      simp only [nearPart, farPart, if_neg h, if_pos h', mul_zero, zero_mul, zero_add]
  linarith

