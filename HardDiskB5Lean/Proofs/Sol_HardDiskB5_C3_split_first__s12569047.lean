private theorem SF.sum4 (i j a l : Fin 4) (hij : i ≠ j) (hia : i ≠ a) (hil : i ≠ l)
    (hja : j ≠ a) (hjl : j ≠ l) (hal : a ≠ l) (x : Fin 4 → Pt) :
    ∑ b, x b = x i + x j + x a + x l := by
  have hu : ({i,j,a,l} : Finset (Fin 4)) = Finset.univ := by
    apply Finset.eq_univ_of_card
    simp [hij, hia, hil, hja, hjl, hal]
  rw [← hu]
  simp [hij, hia, hil, hja, hjl, hal, add_assoc]

private theorem SF.walk_support (K : Finset (Fin 4)) (ha : K.Nonempty) :
    ∀ᵐ x ∂(walkK K), ∑ b, x b = e1 := by
  rw [walkK, dif_pos ha]
  apply (ae_map_iff (by fun_prop) ((isClosed_eq (by fun_prop) continuous_const).measurableSet)).2
  exact Filter.Eventually.of_forall (fun x => by
    rw [Finset.sum_update_of_mem (Finset.mem_univ _)]
    simp only [Finset.sdiff_singleton_eq_erase]
    abel)

private theorem SF.event_marginal (K : Finset (Fin 4)) (i j a l : Fin 4)
    (hij : i ≠ j) (hia : i ≠ a) (hil : i ≠ l) (hja : j ≠ a)
    (hjl : j ≠ l) (hal : a ≠ l) (ha : a ∈ K) :
    walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1} =
    walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1} := by
  apply measure_congr
  filter_upwards [SF.walk_support K ⟨a, ha⟩] with x hx
  rw [SF.sum4 i j a l hij hia hil hja hjl hal x] at hx
  have he : x i + x j + x a = e1 - x l := eq_sub_iff_add_eq.mpr hx
  change (1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1) =
    (1 < ‖x i + x j‖ ∧ ‖e1 - x l‖ < 1)
  rw [he]

