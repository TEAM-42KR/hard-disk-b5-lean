private theorem WalkDiskPair.step_finite (b : Bool) : IsFiniteMeasure (stepLaw b) := by
  cases b
  · change IsFiniteMeasure arcMeasure
    unfold arcMeasure
    infer_instance
  · change IsFiniteMeasure (volume.restrict (disk (0 : Pt)))
    exact ⟨by simpa only [Measure.restrict_apply_univ, disk] using
      (measure_ball_lt_top (x := (0 : Pt)) (r := (1 : ℝ)))⟩

private theorem WalkDiskPair.density (b₁ b₂ : Bool) :
    Measure.map (fun z : Pt × Pt => z.1 + z.2) ((stepLaw b₁).prod (stepLaw b₂)) =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (pairDensity b₁ b₂ ‖y‖)) := by
  cases b₁ <;> cases b₂
  · simpa [stepLaw, pairDensity] using WalkDiskPair.circle_density
  · exact WalkDiskPair.Dens.mixed false true (by decide)
  · exact WalkDiskPair.Dens.mixed true false (by decide)
  · exact WalkDiskPair.Dens.disk_disk


theorem solution_s12569039 :
    ∀ (K : Finset (Fin 4)) (i j a l : Fin 4), i ≠ j → i ≠ a → i ≠ l → j ≠ a → j ≠ l → a ≠ l → a ∈ K →
      ∀ F : Pt → Pt → ENNReal, Measurable (Function.uncurry F) →
      (∫⁻ x, F (x i + x j) (x l) ∂(walkK K)) =
        ∫⁻ z : Pt, ∫⁻ w, ENNReal.ofReal (pairDensity (decide (i ∈ K)) (decide (j ∈ K)) ‖z‖) *
          (disk 0).indicator (fun _ => (1 : ENNReal)) (e1 - z - w) * F z w ∂(stepLaw (decide (l ∈ K))) := by
  exact WalkDisk.from_density WalkDiskPair.density
