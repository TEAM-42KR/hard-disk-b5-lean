      (Measure.pi (WalkDisk.base K a)) =
        ((stepLaw (decide (i ∈ K))).prod (stepLaw (decide (j ∈ K)))).prod
          (stepLaw (decide (l ∈ K))) := by
  classical
  letI (k : Fin 4) := WalkDisk.base_finite K a k
  letI (b : Bool) := WalkDisk.step_finite b
  have hp : Measurable (fun x : Fin 4 → Pt => ((x i, x j), x l)) := by fun_prop
  have he := WalkDisk.enum i j a l hij hia hil hja hjl hal
  apply Measure.ext_prod₃'
  intro s t u hs ht hu
  let v : Fin 4 → Set Pt := fun k => if k = i then s else if k = j then t else if k = l then u else Set.univ
  have hpre : (fun x : Fin 4 → Pt => ((x i, x j), x l)) ⁻¹' ((s ×ˢ t) ×ˢ u) = Set.univ.pi v := by
    ext x
    simp only [Set.mem_preimage, Set.mem_prod, Set.mem_univ_pi]
    constructor
    · rintro ⟨⟨hi, hj⟩, hl⟩ k
      by_cases hki : k = i
      · subst k; simpa [v] using hi
      · by_cases hkj : k = j
        · subst k; simpa [v, hij.symm] using hj
        · by_cases hkl : k = l
          · subst k; simpa [v, hil.symm, hjl.symm] using hl
          · simp [v, hki, hkj, hkl]
    · intro h
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · simpa [v] using h i
      · simpa [v, hij.symm] using h j
      · simpa [v, hil.symm, hjl.symm] using h l
  rw [Measure.map_apply hp ((hs.prod ht).prod hu), hpre, Measure.pi_pi,
    Measure.prod_prod, Measure.prod_prod, ← he]
  simp [WalkDisk.base, v, hij, hia, hil, hja, hjl, hal,
    hij.symm, hia.symm, hil.symm, hja.symm, hjl.symm, hal.symm, mul_assoc]

private theorem WalkDisk.raw_splitting (K : Finset (Fin 4)) (i j a l : Fin 4)
    (hij : i ≠ j) (hia : i ≠ a) (hil : i ≠ l)
    (hja : j ≠ a) (hjl : j ≠ l) (hal : a ≠ l) (ha : a ∈ K)
    (F : Pt → Pt → ENNReal) (hF : Measurable (Function.uncurry F)) :
    (∫⁻ x, F (x i + x j) (x l) ∂walkK K) =
      ∫⁻ p : (Pt × Pt) × Pt,
        (disk 0).indicator (fun _ => (1 : ENNReal)) (e1 - (p.1.1 + p.1.2) - p.2) *
          F (p.1.1 + p.1.2) p.2
        ∂(((stepLaw (decide (i ∈ K))).prod (stepLaw (decide (j ∈ K)))).prod
          (stepLaw (decide (l ∈ K)))) := by
  classical
  let H : (Fin 4 → Pt) → ENNReal := fun x => F (x i + x j) (x l)
  have hp : Measurable (fun x : Fin 4 → Pt => (x i + x j, x l)) := by fun_prop
  have hH : Measurable H := hF.comp hp
  let D : Pt → ENNReal := (disk 0).indicator (fun _ => 1)
  have hD : Measurable D := measurable_const.indicator measurableSet_ball
  let G : (Pt × Pt) × Pt → ENNReal := fun p => D (e1 - (p.1.1 + p.1.2) - p.2) * F (p.1.1 + p.1.2) p.2
  have hpG : Measurable (fun p : (Pt × Pt) × Pt => (p.1.1 + p.1.2, p.2)) := by fun_prop
  have hdG : Measurable (fun p : (Pt × Pt) × Pt => e1 - (p.1.1 + p.1.2) - p.2) := by fun_prop
  have hG : Measurable G := (hD.comp hdG).mul (hF.comp hpG)
  have he := WalkDisk.enum i j a l hij hia hil hja hjl hal
  have hsum (x : Fin 4 → Pt) : (∑ k ∈ Finset.univ.erase a, x k) = x i + x j + x l := by
    rw [← he]
    simp [hia, hja, hal, hij, hil, hjl, hia.symm, hja.symm, hal.symm,
      hij.symm, hil.symm, hjl.symm, add_assoc]
  have hw (x : Fin 4 → Pt) : WalkDisk.weighted a H x = G ((x i, x j), x l) := by
    have hmem : x ∈ WalkDisk.dom a ↔ e1 - (x i + x j) - x l ∈ disk 0 := by
      dsimp [WalkDisk.dom]
      rw [hsum, sub_add_eq_sub_sub]
    dsimp only [WalkDisk.weighted]
    by_cases hm : e1 - (x i + x j) - x l ∈ disk 0 <;>
      simp [Set.indicator_apply, hmem, hm, H, G, D, WalkDisk.solve,
        Function.update_of_ne hia, Function.update_of_ne hja, Function.update_of_ne hal.symm]
  rw [WalkDisk.walkK_chart K a ha, WalkDisk.chart_integral K a H hH]
  simp_rw [hw]
  rw [← lintegral_map hG (by fun_prop : Measurable (fun x : Fin 4 → Pt => ((x i, x j), x l))),
    WalkDisk.base_projection K i j a l hij hia hil hja hjl hal]

