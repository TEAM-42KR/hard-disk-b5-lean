private theorem WalkDisk.base_projection (K : Finset (Fin 4)) (i j a l : Fin 4)
    (hij : i ≠ j) (hia : i ≠ a) (hil : i ≠ l)
    (hja : j ≠ a) (hjl : j ≠ l) (hal : a ≠ l) :
