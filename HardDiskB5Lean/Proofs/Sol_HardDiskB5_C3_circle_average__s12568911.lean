  haveI : IsFiniteMeasure arcMeasure := by unfold arcMeasure; infer_instance
  have hm : (volume.restrict (disk (0 : Pt))).conv arcMeasure =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (C1.b ‖y‖)) := by
    rw [Measure.conv, CA.Dens.disk_conv arcMeasure]
    congr 1
    funext y
    exact CA.Dens.arc_disk y
  cases b₁ <;> cases b₂
  · exact (hne rfl).elim
  · have hm' := (Measure.conv_comm arcMeasure (volume.restrict (disk (0 : Pt)))).trans hm
    simpa [stepLaw, pairDensity, Measure.conv] using hm'
  · simpa [stepLaw, pairDensity, Measure.conv] using hm
  · exact (hne rfl).elim

