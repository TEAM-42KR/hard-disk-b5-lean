    rw [hA, hB, Real.cos_sub]
    nlinarith only [Real.sin_sq_add_cos_sq q.1, Real.sin_sq_add_cos_sq q.2]
  have hcos : Real.cos (p.1 - p.2) = Real.cos (q.1 - q.2) := by linarith only [hpN, hqN]
  have hs2 : Real.sin (p.1 - p.2) ^ 2 = Real.sin (q.1 - q.2) ^ 2 := by
    have hp := Real.sin_sq_add_cos_sq (p.1 - p.2)
    rw [hcos] at hp
    nlinarith only [hp, Real.sin_sq_add_cos_sq (q.1 - q.2)]
  have hsin : Real.sin (p.1 - p.2) = Real.sin (q.1 - q.2) := by
    cases b
    · simp only [Bool.false_eq_true, ↓reduceIte] at hp3 hq3
      have hsq : (-Real.sin (p.1 - p.2)) ^ 2 = (-Real.sin (q.1 - q.2)) ^ 2 := by simpa only [neg_sq] using hs2
      have hh := (sq_eq_sq₀ hp3.le hq3.le).mp hsq
      linarith only [hh]
    · simp only [↓reduceIte] at hp3 hq3
      exact (sq_eq_sq₀ hp3.le hq3.le).mp hs2
  have hdetp : A * Real.sin p.1 - B * Real.cos p.1 = Real.sin (p.1 - p.2) := by
    dsimp [A, B]
    rw [Real.sin_sub]
    ring
