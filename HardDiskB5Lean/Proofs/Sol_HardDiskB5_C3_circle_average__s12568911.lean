    nlinarith only [h1, h2]
  have hy : (A ^ 2 + B ^ 2) * (Real.sin p.1 - Real.sin q.1) = 0 := by
    have h1 := congrArg (fun z : ℝ => B * z) hlin1
    have h2 := congrArg (fun z : ℝ => A * z) hlin2
    nlinarith only [h1, h2]
  have hc1 : Real.cos p.1 = Real.cos q.1 :=
    sub_eq_zero.mp ((mul_eq_zero.mp hx).resolve_left hnz)
  have hs1 : Real.sin p.1 = Real.sin q.1 :=
    sub_eq_zero.mp ((mul_eq_zero.mp hy).resolve_left hnz)
  have hc2 : Real.cos p.2 = Real.cos q.2 := by dsimp [A] at hA; linarith only [hA, hc1]
  have hs2' : Real.sin p.2 = Real.sin q.2 := by dsimp [B] at hB; linarith only [hB, hs1]
  have hinj : Set.InjOn Circle.exp (Set.Ico 0 (2 * Real.pi)) :=
    Circle.exp_injOn_Ico (by linarith)
  have heq (x y : ℝ) (hc : Real.cos x = Real.cos y) (hs : Real.sin x = Real.sin y) :
      Circle.exp x = Circle.exp y := by
    apply Subtype.ext
    simp only [Circle.coe_exp, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, hc, hs]
  exact Prod.ext (hinj hp1 hq1 (heq _ _ hc1 hs1)) (hinj hp2 hq2 (heq _ _ hc2 hs2'))

private theorem CA.Dens.circle_sum_sheet_image (b : Bool) :
    (fun p : ℝ × ℝ => (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2)) ''
      {p : ℝ × ℝ | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
        0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))} =
    {y : ℝ × ℝ | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4} := by
  classical
  have angle_rep (x y : ℝ) (hxy : x ^ 2 + y ^ 2 = 1) :
      ∃ t ∈ Set.Ico 0 (2 * Real.pi), Real.cos t = x ∧ Real.sin t = y := by
    let z : ℂ := ⟨x, y⟩
    have hn : ‖z‖ = 1 := by
      have hs : ‖z‖ ^ 2 = 1 := by
        rw [Complex.sq_norm, Complex.normSq_apply]
        dsimp [z]
        nlinarith only [hxy]
      nlinarith only [hs, norm_nonneg z]
    have hc : Real.cos (Complex.arg z) = x := by
      simpa only [hn, one_mul] using Complex.norm_mul_cos_arg z
    have hs : Real.sin (Complex.arg z) = y := by
      simpa only [hn, one_mul] using Complex.norm_mul_sin_arg z
    by_cases ha : 0 ≤ Complex.arg z
    · exact ⟨Complex.arg z, ⟨ha, by linarith [Complex.arg_le_pi z, Real.pi_pos]⟩, hc, hs⟩
    · refine ⟨Complex.arg z + 2 * Real.pi, ⟨?_, ?_⟩, ?_, ?_⟩
      · linarith [Complex.neg_pi_lt_arg z, Real.pi_pos]
      · linarith
      · simpa [Real.cos_add] using hc
      · simpa [Real.sin_add] using hs
  ext y
  constructor
  · rintro ⟨p, ⟨hp1, hp2, hp3⟩, rfl⟩
    have hsn : Real.sin (p.1 - p.2) ≠ 0 := by
      intro h0
      cases b <;> simp [h0] at hp3
    have hN : (Real.cos p.1 + Real.cos p.2) ^ 2 + (Real.sin p.1 + Real.sin p.2) ^ 2 =
        2 + 2 * Real.cos (p.1 - p.2) := by
      rw [Real.cos_sub]
      nlinarith only [Real.sin_sq_add_cos_sq p.1, Real.sin_sq_add_cos_sq p.2]
    change 0 < (Real.cos p.1 + Real.cos p.2) ^ 2 + (Real.sin p.1 + Real.sin p.2) ^ 2 ∧ _
    constructor
    · by_contra h
      have hc : Real.cos (p.1 - p.2) = -1 := by
        nlinarith only [hN, not_lt.mp h, Real.neg_one_le_cos (p.1 - p.2)]
      have hs := Real.sin_sq_add_cos_sq (p.1 - p.2)
      rw [hc] at hs
      exact hsn (by nlinarith only [hs])
    · by_contra h
      have hc : Real.cos (p.1 - p.2) = 1 := by
        nlinarith only [hN, not_lt.mp h, Real.cos_le_one (p.1 - p.2)]
      have hs := Real.sin_sq_add_cos_sq (p.1 - p.2)
      rw [hc] at hs
      exact hsn (by nlinarith only [hs])
  · intro hy
    obtain ⟨hy0, hy4⟩ := hy
    let Q := y.1 ^ 2 + y.2 ^ 2
    have hQ : Q = y.1 ^ 2 + y.2 ^ 2 := rfl
    have hQ0 : 0 < Q := hy0
    have hQ4 : Q < 4 := hy4
    let t := Real.sqrt (4 - Q) / (2 * Real.sqrt Q)
    have ht : 0 < t := div_pos (Real.sqrt_pos.mpr (by linarith))
      (mul_pos (by norm_num) (Real.sqrt_pos.mpr hQ0))
    have htq : t ^ 2 * Q = (4 - Q) / 4 := by
      dsimp [t]
      rw [div_pow, mul_pow, Real.sq_sqrt hQ0.le, Real.sq_sqrt (by linarith : 0 ≤ 4 - Q)]
      field_simp
      ring
    let uc := y.1 / 2 - t * y.2
    let us := y.2 / 2 + t * y.1
    let vc := y.1 / 2 + t * y.2
    let vs := y.2 / 2 - t * y.1
    have haux := congrArg (fun z : ℝ => t ^ 2 * z) hQ
    have hu : uc ^ 2 + us ^ 2 = 1 := by
      dsimp [uc, us]
      nlinarith only [htq, hQ, haux]
    have hv : vc ^ 2 + vs ^ 2 = 1 := by
      dsimp [vc, vs]
      nlinarith only [htq, hQ, haux]
    obtain ⟨θ, hθm, hθc, hθs⟩ := angle_rep uc us hu
    obtain ⟨φ, hφm, hφc, hφs⟩ := angle_rep vc vs hv
    have hs : Real.sin (θ - φ) = t * Q := by
      rw [Real.sin_sub, hθs, hφc, hθc, hφs, hQ]
      dsimp [uc, us, vc, vs]
      ring
    have hyc : Real.cos θ + Real.cos φ = y.1 := by rw [hθc, hφc]; dsimp [uc, vc]; ring
    have hys : Real.sin θ + Real.sin φ = y.2 := by rw [hθs, hφs]; dsimp [us, vs]; ring
    cases b
    · refine ⟨(φ, θ), ⟨hφm, hθm, ?_⟩, ?_⟩
      · simp only [Bool.false_eq_true, ↓reduceIte]
        have he : φ - θ = -(θ - φ) := by ring
        rw [he, Real.sin_neg, neg_neg, hs]
        exact mul_pos ht hQ0
      · exact Prod.ext (by simpa only [add_comm] using hyc) (by simpa only [add_comm] using hys)
    · refine ⟨(θ, φ), ⟨hθm, hφm, ?_⟩, ?_⟩
      · simp only [↓reduceIte]
        rw [hs]
        exact mul_pos ht hQ0
      · exact Prod.ext hyc hys

private theorem CA.Dens.twoCircle_signed_change_of_variables (b : Bool) (h : ℝ × ℝ → ENNReal) :
    (∫⁻ y in {y : ℝ × ℝ | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4}, h y) =
    ∫⁻ p in {p : ℝ × ℝ | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
      0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))},
      ENNReal.ofReal |Real.sin (p.1 - p.2)| *
        h (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2) := by
  let S : Set (ℝ × ℝ) := {p | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
    0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))}
  have hs : MeasurableSet S := by cases b <;> dsimp [S] <;> measurability
  rw [← CA.Dens.circle_sum_sheet_image b]
  exact CA.Dens.twoCircle_change_of_variables S hs
    (CA.Dens.circle_sum_injective_sheet b) h


private noncomputable def CA.chart : Pt ≃ᵐ (ℝ × ℝ) :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

private theorem CA.chart_preserving : MeasurePreserving CA.chart :=
  (volume_preserving_finTwoArrow ℝ).comp (PiLp.volume_preserving_ofLp (Fin 2))

private theorem CA.chart_norm_sq (p : ℝ × ℝ) :
    ‖CA.chart.symm p‖ ^ 2 = p.1 ^ 2 + p.2 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
  rfl

private theorem CA.chart_sum (p : ℝ × ℝ) :
    CA.chart.symm (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2) =
      circPt p.1 + circPt p.2 := by
  ext i
  fin_cases i <;> simp [CA.chart, circPt, e1, e2, EuclideanSpace.single_apply]

private theorem CA.region (p : ℝ × ℝ) :
    (0 < ‖CA.chart.symm p‖ ∧ ‖CA.chart.symm p‖ < 2) ↔
      (0 < p.1 ^ 2 + p.2 ^ 2 ∧ p.1 ^ 2 + p.2 ^ 2 < 4) := by
  have hn := norm_nonneg (CA.chart.symm p)
  have hs := CA.chart_norm_sq p
  constructor <;> rintro ⟨h0, h2⟩ <;> constructor <;> nlinarith

private theorem CA.a_measurable : Measurable C1.a := by
  unfold C1.a
  exact Measurable.ite (by measurability) (by fun_prop) measurable_const

private theorem CA.a_nonneg (r : ℝ) : 0 ≤ C1.a r := by
  unfold C1.a
  split_ifs with h
  · exact div_nonneg (by norm_num) (mul_nonneg h.1.le (Real.sqrt_nonneg _))
  · rfl

private theorem CA.sin_ne_ae : ∀ᵐ p : ℝ × ℝ, Real.sin (p.1 - p.2) ≠ 0 := by
  rw [Measure.volume_eq_prod]
  apply (Measure.ae_prod_iff_ae_ae (by measurability : MeasurableSet {p : ℝ × ℝ | Real.sin (p.1 - p.2) ≠ 0})).2
  apply Filter.Eventually.of_forall
  intro a
  have hc : Set.Countable {b : ℝ | Real.sin (a - b) = 0} := by
    refine (Set.countable_range (fun n : ℤ => a - n * Real.pi)).mono ?_
    intro b hb
    obtain ⟨n, hn⟩ := Real.sin_eq_zero_iff.mp hb
    exact ⟨n, by linarith⟩
  rw [ae_iff]
  simpa only [not_not] using hc.measure_zero (volume : Measure ℝ)

private theorem CA.jac_a (p : ℝ × ℝ) (hp : Real.sin (p.1 - p.2) ≠ 0) :
    ENNReal.ofReal |Real.sin (p.1 - p.2)| *
      ENNReal.ofReal (C1.a ‖circPt p.1 + circPt p.2‖) = 2 := by
  let r := ‖circPt p.1 + circPt p.2‖
  have hg := (CA.Dens.circle_sum_geometry p.1 p.2).2
  have hrn : 0 ≤ r := norm_nonneg _
  have hprod : 0 < r * Real.sqrt (4 - r ^ 2) := by
    have hpos := abs_pos.mpr hp
    change |Real.sin (p.1 - p.2)| = r * Real.sqrt (4 - r ^ 2) / 2 at hg
    linarith
  have hr : 0 < r := by nlinarith [Real.sqrt_nonneg (4 - r ^ 2)]
  have hs : 0 < Real.sqrt (4 - r ^ 2) := by nlinarith
  have hr2 : r < 2 := by
    have := Real.sqrt_pos.mp hs
    nlinarith
  have he : |Real.sin (p.1 - p.2)| * C1.a r = 2 := by
    rw [C1.a, if_pos ⟨hr, hr2⟩]
    change |Real.sin (p.1 - p.2)| = r * Real.sqrt (4 - r ^ 2) / 2 at hg
    rw [hg]
    field_simp [ne_of_gt hr, ne_of_gt hs]
    <;> norm_num
  rw [← ENNReal.ofReal_mul (abs_nonneg _), he]
  norm_num

private theorem CA.circle_density :
    Measure.map (fun z : Pt × Pt => z.1 + z.2) (arcMeasure.prod arcMeasure) =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖)) := by
  classical
  let U : Set (ℝ × ℝ) := {y | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4}
  let T : Set (ℝ × ℝ) := Set.Ico 0 (2 * Real.pi) ×ˢ Set.Ico 0 (2 * Real.pi)
  let S (b : Bool) : Set (ℝ × ℝ) := {p | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧
    p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
    0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))}
  have hU : MeasurableSet U := by dsimp [U]; measurability
  have hS (b : Bool) : MeasurableSet (S b) := by cases b <;> dsimp [S] <;> measurability
  have hT : MeasurableSet T := measurableSet_Ico.prod measurableSet_Ico
  refine Measure.ext_of_lintegral _ fun h hh => ?_
  let g : ℝ × ℝ → ENNReal := fun p => h (circPt p.1 + circPt p.2)
  let d : ℝ × ℝ → ENNReal := fun y => ENNReal.ofReal (C1.a ‖CA.chart.symm y‖) * h (CA.chart.symm y)
  have hd (y : ℝ × ℝ) : d y = U.indicator d y := by
    by_cases hy : y ∈ U
    · simp [hy]
    · have hr : ¬(0 < ‖CA.chart.symm y‖ ∧ ‖CA.chart.symm y‖ < 2) := by
        simpa only [CA.region, Set.mem_setOf_eq, U] using hy
      rw [Set.indicator_of_notMem hy]
      change ENNReal.ofReal (C1.a ‖CA.chart.symm y‖) * h (CA.chart.symm y) = 0
      rw [C1.a, if_neg hr, ENNReal.ofReal_zero, zero_mul]
  have hdU : (∫⁻ y : ℝ × ℝ, d y) = ∫⁻ y in U, d y := by
    rw [← lintegral_indicator hU]
    exact lintegral_congr hd
  have hsheet (b : Bool) : (∫⁻ y : ℝ × ℝ, d y) = 2 * ∫⁻ p in S b, g p := by
    rw [hdU, CA.Dens.twoCircle_signed_change_of_variables b]
    rw [← lintegral_const_mul' (2 : ENNReal) _ (by norm_num)]
    apply setLIntegral_congr_fun (hS b)
    intro p hp
    have hn : Real.sin (p.1 - p.2) ≠ 0 := by
      cases b <;> simp only [S, Set.mem_setOf_eq, Bool.false_eq_true, ite_false, ite_true] at hp <;> linarith [hp.2.2]
    dsimp [d, g]
    rw [CA.chart_sum, ← mul_assoc, CA.jac_a p hn]
  have hsum : (∫⁻ p in T, g p) = (∫⁻ p in S true, g p) + ∫⁻ p in S false, g p := by
    have hdisj : Disjoint (S true) (S false) := by
      refine Set.disjoint_left.mpr ?_
      intro p hp hq
      have hp' : 0 < Real.sin (p.1 - p.2) := hp.2.2
      have hq' : 0 < -Real.sin (p.1 - p.2) := hq.2.2
      linarith
    rw [← lintegral_union (hS false) hdisj]
    apply setLIntegral_congr
    filter_upwards [CA.sin_ne_ae] with p hp
    have hm : p ∈ T ↔ p ∈ S true ∪ S false := by
      simp only [T, S, Set.mem_prod, Set.mem_setOf_eq, Set.mem_union, ite_true, Bool.false_eq_true, ite_false]
      rcases lt_or_gt_of_ne hp with hneg | hpos
      · constructor
        · rintro ⟨h1, h2⟩; exact Or.inr ⟨h1, h2, by linarith⟩
        · rintro (⟨h1, h2, _⟩ | ⟨h1, h2, _⟩) <;> exact ⟨h1, h2⟩
      · constructor
        · rintro ⟨h1, h2⟩; exact Or.inl ⟨h1, h2, hpos⟩
        · rintro (⟨h1, h2, _⟩ | ⟨h1, h2, _⟩) <;> exact ⟨h1, h2⟩
    exact propext hm
  have hmain : (∫⁻ p in T, g p) = ∫⁻ y : ℝ × ℝ, d y := by
    apply (ENNReal.mul_left_inj (by norm_num : (2 : ENNReal) ≠ 0) (by norm_num : (2 : ENNReal) ≠ ⊤)).mp
    rw [mul_comm _ 2, mul_comm _ 2, hsum, mul_add, ← hsheet true, ← hsheet false, two_mul]
  have hc : Measurable circPt := by unfold circPt; fun_prop
  have ha : Measurable (fun z : Pt × Pt => z.1 + z.2) := measurable_fst.add measurable_snd
  calc
    _ = ∫⁻ z : Pt × Pt, h (z.1 + z.2) ∂(arcMeasure.prod arcMeasure) := lintegral_map hh ha
    _ = ∫⁻ p in T, g p := by
      rw [arcMeasure, Measure.map_prod_map _ _ hc hc]
      have hm := lintegral_map (μ := (volume.restrict (Set.Ico 0 (2 * Real.pi))).prod
        (volume.restrict (Set.Ico 0 (2 * Real.pi)))) (hh.comp ha) (hc.prodMap hc)
      change (∫⁻ z, (h ∘ fun z : Pt × Pt => z.1 + z.2) z ∂_) = _
      rw [hm, Measure.prod_restrict]
      rfl
    _ = ∫⁻ y : ℝ × ℝ, d y := hmain
    _ = ∫⁻ y : Pt, ENNReal.ofReal (C1.a ‖y‖) * h y := by
      simpa only [d] using (CA.chart_preserving.symm.lintegral_map_equiv
        (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖) * h y) CA.chart.symm).symm
    _ = _ := (lintegral_withDensity_eq_lintegral_mul volume
      (CA.a_measurable.comp measurable_norm).ennreal_ofReal hh).symm


private theorem CA.unit (θ : ℝ) : ‖circPt θ‖ = 1 := by
  have hsq : ‖circPt θ‖ ^ 2 = 1 := by
    rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
    simp [circPt, e1, e2]
  nlinarith [norm_nonneg (circPt θ)]

private theorem CA.distance_sq (θ φ : ℝ) :
    ‖circPt θ - circPt φ‖ ^ 2 = 2 - 2 * Real.cos (φ - θ) := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two, Real.cos_sub]
  simp [circPt, e1, e2]
  nlinarith [Real.sin_sq_add_cos_sq θ, Real.sin_sq_add_cos_sq φ]

private theorem CA.distance_law (s : Bool) (θ : ℝ) :
    Measure.map (fun w : Pt => ‖circPt θ - w‖) (stepLaw s) =
      Measure.map (fun w : Pt => ‖e1 - w‖) (stepLaw s) := by
  have hc : Measurable circPt := by unfold circPt; fun_prop
  have hm (u : Pt) : Measurable (fun w : Pt => ‖u - w‖) := by fun_prop
  cases s
  · simp only [stepLaw, Bool.false_eq_true, if_false]
    rw [arcMeasure, Measure.map_map (hm _) hc, Measure.map_map (hm _) hc]
    refine Measure.ext_of_lintegral _ fun h hh => ?_
    rw [lintegral_map hh ((hm _).comp hc), lintegral_map hh ((hm _).comp hc)]
    change (∫⁻ t in Set.Ico 0 (2 * Real.pi), h ‖circPt θ - circPt t‖) =
      ∫⁻ t in Set.Ico 0 (2 * Real.pi), h ‖e1 - circPt t‖
    let g : ℝ → ENNReal := fun t => h ‖e1 - circPt t‖
    have hp : Function.Periodic g (2 * Real.pi) := by
      intro t
      simp [g, circPt, Real.cos_add, Real.sin_add]
    calc
      _ = ∫⁻ t in Set.Ico 0 (2 * Real.pi), g (t + -θ) := by
        apply lintegral_congr
        intro t
        congr 1
        have h0 : circPt 0 = e1 := by simp [circPt]
        change ‖circPt θ - circPt t‖ = ‖e1 - circPt (t + -θ)‖
        apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
        rw [CA.distance_sq, ← h0, CA.distance_sq]
        simp [sub_eq_add_neg]
      _ = _ := CA.Dens.periodic_lintegral_shift (2 * Real.pi) (by positivity) g hp (-θ)
  · simp only [stepLaw, if_true]
    let R : Pt ≃ₗᵢ[ℝ] Pt := Submodule.reflection (ℝ ∙ (circPt θ - e1))ᗮ
    have hR : R (circPt θ) = e1 := by
      apply Submodule.reflection_sub
      simp [CA.unit, e1]
    have hpre : R ⁻¹' disk (0 : Pt) = disk 0 := by
      ext w
      simp only [Set.mem_preimage, disk, Metric.mem_ball, dist_zero_right]
      rw [R.norm_map]
    have hp : MeasurePreserving R (volume.restrict (disk (0 : Pt)))
        (volume.restrict (disk (0 : Pt))) := by
      have hp := R.measurePreserving.restrict_preimage
        (s := disk (0 : Pt)) Metric.isOpen_ball.measurableSet
      rwa [hpre] at hp
    have he (w : Pt) : ‖circPt θ - w‖ = ‖e1 - R w‖ := by
      rw [← R.norm_map (circPt θ - w), map_sub, hR]
    calc
      _ = Measure.map (fun w : Pt => ‖e1 - w‖)
          (Measure.map R (volume.restrict (disk (0 : Pt)))) := by
        rw [Measure.map_map (hm _) R.continuous.measurable]
        congr 1
        funext w
        exact he w
      _ = _ := by rw [hp.map_eq]

private theorem CA.radial_integral (h : ℝ → ℝ) (hh : Measurable h) (s : Bool) (θ : ℝ) :
    (∫ w, h ‖circPt θ + w‖ ∂(stepLaw s)) =
      ∫ w, h ‖e1 - w‖ ∂(stepLaw s) := by
  have hm (u : Pt) : Measurable (fun w : Pt => ‖u - w‖) := by fun_prop
  have he := congrArg (fun μ : Measure ℝ => ∫ r, h r ∂μ) (CA.distance_law s (θ + Real.pi))
  rw [integral_map_of_stronglyMeasurable (hm _) hh.stronglyMeasurable,
    integral_map_of_stronglyMeasurable (hm _) hh.stronglyMeasurable] at he
  calc
    _ = ∫ w, h ‖circPt (θ + Real.pi) - w‖ ∂(stepLaw s) := by
      apply integral_congr_ae
      apply Filter.Eventually.of_forall
      intro w
      apply congrArg h
      have hn : circPt (θ + Real.pi) = -circPt θ := by
        simp only [circPt, Real.cos_add_pi, Real.sin_add_pi, neg_smul, neg_add]
      have hw : circPt (θ + Real.pi) - w = -(circPt θ + w) := by rw [hn]; abel
      rw [hw, norm_neg]
    _ = _ := he

private theorem CA.pair_density (s : Bool) :
    Measure.map (fun p : Pt × Pt => p.1 + p.2) (arcMeasure.prod (stepLaw s)) =
      volume.withDensity (fun z : Pt => ENNReal.ofReal (pairDensity false s ‖z‖)) := by
  cases s
  · simpa [stepLaw, pairDensity] using CA.circle_density
  · simpa [stepLaw] using CA.Dens.mixed false true (by decide)

private theorem CA.pair_measurable (s : Bool) : Measurable (pairDensity false s) := by
  cases s
  · simpa [pairDensity] using CA.a_measurable
  · change Measurable C1.b
    unfold C1.b
    exact Measurable.ite (by measurability) (by fun_prop) measurable_const

private theorem CA.pair_nonneg (s : Bool) (r : ℝ) : 0 ≤ pairDensity false s r := by
  cases s
  · simpa [pairDensity] using CA.a_nonneg r
  · change 0 ≤ C1.b r
    unfold C1.b
    split_ifs
    · exact mul_nonneg (by norm_num) (Real.arccos_nonneg _)
    · rfl

private theorem CA.average (h : ℝ → ℝ) (s : Bool) (hh : Measurable h)
    (C : ℝ) (hC : ∀ r, |h r| ≤ C) :
    (∫ z : Pt, h ‖z‖ * pairDensity false s ‖z‖) =
      (2 * Real.pi) * ∫ w, h ‖e1 - w‖ ∂(stepLaw s) := by
  haveI : IsFiniteMeasure arcMeasure := by unfold arcMeasure; infer_instance
  haveI : IsFiniteMeasure (stepLaw s) := by
    cases s
    · simpa [stepLaw] using (inferInstance : IsFiniteMeasure arcMeasure)
    · exact isFiniteMeasure_restrict.mpr measure_ball_lt_top.ne
  have hc : Measurable circPt := by unfold circPt; fun_prop
  have hf : Measurable (fun p : Pt × Pt => h ‖p.1 + p.2‖) :=
    hh.comp ((measurable_fst.add measurable_snd).norm)
  have hi : Integrable (fun p : Pt × Pt => h ‖p.1 + p.2‖)
      (arcMeasure.prod (stepLaw s)) := by
    refine Integrable.of_bound hf.aestronglyMeasurable C ?_
    exact Filter.Eventually.of_forall fun p => by simpa only [Real.norm_eq_abs] using hC ‖p.1 + p.2‖
  calc
    _ = ∫ z : Pt, h ‖z‖ ∂volume.withDensity
        (fun z : Pt => ENNReal.ofReal (pairDensity false s ‖z‖)) := by
      have hd : Measurable (fun z : Pt => ENNReal.ofReal (pairDensity false s ‖z‖)) :=
        ((CA.pair_measurable s).comp measurable_norm).ennreal_ofReal
      rw [integral_withDensity_eq_integral_toReal_smul hd
        (Filter.Eventually.of_forall fun _ => ENNReal.ofReal_lt_top) (fun z : Pt => h ‖z‖)]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z => by
        change h ‖z‖ * pairDensity false s ‖z‖ =
          (ENNReal.ofReal (pairDensity false s ‖z‖)).toReal * h ‖z‖
        rw [ENNReal.toReal_ofReal (CA.pair_nonneg s ‖z‖), mul_comm]
    _ = ∫ p : Pt × Pt, h ‖p.1 + p.2‖ ∂(arcMeasure.prod (stepLaw s)) := by
      rw [← CA.pair_density s]
      exact integral_map_of_stronglyMeasurable (measurable_fst.add measurable_snd)
        (hh.comp measurable_norm).stronglyMeasurable
    _ = ∫ c, ∫ w, h ‖c + w‖ ∂(stepLaw s) ∂arcMeasure := integral_prod _ hi
    _ = ∫ t in Set.Ico 0 (2 * Real.pi), ∫ w, h ‖circPt t + w‖ ∂(stepLaw s) := by
      rw [arcMeasure]
      exact integral_map_of_stronglyMeasurable hc hf.stronglyMeasurable.integral_prod_right'
    _ = _ := by
      simp_rw [CA.radial_integral h hh s]
      simp [Real.volume_Ico, Real.pi_pos.le]

theorem solution_s12568911 :
    ∀ (h : ℝ → ℝ) (s : Bool), Measurable h → (∃ C : ℝ, ∀ r : ℝ, |h r| ≤ C) →
      (∫ w, h ‖e1 - w‖ ∂(stepLaw s)) = 1 / (2 * Real.pi) * ∫ z : Pt, h ‖z‖ * pairDensity false s ‖z‖ := by
  intro h s hh hbd
  obtain ⟨C, hC⟩ := hbd
  rw [CA.average h s hh C hC]
  have hp : 2 * Real.pi ≠ 0 := by positivity
  field_simp
