theorem solution_s12569089 :
    (∫ x, (if ‖∑ i, x i‖ < 1 then (1 : ℝ) else 0) ∂freeCircle4) = 16 * Real.pi ^ 4 / 5 := by
  let P : ℝ → ℝ := fun r => if r < 1 then 1 else 0
  have hPm : Measurable P := by
    exact measurable_const.ite (measurableSet_lt measurable_id measurable_const) measurable_const
  have hPb : ∃ C : ℝ, ∀ r : ℝ, |P r| ≤ C := by
    refine ⟨1, ?_⟩
    intro r
    by_cases h : r < 1 <;> simp [P, h]
  have hPv : ∀ r : ℝ, 1 ≤ r → P r = 0 := by
    intro r hr
    simp [P, not_lt.mpr hr]
  have he (k : ℝ) (hk : 0 < k) : hankel P k = J1 k / k :=
    (HardDiskB5.C3.elem_hankels k (ne_of_gt hk)).1
  have hF : (fun k : ℝ => k * J0 k ^ 4 * hankel P k) =ᵐ[volume.restrict (Set.Ioi (0 : ℝ))]
      (fun k : ℝ => J1 k * J0 k ^ 4) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with k hk
    change 0 < k at hk
    rw [he k hk]
    field_simp [ne_of_gt hk]
    <;> ring
  have hS : (fun k : ℝ => k * H0 k ^ 2 * hankel P k) =ᵐ[volume.restrict (Set.Ioi (0 : ℝ))]
      (fun k : ℝ => J1 k * H0 k ^ 2) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with k hk
    change 0 < k at hk
    rw [he k hk]
    field_simp [ne_of_gt hk]
    <;> ring
  have hiF : IntegrableOn (fun k : ℝ => k * J0 k ^ 4 * hankel P k) (Set.Ioi (0 : ℝ)) :=
    HardDiskB5.C3.bessel_integrals.1.congr hF.symm
  have hiS : IntegrableOn (fun k : ℝ => k * H0 k ^ 2 * hankel P k) (Set.Ioi (0 : ℝ)) :=
    FDTotal.integrable_far.congr hS.symm
  calc
    _ = 16 * Real.pi ^ 4 * (∫ k in Set.Ioi (0 : ℝ), k * J0 k ^ 4 * hankel P k) :=
      (HardDiskB5.C3.free4_parseval P hPm hPb hPv hiF hiS).1
    _ = 16 * Real.pi ^ 4 * (1 / 5) := by
      rw [integral_congr_ae hF, HardDiskB5.C3.bessel_integrals.2.2.2.1]
    _ = 16 * Real.pi ^ 4 / 5 := by ring
