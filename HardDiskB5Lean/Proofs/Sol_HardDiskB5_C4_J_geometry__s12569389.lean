private theorem hdj_base_measurable : MeasurableSet fundamental := by
  change MeasurableSet {s : AngleTriple |
    s.1 < 1 / 2 ∧ s.2.1 < s.1 ∧ |s.2.2| < s.2.1}
  have h1 : IsOpen {s : AngleTriple | s.1 < (1 / 2 : ℝ)} :=
    isOpen_lt continuous_fst continuous_const
  have h2 : IsOpen {s : AngleTriple | s.2.1 < s.1} :=
    isOpen_lt (continuous_fst.comp continuous_snd) continuous_fst
  have h3 : IsOpen {s : AngleTriple | |s.2.2| < s.2.1} :=
    isOpen_lt ((continuous_snd.comp continuous_snd).abs)
      (continuous_fst.comp continuous_snd)
  exact (h1.inter (h2.inter h3)).measurableSet

