  rcases pp_angle w hw hwe with ⟨hw0, hw2, hwc, hws⟩
  rw [← hzc, ← hzs, ← hwc, ← hws,
    pp_cot_half _ hw0 hw2, pp_cot_half _ hz0 hz2]
  have hsz : 0 < Real.sin (angE z / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
  have hsw : 0 < Real.sin (angE w / 2) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
  apply (div_le_div_iff₀ hsw hsz).2
