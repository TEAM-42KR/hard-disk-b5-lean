theorem solution_s12568781 :
    (∀ ζ : Fin 4 → Pt, (∀ i, ‖ζ i‖ = 1) → ∑ i, ζ i = e1 → (∀ i, ζ i ≠ e1) →
        (∀ i j, i ≠ j → ζ i ≠ -ζ j) →
      (((IsFar ζ 0 1 ∧ IsFar ζ 2 3) ∧ ¬(IsFar ζ 0 2 ∧ IsFar ζ 1 3) ∧ ¬(IsFar ζ 0 3 ∧ IsFar ζ 1 2)) ∨
        (¬(IsFar ζ 0 1 ∧ IsFar ζ 2 3) ∧ (IsFar ζ 0 2 ∧ IsFar ζ 1 3) ∧ ¬(IsFar ζ 0 3 ∧ IsFar ζ 1 2)) ∨
        (¬(IsFar ζ 0 1 ∧ IsFar ζ 2 3) ∧ ¬(IsFar ζ 0 2 ∧ IsFar ζ 1 3) ∧ (IsFar ζ 0 3 ∧ IsFar ζ 1 2))) ∧
      ∀ σ : Equiv.Perm (Fin 4), Monotone (fun k => angE (ζ (σ k))) →
        IsFar ζ (σ 0).castSucc (σ 1).castSucc ∧ IsFar ζ (σ 2).castSucc (σ 3).castSucc) := by
  intro ζ hu hs hne hop
  have sorted (σ : Equiv.Perm (Fin 4))
      (ho : Monotone (fun k => angE (ζ (σ k)))) := by
    have hsum : ∑ i, ζ (σ i) = e1 := by rw [Equiv.sum_comp]; exact hs
    have hanti : Antitone (fun i => (ζ (σ i)) 1 / (1 - (ζ (σ i)) 0)) := by
      intro i j hij
      exact pp_slope_antitone _ _ (hu _) (hu _) (hne _) (hne _) (ho hij)
    exact pp_sorted (fun i => ζ (σ i)) (fun i => hu _) hsum (fun i => hne _) hanti
  constructor
  · let σ := Tuple.sort (fun i => angE (ζ i))
    have hh := pp_reindex (fun i j => 1 < ‖ζ i + ζ j‖)
      (fun i j => by rw [add_comm]) σ
      (sorted σ (by simpa only [Function.comp_def] using
        Tuple.monotone_sort (fun i => angE (ζ i))))
    exact hh
  · intro σ ho
    have hx (i : Fin 4) : xExt ζ i.castSucc = ζ i := by simp [xExt]
    simpa only [IsFar, pairSum, hx] using (sorted σ ho).1
