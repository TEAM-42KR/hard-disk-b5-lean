        (pow_le_pow_left₀ (norm_nonneg _) (hNb y) 2))
  have hJ : Integrable (s.indicator f) := hI.indicator hs
  have hK : Integrable (t.indicator g) := (integrable_indicator_iff ht).mpr hSq
  apply (((hJ.const_mul 3).sub hI).sub (hK.const_mul 3)).congr
  filter_upwards with y
  by_cases hy : ‖y‖ < 1 <;> by_cases hty : y ∈ lensAt 1
  all_goals simp [s, t, f, g, wfF, hy, hty] <;> ring

private theorem wf_mem_lens (y : Pt) :
    y ∈ lensAt 1 ↔ ‖y‖ < 1 ∧ ‖e1 - y‖ < 1 := by
  simp only [lensAt, one_smul, Set.mem_inter_iff, disk, Metric.mem_ball, dist_zero_right]
  rw [dist_comm y e1, dist_eq_norm]

private theorem wf_ind_norm (r : ℝ) (hr : 0 ≤ r) :
    (if r < 1 then (1 : ℝ) else 0) = c4ind (1 - r ^ 2 / 2) := by
  have hh : 1 / 2 < 1 - r ^ 2 / 2 ↔ r < 1 := by
    constructor
    · intro h
      nlinarith [sq_nonneg (r - 1)]
    · intro h
      have hm : 0 < (1 - r) * (1 + r) := mul_pos (by linarith) (by linarith)
      nlinarith
  simp only [c4ind, hh]

private theorem wf_point (y : Pt) (hy : ‖y‖ < 2 ∧ ‖e1 - y‖ < 2)
    (hN : lensN 1 y = c4N1 (c4chart y).1 (c4chart y).2) :
    (wfF y + wfF (e1 - y)) / 2 = wfG (c4chart y) := by
  have hR : e1 - (e1 - y) = y := by abel
  have hAp : lensArea ‖y‖ = c4a (c4chart y).1 :=
    wf_lensArea ‖y‖ (norm_nonneg _) hy.1.le
  have hAq : lensArea ‖e1 - y‖ = c4a (c4chart y).2 :=
    wf_lensArea ‖e1 - y‖ (norm_nonneg _) hy.2.le
  have hip : (if ‖y‖ < 1 then (1 : ℝ) else 0) = c4ind (c4chart y).1 :=
    wf_ind_norm ‖y‖ (norm_nonneg _)
  have hiq : (if ‖e1 - y‖ < 1 then (1 : ℝ) else 0) = c4ind (c4chart y).2 :=
    wf_ind_norm ‖e1 - y‖ (norm_nonneg _)
  have hInd : (lensAt 1).indicator (fun _ => (1 : ℝ)) y =
      c4ind (c4chart y).1 * c4ind (c4chart y).2 := by
    rw [← hip, ← hiq]
    by_cases hp : ‖y‖ < 1 <;> by_cases hq : ‖e1 - y‖ < 1
    all_goals simp [wf_mem_lens, hp, hq]
  have hRefInd : (lensAt 1).indicator (fun _ => (1 : ℝ)) (e1 - y) =
      (lensAt 1).indicator (fun _ => (1 : ℝ)) y := by
    have hm : e1 - y ∈ lensAt 1 ↔ y ∈ lensAt 1 := by
      simp only [wf_mem_lens, hR, and_comm]
    by_cases hp : y ∈ lensAt 1 <;> simp [hm, hp]
  simp only [wfF, hR, HardDiskB5.C4.N1_reflect, hAp, hAq, hip, hiq, hRefInd, hInd, hN, wfG]
  ring

private theorem wf_support (y : Pt) (hy : ¬ (‖y‖ < 2 ∧ ‖e1 - y‖ < 2)) :
    (wfF y + wfF (e1 - y)) / 2 = 0 := by
  have hNv : lensN 1 y = 0 := by
    apply HardDiskB5.C4.N1_vanish y
    by_cases hp : ‖y‖ < 2
    · exact Or.inr (le_of_not_gt (fun hq => hy ⟨hp, hq⟩))
    · exact Or.inl (le_of_not_gt hp)
  simp [wfF, HardDiskB5.C4.N1_reflect, hNv]

theorem solution_s12568914 :
    2 * psiIn - psiOut - 3 * P1 = ∫ z in c1Domain, c4walk z.1 z.2 := by
  have hF : Integrable wfF := wf_F_integrable
  have hR : Integrable (fun y : Pt => wfF (e1 - y)) := hF.comp_sub_left e1
  have hAvg : (∫ y : Pt, (wfF y + wfF (e1 - y)) / 2) = ∫ y : Pt, wfF y := by
    rw [integral_div, integral_add hF hR, integral_sub_left_eq_self wfF volume e1]
    ring
  have hU : MeasurableSet {y : Pt | ‖y‖ < 2 ∧ ‖e1 - y‖ < 2} :=
    ((isOpen_lt continuous_norm continuous_const).inter
      (isOpen_lt (continuous_const.sub continuous_id).norm continuous_const)).measurableSet
  calc
    2 * psiIn - psiOut - 3 * P1 = ∫ y : Pt, wfF y := HardDiskB5.C4.walk_x12
    _ = ∫ y : Pt, (wfF y + wfF (e1 - y)) / 2 := hAvg.symm
    _ = ∫ y in {y : Pt | ‖y‖ < 2 ∧ ‖e1 - y‖ < 2}, (wfF y + wfF (e1 - y)) / 2 := by
      symm
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
      exact wf_support
    _ = ∫ y in {y : Pt | ‖y‖ < 2 ∧ ‖e1 - y‖ < 2}, wfG (c4chart y) := by
      apply integral_congr_ae
      filter_upwards [wf_N1_ae, ae_restrict_mem hU] with y hN hy
      exact wf_point y hy hN
    _ = ∫ z in c1Domain, 4 / Real.sqrt (chartH z.1 z.2) * wfG z :=
      HardDiskB5.C4.chart_cov wfG wf_integrable
    _ = ∫ z in c1Domain, c4walk z.1 z.2 := by
      apply integral_congr_ae
      filter_upwards with z
      unfold wfG c4walk
      ring
