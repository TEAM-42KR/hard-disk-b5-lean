  (((-125 / 1152 : ℝ) * r) + ((-1 / 6 : ℝ) * (t ^ 3)) + ((1 / 16 : ℝ) * P) + ((95 / 64 : ℝ) * y) + ((161 / 288 : ℝ) * t) + ((-9 / 16 : ℝ) * t * (x ^ 2)) + ((-7 / 24 : ℝ) * P * x) + ((-3 / 2 : ℝ) * t * x) + ((-3 / 4 : ℝ) * y * (t ^ 2)) + ((-1 / 8 : ℝ) * P * (x ^ 2)) + ((-1 / 12 : ℝ) * P * (t ^ 2)) + ((-1 / 12 : ℝ) * y * (x ^ 3)) + ((-1 / 24 : ℝ) * P * (x ^ 3)) + ((1 / 8 : ℝ) * r * (t ^ 2)) + ((1 / 12 : ℝ) * r * (x ^ 4)) + ((7 / 48 : ℝ) * r * (x ^ 3)) + ((37 / 96 : ℝ) * r * x) + ((89 / 576 : ℝ) * r * (x ^ 2)) + ((161 / 576 : ℝ) * x * y) + ((-1 / 4 : ℝ) * P * t * y) + ((-1 / 4 : ℝ) * r * x * (t ^ 2)) + ((-1 / 4 : ℝ) * r * (t ^ 2) * (x ^ 2)) + ((-1 / 4 : ℝ) * x * y * (t ^ 2)) + ((7 / 16 : ℝ) * r * t * y) + ((-1 / 12 : ℝ) * P * r * t * x) + ((-1 / 12 : ℝ) * P * r * t * (x ^ 2)) + ((-1 / 12 : ℝ) * P * t * x * y) + ((1 / 4 : ℝ) * r * t * y * (x ^ 2)) + ((1 / 12 : ℝ) * P * r * x * y) + ((1 / 24 : ℝ) * P * r * y * (x ^ 2)) + ((9 / 16 : ℝ) * r * t * x * y))

private theorem HDUp2.primitive_eq (r P t : ℝ) :
    HDUp2.primitive r P t = HDUp2.primitivePoly (Real.cos t) (Real.sin t) r t P := by
  have hs3 : Real.sin (3*t) = Real.sin t * (4*Real.cos t^2-1) := by
    rw [show 3*t=2*t+t by ring, Real.sin_add, Real.sin_two_mul, Real.cos_two_mul]
    ring
  have hc4 : Real.cos (4*t) = 8*Real.cos t^4-8*Real.cos t^2+1 := by
    rw [show 4*t=2*(2*t) by ring, Real.cos_two_mul, Real.cos_two_mul]
    ring
  have hs4 : Real.sin (4*t) = 8*Real.sin t*Real.cos t^3-4*Real.sin t*Real.cos t := by
    rw [show 4*t=2*(2*t) by ring, Real.sin_two_mul, Real.sin_two_mul, Real.cos_two_mul]
    ring
  dsimp [HDUp2.primitive, HDUp2.primitivePoly]
  rw [Real.cos_two_mul,Real.sin_two_mul,Real.cos_three_mul,hs3,hc4,hs4]
  ring

private theorem HDUp2.endpoints :
    (3/2) * (HDUp2.primitive (Real.sqrt 3) Real.pi (2*Real.pi/3)
      - HDUp2.primitive (Real.sqrt 3) Real.pi (Real.pi/3))
      = -23*Real.pi^3/216 + Real.sqrt 3*Real.pi^2/48 + 773*Real.pi/576
        - 635*Real.sqrt 3/768 := by
  have hc : Real.cos (2*Real.pi/3) = -(1/2 : ℝ) := by
    rw [show 2*Real.pi/3=Real.pi-Real.pi/3 by ring,Real.cos_pi_sub,Real.cos_pi_div_three]
  have hs : Real.sin (2*Real.pi/3) = Real.sqrt 3/2 := by
    rw [show 2*Real.pi/3=Real.pi-Real.pi/3 by ring,Real.sin_pi_sub,Real.sin_pi_div_three]
  rw [HDUp2.primitive_eq,HDUp2.primitive_eq]
  dsimp [HDUp2.primitivePoly]
  rw [hc,hs,Real.cos_pi_div_three,Real.sin_pi_div_three]
  linear_combination (-19*Real.pi/128) * (Real.sq_sqrt (show (0:ℝ) ≤ 3 by norm_num))

theorem solution_s12568920 :
    (-3 / 2) * (-∫ l in (Real.pi / 3)..(2 * Real.pi / 3),
        (c4Fp (-Real.cos l) (-Real.cos (l + Real.pi / 3)) * Real.sin (l + Real.pi / 3)
          - c4Fq (-Real.cos l) (-Real.cos (l + Real.pi / 3)) * Real.sin l))
      = -23 * Real.pi ^ 3 / 216 + Real.sqrt 3 * Real.pi ^ 2 / 48 + 773 * Real.pi / 576
        - 635 * Real.sqrt 3 / 768 := by
  have hint : IntervalIntegrable (HDUp2.density (Real.sqrt 3) Real.pi) volume
