    HardDiskB5.L1TopI.triple_pair_density (decide (3 ∈ K)) (decide (0 ∈ K)) (decide (1 ∈ K))]
  simpa only [pairDensity, Bool.and_comm, Bool.or_comm] using
    HardDiskB5.L1.TOPI2_pair_density_reflect true (decide (3 ∈ K)) (decide (0 ∈ K)) (decide (1 ∈ K))


private theorem topi2_walkK_min3_density_arc_finite : IsFiniteMeasure arcMeasure := by
  unfold arcMeasure
  infer_instance

private theorem topi2_walkK_min3_density_step_finite (b : Bool) : IsFiniteMeasure (stepLaw b) := by
  cases b
  · simpa [stepLaw] using topi2_walkK_min3_density_arc_finite
  · dsimp [stepLaw, disk]
    exact isFiniteMeasure_restrict.mpr measure_ball_ne_top

private theorem HardDiskB5.L1.TOPI2_walkK_min3_density (K : Finset (Fin 4)) (hK : K.Nonempty) (hmin : K.min' hK = 3) :
    Measure.map (fun x : Fin 4 → Pt => x 0 + x 1) (walkK K) =
      volume.withDensity (fun y : Pt =>
        ENNReal.ofReal (pairDensity (decide (0 ∈ K)) (decide (1 ∈ K)) ‖y‖) *
        ENNReal.ofReal (pairDensity (decide (2 ∈ K)) true ‖e1 - y‖)) := by
  classical
  letI (b : Bool) : IsFiniteMeasure (stepLaw b) := topi2_walkK_min3_density_step_finite b
  let μ : Fin 4 → Measure Pt := fun i => if i = 3 then Measure.dirac (0 : Pt) else stepLaw (decide (i ∈ K))
  haveI (i : Fin 4) : IsFiniteMeasure (μ i) := by dsimp [μ]; split_ifs <;> infer_instance
  let ν := (stepLaw (decide (2 ∈ K))).prod
    ((stepLaw (decide (0 ∈ K))).prod (stepLaw (decide (1 ∈ K))))
  let Q : Pt × (Pt × Pt) → (Fin 4 → Pt) := fun z => ![z.2.1, z.2.2, z.1, 0]
  let U : (Fin 4 → Pt) → (Fin 4 → Pt) := fun x => Function.update x 3
    (e1 - ∑ i ∈ (Finset.univ : Finset (Fin 4)).erase 3, x i)
  let A : Set (Fin 4 → Pt) := {x | e1 - ∑ i ∈ (Finset.univ : Finset (Fin 4)).erase 3, x i ∈ disk 0}
  have he : (Finset.univ : Finset (Fin 4)).erase 3 = {0, 1, 2} := by decide
  have hQ : Measurable Q := by
    apply measurable_pi_lambda
    intro i
    fin_cases i <;> dsimp [Q] <;> fun_prop
  have hsum : Measurable (fun x : Fin 4 → Pt => ∑ i ∈ (Finset.univ : Finset (Fin 4)).erase 3, x i) := by
    fun_prop
  have hU : Measurable U := by
    apply measurable_pi_lambda
    intro i
    by_cases hi : i = 3
    · subst i
      exact measurable_const.sub hsum
    · simpa only [U, Function.update_of_ne hi] using measurable_pi_apply i
  have hA : MeasurableSet A :=
    (show MeasurableSet (disk (0 : Pt)) from measurableSet_ball).preimage (measurable_const.sub hsum)
  have hρ : Measurable (fun x : Fin 4 → Pt => x 0 + x 1) :=
    (measurable_pi_apply 0).add (measurable_pi_apply 1)
  have hπ : Measure.pi μ = Measure.map Q ν := by
    apply Measure.pi_eq
    intro s hs
    rw [Measure.map_apply hQ (MeasurableSet.univ_pi hs)]
    have hp : Q ⁻¹' Set.univ.pi s =
        if (0 : Pt) ∈ s 3 then s 2 ×ˢ (s 0 ×ˢ s 1) else ∅ := by
      ext z
      by_cases hz : (0 : Pt) ∈ s 3 <;>
        simp [Q, Set.mem_pi, Fin.forall_fin_succ, hz, and_comm, and_left_comm, and_assoc] <;>
          constructor <;> rintro ⟨ha, hb, hc⟩ <;> exact ⟨hc, hb, ha⟩
    rw [hp]
    by_cases hz : (0 : Pt) ∈ s 3
    · simp [hz, ν, μ, Measure.prod_prod, Fin.prod_univ_succ, hs, mul_comm, mul_left_comm, mul_assoc] <;>
        exact (mul_comm _ _).trans ((mul_assoc _ _ _).trans (mul_left_comm _ _ _))
    · simp [hz, ν, μ, Fin.prod_univ_succ, hs]
  have hpre : Q ⁻¹' A =
      {z : Pt × (Pt × Pt) | e1 - (z.2.1 + z.2.2) - z.1 ∈ disk 0} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_setOf_eq, A, Q, he]
    have hsumQ : (∑ i ∈ ({0, 1, 2} : Finset (Fin 4)), ![z.2.1, z.2.2, z.1, 0] i) =
        z.1 + (z.2.1 + z.2.2) := by
      simp [Finset.sum_insert, Fin.ext_iff] <;> abel
    rw [hsumQ]
    congr 1
    abel
  have hout : (fun x : Fin 4 → Pt => x 0 + x 1) ∘ U ∘ Q =
      (fun z : Pt × (Pt × Pt) => z.2.1 + z.2.2) := by
    funext z
    simp [Function.comp_def, U, Q, he, Finset.sum_insert, Fin.ext_iff]
  change Measure.map (fun x : Fin 4 → Pt => x 0 + x 1) _ = _
  rw [walkK, dif_pos hK, hmin]
  change Measure.map (fun x : Fin 4 → Pt => x 0 + x 1) (Measure.map U ((Measure.pi μ).restrict A)) = _
  rw [hπ, Measure.restrict_map hQ hA, Measure.map_map hU hQ,
    Measure.map_map hρ (hU.comp hQ), hout, hpre]
  have hR : Measurable (fun y : Pt => e1 - y) := measurable_const.sub measurable_id
  have hO : Measurable (fun z : Pt × (Pt × Pt) => e1 - (z.2.1 + z.2.2)) := by
    fun_prop
  have href : (fun z : Pt × (Pt × Pt) => z.2.1 + z.2.2) =
      (fun y : Pt => e1 - y) ∘ (fun z : Pt × (Pt × Pt) => e1 - (z.2.1 + z.2.2)) := by
    funext z
    simp only [Function.comp_apply, sub_sub_cancel]
  rw [href, ← Measure.map_map hR hO,
    HardDiskB5.L1TopI.triple_pair_density (decide (2 ∈ K)) (decide (0 ∈ K)) (decide (1 ∈ K))]
  simpa only [pairDensity, Bool.and_comm, Bool.or_comm] using
    HardDiskB5.L1.TOPI2_pair_density_reflect true (decide (2 ∈ K)) (decide (0 ∈ K)) (decide (1 ∈ K))


theorem solution_s12569045 :
    ladderY 1 = 3 * C1.T C1.b C1.a - walkMass 1 ∧
    ladderY 2 = C1.T C1.c C1.a + 2 * C1.T C1.b C1.b - walkMass 2 ∧
    ladderY 3 = 3 * C1.T C1.c C1.b - walkMass 3 ∧
    ladderY 4 = 3 * C1.T C1.c C1.c - walkMass 4 ∧
    3 * walkMass 1 = 3 * C1.W C1.b C1.a ∧
    3 * walkMass 2 = C1.W C1.c C1.a + 2 * C1.W C1.b C1.b ∧
    3 * walkMass 3 = 3 * C1.W C1.c C1.b ∧
    3 * walkMass 4 = 3 * C1.W C1.c C1.c := by
  classical
  apply HardDiskB5.L1TopI.top_i_of_pair_pushforwards
  intro K hK
  generalize hj : K.min' hK = j
  have hjK : j ∈ K := hj ▸ Finset.min'_mem K hK
  fin_cases j
  · have hflag : decide ((0 : Fin 4) ∈ K) = true :=
      decide_eq_true (show (0 : Fin 4) ∈ K from hjK)
    rw [hflag]
    exact HardDiskB5.L1TopI.walkK_min0_density K hjK
  · have hflag : decide ((1 : Fin 4) ∈ K) = true :=
      decide_eq_true (show (1 : Fin 4) ∈ K from hjK)
    rw [hflag]
    exact HardDiskB5.L1.TOPI2_walkK_min1_density K hK hj
  · have hflag : decide ((2 : Fin 4) ∈ K) = true :=
      decide_eq_true (show (2 : Fin 4) ∈ K from hjK)
    rw [hflag]
    exact HardDiskB5.L1.TOPI2_walkK_min2_density K hK hj
  · have hflag : decide ((3 : Fin 4) ∈ K) = true :=
      decide_eq_true (show (3 : Fin 4) ∈ K from hjK)
    rw [hflag]
    exact HardDiskB5.L1.TOPI2_walkK_min3_density K hK hj
