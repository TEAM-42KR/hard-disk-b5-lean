private theorem HardDiskB5.GapMoment.integral_pi_one (f : (Fin 1 → ℝ) → ℝ) :
    (∫ r, f r ∂Measure.pi (fun _ : Fin 1 => HardDiskB5.GapMoment.Sector.base)) =
