    (∫ r, HardDiskB5.GapMoment.Sector.chamber r ∂HardDiskB5.GapMoment.Sector.base4) =
      ∫ t0 in (0 : ℝ)..(2 * Real.pi / 3),
      ∫ t1 in t0..(2 * Real.pi / 3),
      ∫ t2 in t1..(2 * Real.pi / 3),
      ∫ t3 in t2..(2 * Real.pi / 3), HardDiskB5.GapMoment.Sector.F ![t0, t1, t2, t3] := by
  rw [HardDiskB5.GapMoment.cubeFour HardDiskB5.GapMoment.Sector.chamber
    HardDiskB5.GapMoment.Sector.measurable_chamber HardDiskB5.GapMoment.Sector.chamber_bound]
  simp_rw [HardDiskB5.GapMoment.Sector.chamber, HardDiskB5.GapMoment.strictMono_four]
  let a : ℝ := 2 * Real.pi / 3
  have ha : 0 ≤ a := by dsimp [a]; positivity
  apply intervalIntegral.integral_congr
  intro t0 ht0
  have ht0' : 0 ≤ t0 ∧ t0 ≤ a := by
    change t0 ∈ Set.uIcc 0 a at ht0
    simpa only [Set.uIcc_of_le ha, Set.mem_Icc] using ht0
  calc
    _ = ∫ t1 in (0 : ℝ)..a, if t0 < t1 then
        (∫ t2 in t1..a, ∫ t3 in t2..a,
          HardDiskB5.GapMoment.Sector.F ![t0, t1, t2, t3]) else 0 := by
      apply intervalIntegral.integral_congr
      intro t1 ht1
      have ht1' : 0 ≤ t1 ∧ t1 ≤ a := by
        change t1 ∈ Set.uIcc 0 a at ht1
        simpa only [Set.uIcc_of_le ha, Set.mem_Icc] using ht1
      by_cases h01 : t0 < t1
      · simp only [if_pos h01]
        calc
          _ = ∫ t2 in (0 : ℝ)..a, if t1 < t2 then
              (∫ t3 in t2..a, HardDiskB5.GapMoment.Sector.F ![t0, t1, t2, t3]) else 0 := by
            apply intervalIntegral.integral_congr
            intro t2 ht2
            have ht2' : 0 ≤ t2 ∧ t2 ≤ a := by
              change t2 ∈ Set.uIcc 0 a at ht2
              simpa only [Set.uIcc_of_le ha, Set.mem_Icc] using ht2
            by_cases h12 : t1 < t2
            · simp only [h01, h12, true_and, if_true]
              exact HardDiskB5.GapMoment.selected_interval a t2 ht2'.1 ht2'.2 _
            · simp [h01, h12]
          _ = _ := HardDiskB5.GapMoment.selected_interval a t1 ht1'.1 ht1'.2 _
      · simp [h01]
    _ = _ := HardDiskB5.GapMoment.selected_interval a t0 ht0'.1 ht0'.2 _


