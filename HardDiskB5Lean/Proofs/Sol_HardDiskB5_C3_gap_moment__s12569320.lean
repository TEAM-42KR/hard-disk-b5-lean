private theorem HardDiskB5.GapMoment.integral_pi_succ {n : ℕ}
    (f : (Fin (n + 1) → ℝ) → ℝ) (hf : Measurable f)
    (hb : ∀ r, ‖f r‖ ≤ 15) :
    (∫ r, f r ∂Measure.pi (fun _ : Fin (n+1) => HardDiskB5.GapMoment.Sector.base)) =
