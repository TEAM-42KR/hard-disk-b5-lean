  rw [restrict_Ico_eq_restrict_Ioc, intervalIntegral.integral_of_le (by positivity)]

private theorem HardDiskB5.GapMoment.cubeFour (f : (Fin 4 → ℝ) → ℝ)
    (hf : Measurable f) (hb : ∀ r, ‖f r‖ ≤ 15) :
    (∫ r, f r ∂HardDiskB5.GapMoment.Sector.base4) =
      ∫ t0 in (0 : ℝ)..(2 * Real.pi / 3),
      ∫ t1 in (0 : ℝ)..(2 * Real.pi / 3),
      ∫ t2 in (0 : ℝ)..(2 * Real.pi / 3),
      ∫ t3 in (0 : ℝ)..(2 * Real.pi / 3), f ![t0, t1, t2, t3] := by
  have h : (∫ r, f r ∂HardDiskB5.GapMoment.Sector.base4) =
      ∫ t0, ∫ t1, ∫ t2, ∫ t3, f ![t0, t1, t2, t3]
        ∂HardDiskB5.GapMoment.Sector.base ∂HardDiskB5.GapMoment.Sector.base
        ∂HardDiskB5.GapMoment.Sector.base ∂HardDiskB5.GapMoment.Sector.base := by
    rw [HardDiskB5.GapMoment.Sector.base4,
      HardDiskB5.GapMoment.integral_pi_succ f hf hb]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun t0 => by
      dsimp only
      rw [HardDiskB5.GapMoment.integral_pi_succ
        (fun r : Fin 3 → ℝ => f (Fin.cons t0 r))
        (hf.comp (HardDiskB5.GapMoment.measurable_cons t0)) (fun r => hb _)]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall (fun t1 => by
        dsimp only
        rw [HardDiskB5.GapMoment.integral_pi_succ
          (fun r : Fin 2 → ℝ => f (Fin.cons t0 (Fin.cons t1 r)))
          ((hf.comp (HardDiskB5.GapMoment.measurable_cons t0)).comp
            (HardDiskB5.GapMoment.measurable_cons t1)) (fun r => hb _)]
        apply integral_congr_ae
        exact Filter.Eventually.of_forall (fun t2 => by
          dsimp only
          rw [HardDiskB5.GapMoment.integral_pi_one
            (fun r : Fin 1 → ℝ => f (Fin.cons t0 (Fin.cons t1 (Fin.cons t2 r))))]
          apply integral_congr_ae
          exact Filter.Eventually.of_forall (fun t3 => by
            apply congrArg f
            funext i
            fin_cases i <;> rfl))))
  rw [h]
  simp_rw [HardDiskB5.GapMoment.integral_base]


private theorem HardDiskB5.GapMoment.strictMono_four (t0 t1 t2 t3 : ℝ) :
    StrictMono ![t0, t1, t2, t3] ↔ t0 < t1 ∧ t1 < t2 ∧ t2 < t3 := by
  constructor
  · intro h
    exact ⟨h (by decide : (0 : Fin 4) < 1),
      h (by decide : (1 : Fin 4) < 2), h (by decide : (2 : Fin 4) < 3)⟩
  · rintro ⟨h01, h12, h23⟩
    apply Fin.strictMono_iff_lt_succ.mpr
    intro i
    fin_cases i
    · exact h01
    · exact h12
    · exact h23

private theorem HardDiskB5.GapMoment.selected_interval (a c : ℝ)
    (hc0 : 0 ≤ c) (hca : c ≤ a) (f : ℝ → ℝ) :
    (∫ t in (0 : ℝ)..a, if c < t then f t else 0) = ∫ t in c..a, f t := by
  rw [intervalIntegral.integral_of_le (hc0.trans hca), intervalIntegral.integral_of_le hca]
  change (∫ t in Set.Ioc 0 a, (Set.Ioi c).indicator f t) = _
  rw [integral_indicator measurableSet_Ioi, Measure.restrict_restrict measurableSet_Ioi]
  have heq : Set.Ioi c ∩ Set.Ioc 0 a = Set.Ioc c a := by
    ext t
    simp only [Set.mem_inter_iff, Set.mem_Ioi, Set.mem_Ioc]
    constructor
    · rintro ⟨hct, _, hta⟩
      exact ⟨hct, hta⟩
    · rintro ⟨hct, hta⟩
      exact ⟨hct, lt_of_le_of_lt hc0 hct, hta⟩
  rw [heq]

