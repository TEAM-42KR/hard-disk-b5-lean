  have he := measurePreserving_piFinSuccAbove
    (fun _ : Fin (n+1) => HardDiskB5.GapMoment.Sector.base) 0
  have hfe : Integrable (fun z : ℝ × (Fin n → ℝ) => f (e.symm z))
      (HardDiskB5.GapMoment.Sector.base.prod
        (Measure.pi (fun _ : Fin n => HardDiskB5.GapMoment.Sector.base))) := by
    apply (integrable_const (15 : ℝ)).mono'
    · exact (hf.comp e.symm.measurable).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun z => hb (e.symm z))
