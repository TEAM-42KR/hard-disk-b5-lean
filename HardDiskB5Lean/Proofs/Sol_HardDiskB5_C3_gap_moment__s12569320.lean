  have h02 : HardDiskB5.GapMoment.Sector.s0 ≠ HardDiskB5.GapMoment.Sector.s2 := by decide
  have h12 : HardDiskB5.GapMoment.Sector.s1 ≠ HardDiskB5.GapMoment.Sector.s2 := by decide
