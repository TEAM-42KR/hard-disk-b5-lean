        mul_ite, mul_zero, g]
    _ = ∫⁻ s in Set.Ioi (0 : ℝ), ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi, g (s, θ) :=
      setLIntegral_prod g hg.aemeasurable
    _ = ∫⁻ s in Set.Ioi (0 : ℝ), if s < 1 then
        ENNReal.ofReal s * F s * ENNReal.ofReal (Theta r s) else 0 := by
      apply lintegral_congr
      intro s
      by_cases hs : s < 1
      · simp only [g, hs, true_and, if_true]
        exact theta_lintegral_mul r s (ENNReal.ofReal s * F s)
      · simp only [g, hs, false_and, if_false, lintegral_zero]
    _ = _ := lintegral_Ioi_cutoff _

private lemma radial_lintegral (F : ℝ → ℝ≥0∞) (hF : Measurable F) :
    (∫⁻ x : Pt, F ‖x‖) =
      ENNReal.ofReal (2 * Real.pi) * ∫⁻ r in Set.Ioi (0 : ℝ), ENNReal.ofReal r * F r := by
  rw [lintegral_polarPt]
  have hg : Measurable (fun p : ℝ × ℝ => ENNReal.ofReal p.1 * F p.1) :=
    measurable_fst.ennreal_ofReal.mul (hF.comp measurable_fst)
  calc
    _ = ∫⁻ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
        ENNReal.ofReal p.1 * F p.1 := by
      apply setLIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo)
      intro p hp
      change ENNReal.ofReal p.1 * F ‖polarPt p‖ = ENNReal.ofReal p.1 * F p.1
      rw [norm_polarPt, abs_of_pos (show 0 < p.1 from hp.1)]
    _ = ∫⁻ r in Set.Ioi (0 : ℝ), ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi,
        ENNReal.ofReal r * F r := setLIntegral_prod _ hg.aemeasurable
    _ = ∫⁻ r in Set.Ioi (0 : ℝ), (ENNReal.ofReal r * F r) * ENNReal.ofReal (2 * Real.pi) := by
      apply lintegral_congr
      intro r
      simp only [lintegral_const, Measure.restrict_apply_univ, Real.volume_Ioo]
      rw [show Real.pi - -Real.pi = 2 * Real.pi by ring]
    _ = _ := by
      rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top, mul_comm]

open scoped Classical in
private lemma radial_disk_lintegral (F : ℝ → ℝ≥0∞) (hF : Measurable F) :
    (∫⁻ x : Pt, if ‖x‖ < 1 then F ‖x‖ else 0) =
      ENNReal.ofReal (2 * Real.pi) * ∫⁻ r in Set.Ioo (0 : ℝ) 1,
        ENNReal.ofReal r * F r := by
  rw [radial_lintegral _ (Measurable.ite measurableSet_Iio hF measurable_const)]
  congr 1
  simpa only [mul_ite, mul_zero] using
    (lintegral_Ioi_cutoff (fun r => ENNReal.ofReal r * F r))

private noncomputable def Ar (r : ℝ) : ℝ≥0∞ := ENNReal.ofReal (lensArea r)

private lemma measurable_Ar : Measurable Ar := by
  have h : Continuous lensArea := by unfold lensArea; fun_prop
  exact h.measurable.ennreal_ofReal

open scoped Classical in
private noncomputable def innerRad (r : ℝ) : ℝ≥0∞ :=
  ∫⁻ y : Pt, if ‖y‖ < 1 ∧ dist (r • e1) y < 1 then Ar ‖y‖ else 0

open scoped Classical in
private lemma measurable_innerRad : Measurable innerRad := by
  let g : ℝ × Pt → ℝ≥0∞ := fun p =>
    if ‖p.2‖ < 1 ∧ dist (p.1 • e1) p.2 < 1 then Ar ‖p.2‖ else 0
  have hg : Measurable g := by
    apply Measurable.ite ?_ (measurable_Ar.comp (by fun_prop)) measurable_const
    measurability
  exact hg.lintegral_prod_right

private lemma innerRad_polar (r : ℝ) :
    innerRad r = ∫⁻ s in Set.Ioo (0 : ℝ) 1,
      ENNReal.ofReal s * Ar s * ENNReal.ofReal (Theta r s) := by
  exact inner_polar Ar measurable_Ar r

open scoped Classical in
private lemma g7_radial :
    G7 = (ENNReal.ofReal (2 * Real.pi) * ∫⁻ r in Set.Ioo (0 : ℝ) 1,
      ENNReal.ofReal r * (Ar r * innerRad r)).toReal := by
  rw [g7_planar]
  have hi (x : Pt) :
      (∫⁻ y : Pt, if ‖x‖ < 1 ∧ ‖y‖ < 1 ∧ dist x y < 1 then
        ENNReal.ofReal (lensArea ‖x‖) * ENNReal.ofReal (lensArea ‖y‖) else 0) =
      if ‖x‖ < 1 then Ar ‖x‖ * innerRad ‖x‖ else 0 := by
    by_cases hx : ‖x‖ < 1
    · simp only [hx, true_and, if_true]
      calc
        _ = Ar ‖x‖ * ∫⁻ y : Pt, if ‖y‖ < 1 ∧ dist x y < 1 then Ar ‖y‖ else 0 := by
          rw [← lintegral_const_mul' _ _ (show Ar ‖x‖ ≠ ∞ from ENNReal.ofReal_ne_top)]
          apply lintegral_congr
          intro y
          simp only [mul_ite, mul_zero, Ar]
        _ = Ar ‖x‖ * innerRad ‖x‖ := by
          rw [inner_lintegral_radial Ar x]
          rfl
    · simp only [hx, false_and, if_false, lintegral_zero]
  simp_rw [hi]
  apply congrArg ENNReal.toReal
  exact radial_disk_lintegral (fun r => Ar r * innerRad r)
    (measurable_Ar.mul measurable_innerRad)

private lemma theta_nonneg (r s : ℝ) : 0 ≤ Theta r s := ENNReal.toReal_nonneg

open scoped Classical in
private lemma measurable_theta_enn :
    Measurable (fun p : ℝ × ℝ => ENNReal.ofReal (Theta p.1 p.2)) := by
  let g : (ℝ × ℝ) × ℝ → ℝ≥0∞ := fun q =>
    if q.1.1 ^ 2 + q.1.2 ^ 2 - 2 * q.1.1 * q.1.2 * Real.cos q.2 < 1 then 1 else 0
  have hg : Measurable g := by
    apply Measurable.ite ?_ measurable_const measurable_const
    measurability
  have hi : Measurable (fun p : ℝ × ℝ =>
      ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi, g (p, θ)) := hg.lintegral_prod_right
  convert hi using 1
  ext p
  exact (theta_lintegral p.1 p.2).symm

private lemma measurable_theta : Measurable (fun p : ℝ × ℝ => Theta p.1 p.2) := by
  have h := measurable_theta_enn.ennreal_toReal
  convert h using 1
  ext p
  exact (ENNReal.toReal_ofReal (theta_nonneg p.1 p.2)).symm

private lemma lensArea_nonneg' (r : ℝ) (hr0 : 0 ≤ r) (hr2 : r ≤ 2) : 0 ≤ lensArea r := by
  rw [← HardDiskB5.LensAreaFormula r hr0 hr2]
  exact ENNReal.toReal_nonneg

private lemma Imeasure11_lintegral :
    Imeasure (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) =
      ∫⁻ r in Set.Ioo (0 : ℝ) 1, ∫⁻ s in Set.Ioo (0 : ℝ) 1,
        ENNReal.ofReal (2 * Real.pi * lensArea r * lensArea s * r * s * Theta r s) := by
  let R : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1
  let S : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) 2 ×ˢ Set.Icc (0 : ℝ) 2
  let d : ℝ × ℝ → ℝ≥0∞ := fun p => ENNReal.ofReal
    (2 * Real.pi * lensArea p.1 * lensArea p.2 * p.1 * p.2 * Theta p.1 p.2)
  have hR : MeasurableSet R := measurableSet_Icc.prod measurableSet_Icc
  have hRS : R ∩ S = R := by
    apply Set.inter_eq_left.mpr
    intro p hp
    exact ⟨⟨hp.1.1, by linarith [hp.1.2]⟩, ⟨hp.2.1, by linarith [hp.2.2]⟩⟩
  have hd : Measurable d := by
    have ht := measurable_theta
    unfold d lensArea
    fun_prop
  have he : (volume : Measure ℝ).restrict (Set.Icc (0 : ℝ) 1) =
      volume.restrict (Set.Ioo (0 : ℝ) 1) := restrict_Ioo_eq_restrict_Icc.symm
  change ((volume.restrict S).withDensity d) R = _
  rw [withDensity_apply d hR, Measure.restrict_restrict hR, hRS]
  calc
    _ = ∫⁻ r in Set.Icc (0 : ℝ) 1, ∫⁻ s in Set.Icc (0 : ℝ) 1, d (r, s) :=
      setLIntegral_prod d hd.aemeasurable
    _ = _ := by rw [he]

private lemma Imeasure11_radial :
    Imeasure (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) =
      ENNReal.ofReal (2 * Real.pi) * ∫⁻ r in Set.Ioo (0 : ℝ) 1,
        ENNReal.ofReal r * (Ar r * innerRad r) := by
  rw [Imeasure11_lintegral]
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  apply setLIntegral_congr_fun measurableSet_Ioo
  intro r hr
  dsimp only
  rw [innerRad_polar]
  rw [← lintegral_const_mul' (Ar r) _ (show Ar r ≠ ∞ from ENNReal.ofReal_ne_top)]
  rw [← lintegral_const_mul' (ENNReal.ofReal r) _ ENNReal.ofReal_ne_top]
  rw [← lintegral_const_mul' (ENNReal.ofReal (2 * Real.pi)) _ ENNReal.ofReal_ne_top]
  apply setLIntegral_congr_fun measurableSet_Ioo
  intro s hs
  dsimp only
  have hr0 : 0 ≤ r := le_of_lt hr.1
  have hs0 : 0 ≤ s := le_of_lt hs.1
  have hAr : 0 ≤ lensArea r := lensArea_nonneg' r hr0 (by linarith [hr.2])
  have hAs : 0 ≤ lensArea s := lensArea_nonneg' s hs0 (by linarith [hs.2])
  rw [ENNReal.ofReal_mul' (theta_nonneg r s), ENNReal.ofReal_mul' hs0,
    ENNReal.ofReal_mul' hr0, ENNReal.ofReal_mul' hAs, ENNReal.ofReal_mul' hAr]
  unfold Ar
  ac_rfl

theorem solution_s12568720 :
    G7 = Ival (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) := by
  rw [g7_radial, Ival, Imeasure11_radial]
