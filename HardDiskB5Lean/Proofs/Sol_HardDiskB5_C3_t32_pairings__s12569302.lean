  have hp := HardDiskB5.C3.hankel_parseval f (farPart C1.a) 0 hm T32.meas_far_a hb
    (T32.radial_integrable hi) (T32.radial_integrable T32.weight_far_a) hIR
  have hInt : (∫ k in Set.Ioi (0 : ℝ),
