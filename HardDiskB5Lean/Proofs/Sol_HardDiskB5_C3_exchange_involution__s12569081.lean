  have hSae : (HDB5EI.trans a) ⁻¹' S =ᵐ[μ] S := by
    filter_upwards [hu] with x hx
    change (HDB5EI.res d (HDB5EI.trans a x) ∈ disk 0) = (HDB5EI.res d x ∈ disk 0)
    simp only [disk, Metric.mem_ball, dist_zero_right,
      HDB5EI.res_trans_norm d a had x hx]
  have hpr : MeasurePreserving (HDB5EI.trans a) (μ.restrict S) (μ.restrict S) := by
    have hh := hp.restrict_preimage hS
    rw [Measure.restrict_congr_set hSae] at hh
    exact hh
  have hEL : (HDB5EI.trans a) ⁻¹' ((HDB5EI.q d) ⁻¹' R) =ᵐ[μ]
      (HDB5EI.q d) ⁻¹' L := by
    filter_upwards [hu] with x hx
    apply propext
    change (HDB5EI.q d (HDB5EI.trans a x) ∈ R) ↔ (HDB5EI.q d x ∈ L)
    rw [HDB5EI.q_trans d a had x hx]
    exact HDB5EI.point_exchange (HDB5EI.q d x) i j a l hij hia hil hja hjl hal
      (by rw [HDB5EI.q_other d x a had]; exact hx) (HDB5EI.q_sum d x)
  have hwalk : walkK K = Measure.map (HDB5EI.q d) (μ.restrict S) := by
    rw [walkK, dif_pos hK]
    rfl
  change walkK K L = walkK K R
  rw [hwalk, Measure.map_apply (HDB5EI.q_meas d) hL,
    Measure.map_apply (HDB5EI.q_meas d) hR]
  calc
    _ = (μ.restrict S) ((HDB5EI.trans a) ⁻¹' ((HDB5EI.q d) ⁻¹' R)) :=
      measure_congr (ae_restrict_of_ae hEL.symm)
    _ = _ := hpr.measure_preimage ((hR.preimage (HDB5EI.q_meas d)).nullMeasurableSet)
