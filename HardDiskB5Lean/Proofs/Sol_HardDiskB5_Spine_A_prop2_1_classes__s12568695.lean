private def HDB5MGk.P1 (m : ℕ) : Prop := HDB5MGk.bicutB m = true ↔ ∃ k : Fin 10, m ∈ HDB5MGk.orbitL k

instance (m : ℕ) : Decidable (HDB5MGk.P1 m) := by unfold HDB5MGk.P1; infer_instance

private theorem HDB5MGk.comp1L0 : ∀ i < 256, HDB5MGk.P1 (i + 0) := by
  decide +kernel

private theorem HDB5MGk.comp1L1 : ∀ i < 256, HDB5MGk.P1 (i + 256) := by
  decide +kernel

private theorem HDB5MGk.comp1L2 : ∀ i < 256, HDB5MGk.P1 (i + 512) := by
  decide +kernel

private theorem HDB5MGk.comp1L3 : ∀ i < 256, HDB5MGk.P1 (i + 768) := by
  decide +kernel

private theorem HDB5MGk.comp1L : ∀ m < 1024, HDB5MGk.bicutB m = true ↔ ∃ k : Fin 10, m ∈ HDB5MGk.orbitL k := by
  intro m hm
  show HDB5MGk.P1 m
  rcases (by omega : m < 256 ∨ (256 ≤ m ∧ m < 512) ∨ (512 ≤ m ∧ m < 768) ∨ (768 ≤ m ∧ m < 1024)) with
    h | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
  · simpa using HDB5MGk.comp1L0 m h
  · simpa [Nat.sub_add_cancel h1] using HDB5MGk.comp1L1 (m - 256) (by omega)
  · simpa [Nat.sub_add_cancel h1] using HDB5MGk.comp1L2 (m - 512) (by omega)
  · simpa [Nat.sub_add_cancel h1] using HDB5MGk.comp1L3 (m - 768) (by omega)

private theorem HDB5MGk.comp1 : ∀ m < 1024, HDB5MGk.bicutB m = true ↔ ∃ k : Fin 10, m ∈ HDB5MGk.orbit k := by
  intro m hm; simp only [HDB5MGk.mem_orbit]; exact HDB5MGk.comp1L m hm

private theorem HDB5MGk.comp2L : ∀ k l : Fin 10, HDB5MGk.rmask k ∈ HDB5MGk.orbitL l → k = l := by
  decide +kernel

private theorem HDB5MGk.comp2 : ∀ k l : Fin 10, HDB5MGk.rmask k ∈ HDB5MGk.orbit l → k = l := by
  intro k l h; exact HDB5MGk.comp2L k l ((HDB5MGk.mem_orbit l _).mp h)

private theorem HDB5MGk.comp3L : ∀ k : Fin 10, ((Finset.range 1024).filter (fun m => m ∈ HDB5MGk.orbitL k)).card =
