private theorem HDB5MGk.comp3 : ∀ k : Fin 10, ((Finset.range 1024).filter (fun m => m ∈ HDB5MGk.orbit k)).card =
    ![12, 10, 60, 10, 60, 30, 30, 15, 10, 1] k := by
  intro k; simp only [HDB5MGk.mem_orbit]; exact HDB5MGk.comp3L k

