      (disk 0).indicator (fun _ => (1 : ℝ)) (y - w)) :=
    ((measurable_const.indicator (show MeasurableSet (disk 0) from measurableSet_ball)).comp
      (measurable_const.sub measurable_id)).stronglyMeasurable
  rw [arcMeasure, integral_map hc.measurable.aemeasurable hf.aestronglyMeasurable]
  rcases ConvDisk.polar y hy with ⟨φ, hφ⟩
  have hr : 0 < ‖y‖ := norm_pos_iff.mpr hy
  have he : (fun t : ℝ => (disk 0).indicator (fun _ => (1 : ℝ)) (y - circPt t)) =
