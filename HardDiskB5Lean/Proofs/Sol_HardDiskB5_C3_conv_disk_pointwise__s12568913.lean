private theorem ConvDisk.lens_radial (y : Pt) :
    volume (disk 0 ∩ disk y) = volume (disk 0 ∩ disk (‖y‖ • e1)) := by
  let R : Pt ≃ₗᵢ[ℝ] Pt := Submodule.reflection (ℝ ∙ (‖y‖ • e1 - y))ᗮ
  have hn : ‖(‖y‖ • e1 : Pt)‖ = ‖y‖ := by
    simp [norm_smul, e1, EuclideanSpace.norm_single]
  have hR : R (‖y‖ • e1) = y := Submodule.reflection_sub hn
  have hs : R ⁻¹' (disk 0 ∩ disk y) = disk 0 ∩ disk (‖y‖ • e1) := by
    ext w
    simp only [Set.mem_preimage, Set.mem_inter_iff, disk, Metric.mem_ball]
    have hd0 : dist (R w) 0 = dist w 0 := by simpa using R.dist_map w 0
    have hdy : dist (R w) y = dist w (‖y‖ • e1) := by
      calc
        dist (R w) y = dist (R w) (R (‖y‖ • e1)) := congrArg (dist (R w)) hR.symm
        _ = dist w (‖y‖ • e1) := R.dist_map _ _
    rw [hd0, hdy]
  rw [← hs]
  exact (R.measurePreserving.measure_preimage
    ((measurableSet_ball.inter measurableSet_ball).nullMeasurableSet)).symm

