        lintegral_congr_ae (Filter.Eventually.of_forall he)
      _ = _ := by
        rw [lintegral_const_mul' _ _ (by finiteness), angular_difference_integral]
  · simp only [radialHouseIntegrand, polarPt_norm r θ hr, h, and_false,
      if_false, mul_zero, lintegral_zero]

private lemma polar_inner (r θ : ℝ) (hr : 0 ≤ r) :
    (∫⁻ y : Pt, radialHouseIntegrand (polarPt (r,θ), y)) =
      ∫⁻ s in Set.Ioi (0 : ℝ), if r < 1 then
        ENNReal.ofReal s * ENNReal.ofReal (lensArea r) * ENNReal.ofReal (lensArea s) *
          ENNReal.ofReal (Theta r s) else 0 := by
  have hf : Measurable (fun y : Pt => radialHouseIntegrand (polarPt (r,θ), y)) :=
    radialHouse_measurable.comp (measurable_const.prodMk measurable_id)
  rw [lintegral_polarPt (fun y : Pt => radialHouseIntegrand (polarPt (r,θ), y)) hf]
  apply lintegral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with s hs
  exact polar_inner_angular r s θ hr (le_of_lt hs)

private lemma radial_to_polar :
    (∫⁻ p : Pt × Pt, radialHouseIntegrand p) =
      ∫⁻ r in Set.Ioi (0 : ℝ), ∫⁻ s in Set.Ioi (0 : ℝ),
        if r < 1 then housePolarDensity r s else 0 := by
  classical
  change (∫⁻ p : Pt × Pt, radialHouseIntegrand p ∂(volume : Measure Pt).prod volume) = _
  rw [lintegral_prod _ radialHouse_measurable.aemeasurable,
    lintegral_polarPt _ radialHouse_measurable.lintegral_prod_right']
  apply lintegral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with r hr
  have hinner (θ : ℝ) := polar_inner r θ (le_of_lt hr)
  calc
    _ = ∫⁻ θ in Set.Ioo (-Real.pi) Real.pi,
        ENNReal.ofReal r * (∫⁻ s in Set.Ioi (0 : ℝ), if r < 1 then
          ENNReal.ofReal s * ENNReal.ofReal (lensArea r) * ENNReal.ofReal (lensArea s) *
            ENNReal.ofReal (Theta r s) else 0) :=
      lintegral_congr_ae (Filter.Eventually.of_forall fun θ => congrArg (ENNReal.ofReal r * ·) (hinner θ))
    _ = ENNReal.ofReal (2 * Real.pi) * ENNReal.ofReal r *
        (∫⁻ s in Set.Ioi (0 : ℝ), if r < 1 then
          ENNReal.ofReal s * ENNReal.ofReal (lensArea r) * ENNReal.ofReal (lensArea s) *
            ENNReal.ofReal (Theta r s) else 0) := by
      have hJ : volume (Set.Ioo (-Real.pi) Real.pi) = ENNReal.ofReal (2 * Real.pi) := by
        rw [Real.volume_Ioo]
        congr 1
        ring
      simp only [lintegral_const, Measure.restrict_apply_univ, hJ]
      ac_rfl
    _ = _ := by
      rw [← lintegral_const_mul' _ _ (by finiteness)]
      apply lintegral_congr
      intro s
      by_cases h : r < 1 <;> simp [h, housePolarDensity, mul_assoc]

private lemma lensArea_zero_of_two_le (s : ℝ) (hs : 2 ≤ s) : lensArea s = 0 := by
  unfold lensArea
  rw [Real.arccos_of_one_le (by linarith : 1 ≤ s / 2),
    Real.sqrt_eq_zero_of_nonpos (by nlinarith : 4 - s ^ 2 ≤ 0)]
  ring

private lemma polarDensity_zero (r s : ℝ) (hs : 2 ≤ s) : housePolarDensity r s = 0 := by
  simp [housePolarDensity, lensArea_zero_of_two_le s hs]

private lemma inner_radius_bound (r : ℝ) :
    (∫⁻ s in Set.Ioi (0 : ℝ), housePolarDensity r s) =
      ∫⁻ s in Set.Icc (0 : ℝ) 2, housePolarDensity r s := by
  classical
  have hfun : housePolarDensity r = (Set.Iio (2 : ℝ)).indicator (housePolarDensity r) := by
    funext s
    by_cases hs : s < 2
    · simp [Set.indicator, hs]
    · simp [Set.indicator, hs, polarDensity_zero r s (le_of_not_gt hs)]
  calc
    _ = ∫⁻ s in Set.Ioi (0 : ℝ),
        (Set.Iio (2 : ℝ)).indicator (housePolarDensity r) s := by
      conv_lhs => arg 2; rw [hfun]
    _ = ∫⁻ s in Set.Ioo (0 : ℝ) 2, housePolarDensity r s := by
      rw [setLIntegral_indicator measurableSet_Iio]
      have he : Set.Iio (2 : ℝ) ∩ Set.Ioi (0 : ℝ) = Set.Ioo (0 : ℝ) 2 := by
        ext s
        simp [and_comm]
      rw [he]
    _ = _ := by rw [restrict_Ioo_eq_restrict_Icc]

private lemma polar_radius_bounds :
    (∫⁻ r in Set.Ioi (0 : ℝ), ∫⁻ s in Set.Ioi (0 : ℝ),
      if r < 1 then housePolarDensity r s else 0) =
        ∫⁻ r in Set.Icc (0 : ℝ) 1, ∫⁻ s in Set.Icc (0 : ℝ) 2, housePolarDensity r s := by
  classical
  calc
    _ = ∫⁻ r in Set.Ioi (0 : ℝ), if r < 1 then
        ∫⁻ s in Set.Ioi (0 : ℝ), housePolarDensity r s else 0 := by
      apply lintegral_congr
      intro r
      by_cases h : r < 1 <;> simp [h]
    _ = ∫⁻ r in Set.Ioo (0 : ℝ) 1,
        ∫⁻ s in Set.Ioi (0 : ℝ), housePolarDensity r s := by
      change (∫⁻ r in Set.Ioi (0 : ℝ), (Set.Iio (1 : ℝ)).indicator
        (fun r => ∫⁻ s in Set.Ioi (0 : ℝ), housePolarDensity r s) r) = _
      rw [setLIntegral_indicator measurableSet_Iio]
      have he : Set.Iio (1 : ℝ) ∩ Set.Ioi (0 : ℝ) = Set.Ioo (0 : ℝ) 1 := by
        ext r
        simp [and_comm]
      rw [he]
    _ = ∫⁻ r in Set.Icc (0 : ℝ) 1,
        ∫⁻ s in Set.Ioi (0 : ℝ), housePolarDensity r s := by
      rw [restrict_Ioo_eq_restrict_Icc]
    _ = _ := lintegral_congr (fun r => inner_radius_bound r)

private lemma thetaENN_measurable :
    Measurable (fun p : ℝ × ℝ => ENNReal.ofReal (Theta p.1 p.2)) := by
  have hc : Continuous (fun a : AddCircle (2 * Real.pi) => Real.Angle.cos a) :=
    Real.Angle.continuous_cos
  have hf : Continuous (fun q : (ℝ × ℝ) × AddCircle (2 * Real.pi) =>
      q.1.1 ^ 2 + q.1.2 ^ 2 - 2 * q.1.1 * q.1.2 * Real.Angle.cos q.2) :=
    ((continuous_fst.fst.pow 2).add (continuous_fst.snd.pow 2)).sub
      (((continuous_const.mul continuous_fst.fst).mul continuous_fst.snd).mul
        (hc.comp continuous_snd))
  have hk : Measurable (fun q : (ℝ × ℝ) × AddCircle (2 * Real.pi) =>
      angularKernel q.1.1 q.1.2 q.2) :=
    Measurable.ite (isOpen_lt hf continuous_const).measurableSet
      measurable_const measurable_const
  have he : (fun p : ℝ × ℝ => ENNReal.ofReal (Theta p.1 p.2)) =
      (fun p : ℝ × ℝ => ∫⁻ a : AddCircle (2 * Real.pi), angularKernel p.1 p.2 a) :=
    funext (fun p => theta_lintegral p.1 p.2)
  rw [he]
  exact hk.lintegral_prod_right'

private lemma polarDensity_measurable :
    Measurable (fun p : ℝ × ℝ => housePolarDensity p.1 p.2) := by
  exact (((((measurable_const.mul
    (ENNReal.measurable_ofReal.comp measurable_fst)).mul
    (ENNReal.measurable_ofReal.comp measurable_snd)).mul
    (ENNReal.measurable_ofReal.comp (lensArea_continuous.measurable.comp measurable_fst))).mul
    (ENNReal.measurable_ofReal.comp (lensArea_continuous.measurable.comp measurable_snd))).mul
    thetaENN_measurable)

private lemma lensArea_nonneg_on (s : ℝ) (hs0 : 0 ≤ s) (hs2 : s ≤ 2) : 0 ≤ lensArea s := by
  rw [← HardDiskB5.LensAreaFormula s hs0 hs2]
  exact ENNReal.toReal_nonneg

private lemma polarDensity_eq (r s : ℝ) (hr : r ∈ Set.Icc (0 : ℝ) 1)
    (hs : s ∈ Set.Icc (0 : ℝ) 2) :
    housePolarDensity r s =
      ENNReal.ofReal (2 * Real.pi * lensArea r * lensArea s * r * s * Theta r s) := by
  have har : 0 ≤ lensArea r := lensArea_nonneg_on r hr.1 (by linarith [hr.2])
  have has : 0 ≤ lensArea s := lensArea_nonneg_on s hs.1 hs.2
  have htheta : 0 ≤ Theta r s := ENNReal.toReal_nonneg
  have hr0 : 0 ≤ r := hr.1
  have hs0 : 0 ≤ s := hs.1
  unfold housePolarDensity
  rw [ENNReal.ofReal_mul (by positivity : 0 ≤ 2 * Real.pi * lensArea r * lensArea s * r * s),
    ENNReal.ofReal_mul (by positivity : 0 ≤ 2 * Real.pi * lensArea r * lensArea s * r),
    ENNReal.ofReal_mul (by positivity : 0 ≤ 2 * Real.pi * lensArea r * lensArea s),
    ENNReal.ofReal_mul (by positivity : 0 ≤ 2 * Real.pi * lensArea r),
    ENNReal.ofReal_mul (by positivity : 0 ≤ 2 * Real.pi)]
  ac_rfl

private lemma Ival_box1 :
    Ival (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2) =
      (∫⁻ p in Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2,
        ENNReal.ofReal (2 * Real.pi * lensArea p.1 * lensArea p.2 * p.1 * p.2 * Theta p.1 p.2)).toReal := by
  have hbox : MeasurableSet (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2) :=
    measurableSet_Icc.prod measurableSet_Icc
  have hsub : (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2) ⊆
      (Set.Icc (0 : ℝ) 2 ×ˢ Set.Icc (0 : ℝ) 2) := by
    intro p hp
    exact ⟨⟨hp.1.1, by linarith [hp.1.2]⟩,hp.2⟩
  unfold Ival Imeasure
  rw [withDensity_apply _ hbox, Measure.restrict_restrict hbox, Set.inter_eq_left.mpr hsub]

private lemma polar_to_Ival :
    (∫⁻ r in Set.Icc (0 : ℝ) 1,
      ∫⁻ s in Set.Icc (0 : ℝ) 2, housePolarDensity r s).toReal =
        Ival (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2) := by
  rw [Ival_box1]
  congr 1
  have htonelli :
      (∫⁻ p in Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2, housePolarDensity p.1 p.2) =
        ∫⁻ r in Set.Icc (0 : ℝ) 1, ∫⁻ s in Set.Icc (0 : ℝ) 2, housePolarDensity r s := by
    change (∫⁻ p : ℝ × ℝ, housePolarDensity p.1 p.2
      ∂((volume : Measure ℝ).prod volume).restrict
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2)) = _
    rw [← Measure.prod_restrict]
    exact lintegral_prod _ polarDensity_measurable.aemeasurable
  rw [← htonelli]
  exact setLIntegral_congr_fun (measurableSet_Icc.prod measurableSet_Icc)
    (fun p hp => polarDensity_eq p.1 p.2 hp.1 hp.2)

theorem solution_s12568756 :
    H6 = Ival (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 2) := by
  rw [h6_radial, radial_to_polar, polar_radius_bounds]
  exact polar_to_Ival
