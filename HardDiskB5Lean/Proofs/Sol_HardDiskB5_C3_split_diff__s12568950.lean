theorem solution_s12568950 :
    ∀ (K : Finset (Fin 4)) (i j a l : Fin 4), i ≠ j → i ≠ a → i ≠ l → j ≠ a → j ≠ l → a ≠ l → a ∈ K →
      (walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x i + x j + x a‖ < 1}).toReal - (walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x l + x a‖ < 1}).toReal =
        2 * Real.pi * ∫ k in Set.Ioi (0 : ℝ), k * hankel (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) k * (if l ∈ K then H12 k else H01 k) := by
  intro K i j a l hij hia hil hja hjl hal ha
  rw [HardDiskB5.C3.split_first K i j a l hij hia hil hja hjl hal ha,
    HardDiskB5.C3.split_second K i j a l hij hia hil hja hjl hal ha]
  rw [← mul_sub, ← integral_sub
    (SD.first_int (decide (i ∈ K)) (decide (j ∈ K)) (decide (l ∈ K)))
    (SD.second_int (decide (i ∈ K)) (decide (j ∈ K)) (decide (l ∈ K)))]
  congr 1
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with k hk
  change 0 < k at hk
  have hk0 : k ≠ 0 := ne_of_gt hk
  rw [SD.hankel_split false (decide (l ∈ K)) k,
    SD.hankel_split true (decide (l ∈ K)) k]
  let F := hankel (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) k
  by_cases hl : l ∈ K
  · simp only [hl, decide_true, ↓reduceIte]
    change J1 k * F * (hankel C1.b k - H1 k) -
      k * J0 k * F * (hankel C1.c k - H2 k) = k * F * H12 k
    rw [HardDiskB5.C3.full_transforms.2.1 k hk0,
      HardDiskB5.C3.full_transforms.2.2 k hk0]
    unfold H12
    field_simp
    <;> ring
  · simp only [hl, decide_false, ↓reduceIte]
    change J1 k * F * (hankel C1.a k - H0 k) -
      k * J0 k * F * (hankel C1.b k - H1 k) = k * F * H01 k
    rw [HardDiskB5.C3.full_transforms.1,
      HardDiskB5.C3.full_transforms.2.1 k hk0]
    unfold H01
    field_simp
    <;> ring

