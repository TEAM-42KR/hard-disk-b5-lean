      (fun k : ℝ => k ^ (-(3 / 2 : ℝ))) := by
  exact ((SS.O_full_true s).sub (SS.O_far_true s)).congr_left (fun k => (SS.hankel_split s k).symm)
private lemma SS.O_far (s t : Bool) :
    Asymptotics.IsBigO Filter.atTop (hankel (farPart (pairDensity s t)))
      (fun k : ℝ => k ^ (-(1 / 2 : ℝ))) := by
  cases s <;> cases t
  · exact HardDiskB5.C3.H_decay.1
  · exact HardDiskB5.C3.H_decay.2.1.trans (SS.O_weaken (by norm_num))
  · exact HardDiskB5.C3.H_decay.2.1.trans (SS.O_weaken (by norm_num))
  · exact HardDiskB5.C3.H_decay.2.2.1.trans (SS.O_weaken (by norm_num))
private lemma SS.spectral_O (s t u : Bool) :
    Asymptotics.IsBigO Filter.atTop
      (fun k => k * J0 k * hankel (farPart (pairDensity s t)) k *
        hankel (nearPart (pairDensity true u)) k)
      (fun k : ℝ => k ^ (-(3 / 2 : ℝ))) := by
  have hid : Asymptotics.IsBigO Filter.atTop (fun k : ℝ => k) (fun k : ℝ => k ^ (1 : ℝ)) := by
    apply Asymptotics.IsBigO.of_bound 1
    exact Filter.Eventually.of_forall (fun k => by simp)
  convert SS.O_mul (SS.O_mul (SS.O_mul hid SS.O_J.1) (SS.O_far s t)) (SS.O_near_true u) using 1 <;> norm_num
private lemma SS.spectral_integrable (s t u : Bool) :
    IntegrableOn (fun k => k * J0 k * hankel (farPart (pairDensity s t)) k *
      hankel (nearPart (pairDensity true u)) k) (Set.Ioi (0 : ℝ)) := by
  have hc : Continuous (fun k => k * J0 k * hankel (farPart (pairDensity s t)) k *
      hankel (nearPart (pairDensity true u)) k) :=
    ((continuous_id.mul HardDiskB5.C3.bessel_basic.2.2.2.1).mul
      (SS.hankel_cont (SS.weight_far_pair s t))).mul
      (SS.hankel_cont (SS.weight_near (SS.weight_true u)).integrableOn)
  have hr : IntegrableAtFilter (fun k : ℝ => k ^ (-(3 / 2 : ℝ))) Filter.atTop volume :=
    ⟨Set.Ioi 1, Filter.Ioi_mem_atTop 1, integrableOn_Ioi_rpow_of_lt (by norm_num) (by norm_num)⟩
  exact ((hc.locallyIntegrable.locallyIntegrableOn (Set.Ici 0)).integrableOn_of_isBigO_atTop
    (SS.spectral_O s t u) hr).mono_set Set.Ioi_subset_Ici_self

theorem solution_s12568954 :
    ∀ (K : Finset (Fin 4)) (i j a l : Fin 4), i ≠ j → i ≠ a → i ≠ l → j ≠ a → j ≠ l → a ≠ l → a ∈ K →
      (walkK K {x : Fin 4 → Pt | 1 < ‖x i + x j‖ ∧ ‖x l + x a‖ < 1}).toReal =
        2 * Real.pi * ∫ k in Set.Ioi (0 : ℝ), k * J0 k * hankel (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) k * hankel (nearPart (pairDensity true (decide (l ∈ K)))) k := by
  intro K i j a l hij hia hil hja hjl hal haK
  rw [SS.walk_mass_conv K i j a l hij hia hil hja hjl hal haK]
  have he1 : ‖e1‖ = 1 := by simp [e1]
  have hb : ∃ C : ℝ, ∀ r : ℝ, |nearPart (pairDensity true (decide (l ∈ K))) r| ≤ C := by
    refine ⟨2 * Real.pi, ?_⟩
    intro r
    unfold nearPart
    split_ifs
    · exact SS.true_bound _ r
    · simp only [abs_zero]
      positivity
  have hs : IntegrableOn
      (fun k : ℝ => k * J0 (k * ‖e1‖) * hankel (nearPart (pairDensity true (decide (l ∈ K)))) k *
        hankel (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) k) (Set.Ioi (0 : ℝ)) := by
    have ht := SS.spectral_integrable (decide (i ∈ K)) (decide (j ∈ K)) (decide (l ∈ K))
    apply ht.congr_fun _ measurableSet_Ioi
    intro k hk
    simp only [he1, mul_one]
    ring
  have hp := HardDiskB5.C3.hankel_parseval
    (nearPart (pairDensity true (decide (l ∈ K))))
    (farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K)))) e1
    (SS.meas_near (SS.meas_pair _ _)) (SS.meas_far (SS.meas_pair _ _)) hb
    (SS.radial_integrable (SS.weight_near (SS.weight_true _)).integrableOn)
    (SS.radial_integrable (SS.weight_far_pair _ _)) hs
  calc
    _ = ∫ z : Pt, nearPart (pairDensity true (decide (l ∈ K))) ‖z‖ *
        farPart (pairDensity (decide (i ∈ K)) (decide (j ∈ K))) ‖e1 - z‖ := by
      rw [← integral_sub_left_eq_self _ (volume : Measure Pt) e1]
      apply integral_congr_ae
      apply Filter.Eventually.of_forall
      intro z
      simp only [sub_sub_self]
      ring
    _ = _ := by
      rw [hp]
      congr 1
      apply setIntegral_congr_fun measurableSet_Ioi
      intro k hk
      simp only [he1, mul_one]
      ring
