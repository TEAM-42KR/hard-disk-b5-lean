      ∫ y in S, lensArea ‖y‖ * lensArea (dist y e1) := by
  have hp : MeasurableSet {x : Fin 4 → Pt | x 0 + x 1 ∈ S} := hS.preimage (by fun_prop)
  have h := HardDiskB5.L1.TopII.pair_lintegral (S.indicator (fun _ => 1)) (measurable_const.indicator hS)
  have he : (fun x : Fin 4 → Pt => S.indicator (fun _ => (1 : ENNReal)) (x 0 + x 1)) =
      {x : Fin 4 → Pt | x 0 + x 1 ∈ S}.indicator (fun _ => (1 : ENNReal)) := by
    funext x
    simp only [Set.indicator, Set.mem_setOf_eq]
  rw [he, lintegral_indicator hp, lintegral_const, one_mul, Measure.restrict_apply_univ] at h
  have hi : (∫⁻ y : Pt, S.indicator (fun _ => (1 : ENNReal)) y * ENNReal.ofReal (lensArea ‖y‖) *
        ENNReal.ofReal (lensArea (dist y e1))) =
      ∫⁻ y in S, ENNReal.ofReal (lensArea ‖y‖ * lensArea (dist y e1)) := by
    rw [← lintegral_indicator hS]
    apply lintegral_congr
    intro y
    by_cases hy : y ∈ S
    · simp [Set.indicator, hy, ENNReal.ofReal_mul (show 0 ≤ lensArea ‖y‖ by
        simpa only [dist_zero_left] using HardDiskB5.L1.TopII.lens_nonneg 0 y)]
    · simp [Set.indicator, hy]
  rw [hi] at h
  rw [h]
  symm
  apply integral_eq_lintegral_of_nonneg_ae
  · exact Filter.Eventually.of_forall (fun y => mul_nonneg
      (by simpa only [dist_zero_left] using HardDiskB5.L1.TopII.lens_nonneg 0 y)
      (HardDiskB5.L1.TopII.lens_nonneg y e1))
  · exact HardDiskB5.L1.TopII.integrable.aestronglyMeasurable.restrict

private lemma HardDiskB5.L1.TopII.walk4_closed :
    ∀ᵐ x ∂walkMeasure 4, x 0 + x 1 + x 2 + x 3 = e1 := by
  have hc : Continuous (fun x : Fin 4 → Pt => Function.update x 0 (e1 - x 1 - x 2 - x 3)) := by
    apply continuous_pi
    intro i
    by_cases hi : i = 0
    · subst i; simp only [Function.update_self]; fun_prop
    · simp only [Function.update_of_ne hi]; fun_prop
  rw [HardDiskB5.L1.TopII.walk4_map]
  apply (ae_map_iff hc.measurable.aemeasurable (isClosed_eq (by fun_prop) continuous_const).measurableSet).mpr
  apply Filter.Eventually.of_forall
  intro x
  simp only [Function.update_self, Function.update_of_ne (by decide : (1 : Fin 4) ≠ 0),
    Function.update_of_ne (by decide : (2 : Fin 4) ≠ 0),
    Function.update_of_ne (by decide : (3 : Fin 4) ≠ 0)]
  abel

private lemma HardDiskB5.L1.TopII.farfar_mass :
    (walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsFar x 2 3}).toReal = kappa22 := by
  have he : walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsFar x 2 3} =
      walkMeasure 4 {x : Fin 4 → Pt | x 0 + x 1 ∈ {y : Pt | 1 < ‖y‖ ∧ 1 < dist y e1}} := by
    apply measure_congr
    filter_upwards [HardDiskB5.L1.TopII.walk4_closed] with x hx
    have hc : x 2 + x 3 = e1 - (x 0 + x 1) := by rw [← hx]; abel
    change (1 < ‖x 0 + x 1‖ ∧ 1 < ‖x 2 + x 3‖) =
      (1 < ‖x 0 + x 1‖ ∧ 1 < dist (x 0 + x 1) e1)
    rw [hc]
    simp only [dist_eq_norm, norm_sub_rev]
  rw [he]
  exact HardDiskB5.L1.TopII.pair_mass _ ((isOpen_lt continuous_const continuous_norm).measurableSet.inter
    (isOpen_lt continuous_const (continuous_id.dist continuous_const)).measurableSet)

private lemma HardDiskB5.L1.TopII.Y4_identity :
    ladderY 4 = 3 * kappa22 - (kappa11 + 2 * kappa12 + kappa22) := by
  letI := HardDiskB5.L1.TopII.walk4_finite
  rw [HardDiskB5.L1.TopII.ladderY_formula, HardDiskB5.L1.TopII.farfar_mass]
  congr 1
  have h := HardDiskB5.L1.TopII.pair_mass Set.univ MeasurableSet.univ
  simp only [Set.mem_univ, Set.setOf_true, Measure.restrict_univ] at h
  exact h.trans HardDiskB5.L1.TopII.kappa_partition


private lemma HardDiskB5.L1.TopII.disk_reflect_integral (d : Pt) (H : Pt → ENNReal) :
    (∫⁻ c in disk 0, H c) = ∫⁻ y : Pt, if d - y ∈ disk 0 then H (d - y) else 0 := by
  rw [← lintegral_indicator (show MeasurableSet (disk (0 : Pt)) from measurableSet_ball)]
  simpa only [Set.indicator] using
    (lintegral_sub_left_eq_self (μ := (volume : Measure Pt)) ((disk 0).indicator H) d).symm

private lemma HardDiskB5.L1.TopII.lensN_enn (y : Pt) :
    volume (lensAt 1 ∩ disk y) = ENNReal.ofReal (lensN 1 y) := by
  rw [lensN, ENNReal.ofReal_toReal]
  exact ((measure_mono (Set.inter_subset_left.trans Set.inter_subset_left)).trans_lt
    (measure_ball_lt_top (μ := (volume : Measure Pt)) (x := (0 : Pt)) (r := 1))).ne

private lemma HardDiskB5.L1.TopII.triple_kernel (y : Pt) :
    (∫⁻ b in disk 0,
      if ‖b - e1‖ < 1 ∧ e1 - b - y ∈ disk 0 then (1 : ENNReal) else 0) =
      ENNReal.ofReal (lensN 1 y) := by
  rw [HardDiskB5.L1.TopII.disk_reflect_integral e1]
  have he : (fun z : Pt => if e1 - z ∈ disk 0 then
      (if ‖e1 - z - e1‖ < 1 ∧ e1 - (e1 - z) - y ∈ disk 0 then (1 : ENNReal) else 0) else 0) =
      (lensAt 1 ∩ disk y).indicator (fun _ => (1 : ENNReal)) := by
    funext z
    have hn : ‖e1 - z - e1‖ = ‖z‖ := by simp
    have hd : e1 - (e1 - z) - y = z - y := by abel
    simp only [hn, hd, Set.indicator, Set.mem_inter_iff, lensAt, one_smul,
      disk, Metric.mem_ball, dist_zero_right, dist_eq_norm, sub_zero]
    rw [norm_sub_rev e1 z]
    by_cases ha : ‖z - e1‖ < 1 <;> by_cases hb : ‖z‖ < 1 <;>
      by_cases hc : ‖z - y‖ < 1 <;> simp [ha, hb, hc]
  rw [he, lintegral_indicator, lintegral_const, one_mul, Measure.restrict_apply_univ]
  · exact HardDiskB5.L1.TopII.lensN_enn y
  · exact (measurableSet_ball.inter measurableSet_ball).inter measurableSet_ball

private lemma HardDiskB5.L1.TopII.lensN_measurable : Measurable (lensN 1) := by
  have hm : Measurable (fun p : Pt × Pt =>
      (lensAt 1 ∩ disk p.1).indicator (fun _ => (1 : ENNReal)) p.2) := by
    simp only [Set.indicator]
    apply Measurable.ite
    · simp only [lensAt, one_smul, Set.mem_inter_iff, disk, Metric.mem_ball]
      exact ((isOpen_lt (show Continuous (fun p : Pt × Pt => dist p.2 0) by fun_prop) continuous_const).inter
        (isOpen_lt (show Continuous (fun p : Pt × Pt => dist p.2 e1) by fun_prop) continuous_const) |>.inter
        (isOpen_lt (show Continuous (fun p : Pt × Pt => dist p.2 p.1) by fun_prop) continuous_const)).measurableSet
    · exact measurable_const
    · exact measurable_const
  have he : (fun y : Pt => ∫⁻ z : Pt,
      (lensAt 1 ∩ disk y).indicator (fun _ => (1 : ENNReal)) z) =
      fun y : Pt => volume (lensAt 1 ∩ disk y) := by
    funext y
    rw [lintegral_indicator, lintegral_const, one_mul, Measure.restrict_apply_univ]
    exact (measurableSet_ball.inter measurableSet_ball).inter measurableSet_ball
  have hr := Measurable.lintegral_prod_right (ν := (volume : Measure Pt))
    (f := fun y z : Pt => (lensAt 1 ∩ disk y).indicator (fun _ => (1 : ENNReal)) z) hm
  rw [he] at hr
  change Measurable (fun y : Pt => (volume (lensAt 1 ∩ disk y)).toReal)
  exact hr.ennreal_toReal


private lemma HardDiskB5.L1.TopII.triple_kernel_weighted (y : Pt) (t : ENNReal) :
    (∫⁻ b in disk 0, if ‖b - e1‖ < 1 ∧ e1 - b - y ∈ disk 0 then t else 0) =
      t * ENNReal.ofReal (lensN 1 y) := by
  have he : (fun b : Pt => if ‖b - e1‖ < 1 ∧ e1 - b - y ∈ disk 0 then t else 0) =
      fun b => t * (if ‖b - e1‖ < 1 ∧ e1 - b - y ∈ disk 0 then (1 : ENNReal) else 0) := by
    funext b
    split_ifs <;> simp
  rw [he, lintegral_const_mul, HardDiskB5.L1.TopII.triple_kernel]
  apply Measurable.ite
  · change MeasurableSet {b : Pt | ‖b - e1‖ < 1 ∧ dist (e1 - b - y) 0 < 1}
    exact ((isOpen_lt (show Continuous (fun b : Pt => ‖b - e1‖) by fun_prop) continuous_const).inter
      (isOpen_lt (show Continuous (fun b : Pt => dist (e1 - b - y) 0) by fun_prop) continuous_const)).measurableSet
  · exact measurable_const
  · exact measurable_const

private lemma HardDiskB5.L1.TopII.psi_mass_enn :
    walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsNear x 2 4} =
      ∫⁻ y in {y : Pt | 1 < ‖y‖}, ENNReal.ofReal (lensArea ‖y‖ * lensN 1 y) := by
  letI := HardDiskB5.L1.TopII.disk_finite (0 : Pt)
  let S : Set (Fin 4 → Pt) := {x | IsFar x 0 1 ∧ IsNear x 2 4}
  have hS : MeasurableSet S := by
    change MeasurableSet {x : Fin 4 → Pt | 1 < ‖x 0 + x 1‖ ∧ ‖x 2 + -e1‖ < 1}
    exact ((isOpen_lt continuous_const (show Continuous (fun x : Fin 4 → Pt => ‖x 0 + x 1‖) by fun_prop)).inter
      (isOpen_lt (show Continuous (fun x : Fin 4 → Pt => ‖x 2 + -e1‖) by fun_prop) continuous_const)).measurableSet
  have h := HardDiskB5.L1.TopII.walk4_disintegration (S.indicator (fun _ => 1))
    (measurable_const.indicator hS)
  rw [lintegral_indicator hS, lintegral_const, one_mul, Measure.restrict_apply_univ] at h
  change walkMeasure 4 S = _ at h
  rw [h]
  have hsum (a b c : Pt) : e1 - a - b - c + a = e1 - b - c := by abel
  have hsub (a b c : Pt) : e1 - a - b - c = (e1 - b - c) - a := by abel
  have hev (a b c : Pt) : S.indicator (fun _ => (1 : ENNReal))
      ![e1 - a - b - c, a, b, c] =
      if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0 := by
    simp only [Set.indicator]
    apply if_congr ?_ rfl rfl
    change (1 < ‖e1 - a - b - c + a‖ ∧ ‖b + -e1‖ < 1) ↔
      (1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1)
    rw [hsum]
    simp only [sub_eq_add_neg]
  simp_rw [hev]
  have hg : Measurable (fun x : (Pt × Pt) × Pt =>
      if e1 - x.1.1 - x.1.2 - x.2 ∈ disk 0 then
        (if 1 < ‖e1 - x.1.2 - x.2‖ ∧ ‖x.1.2 - e1‖ < 1 then (1 : ENNReal) else 0) else 0) := by
    apply Measurable.ite
    · change MeasurableSet {x : (Pt × Pt) × Pt | dist (e1 - x.1.1 - x.1.2 - x.2) 0 < 1}
      exact (isOpen_lt (by fun_prop) continuous_const).measurableSet
    · apply Measurable.ite
      · exact ((isOpen_lt continuous_const (show Continuous (fun x : (Pt × Pt) × Pt => ‖e1 - x.1.2 - x.2‖) by fun_prop)).inter
          (isOpen_lt (show Continuous (fun x : (Pt × Pt) × Pt => ‖x.1.2 - e1‖) by fun_prop) continuous_const)).measurableSet
      · exact measurable_const
      · exact measurable_const
    · exact measurable_const
  change (∫⁻ a in disk 0, ∫⁻ b in disk 0, ∫⁻ c in disk 0,
    if e1 - a - b - c ∈ disk 0 then
      (if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0) else 0) = _
  rw [HardDiskB5.L1.TopII.lintegral_rotate _ _ hg]
  have hk (b c : Pt) : (∫⁻ a in disk 0, if e1 - a - b - c ∈ disk 0 then
      (if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0) else 0) =
      (if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0) *
        ENNReal.ofReal (lensArea ‖e1 - b - c‖) := by
    convert HardDiskB5.L1.TopII.disk_kernel_weighted (e1 - b - c)
      (if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0) using 1
    apply lintegral_congr
    intro a
    apply if_congr ?_ rfl rfl
    rw [hsub]
  simp_rw [hk]
  have hr (b : Pt) : (∫⁻ c in disk 0,
      (if 1 < ‖e1 - b - c‖ ∧ ‖b - e1‖ < 1 then (1 : ENNReal) else 0) *
        ENNReal.ofReal (lensArea ‖e1 - b - c‖)) =
      ∫⁻ y : Pt, if ‖b - e1‖ < 1 ∧ e1 - b - y ∈ disk 0 then
        (if 1 < ‖y‖ then ENNReal.ofReal (lensArea ‖y‖) else 0) else 0 := by
    rw [HardDiskB5.L1.TopII.disk_reflect_integral (e1 - b)]
    apply lintegral_congr
    intro y
    have hy : e1 - b - (e1 - b - y) = y := by abel
    simp only [hy]
    by_cases hd : e1 - b - y ∈ disk 0 <;> by_cases hn : ‖b - e1‖ < 1 <;>
      by_cases hf : 1 < ‖y‖ <;> simp [hd, hn, hf]
  simp_rw [hr]
  rw [lintegral_lintegral_swap]
  · simp_rw [HardDiskB5.L1.TopII.triple_kernel_weighted]
    rw [← lintegral_indicator (isOpen_lt continuous_const continuous_norm).measurableSet]
    apply lintegral_congr
    intro y
    by_cases hy : 1 < ‖y‖
    · simp [Set.indicator, hy, ENNReal.ofReal_mul (show 0 ≤ lensArea ‖y‖ by
        simpa only [dist_zero_left] using HardDiskB5.L1.TopII.lens_nonneg 0 y)]
    · simp [Set.indicator, hy]
  · apply Measurable.aemeasurable
    apply Measurable.ite
    · change MeasurableSet {p : Pt × Pt | ‖p.1 - e1‖ < 1 ∧ dist (e1 - p.1 - p.2) 0 < 1}
      exact ((isOpen_lt (show Continuous (fun p : Pt × Pt => ‖p.1 - e1‖) by fun_prop) continuous_const).inter
        (isOpen_lt (show Continuous (fun p : Pt × Pt => dist (e1 - p.1 - p.2) 0) by fun_prop) continuous_const)).measurableSet
    · apply Measurable.ite
      · exact (isOpen_lt continuous_const (continuous_snd.norm)).measurableSet
      · apply ENNReal.measurable_ofReal.comp
        unfold lensArea
        fun_prop
      · exact measurable_const
    · exact measurable_const

private lemma HardDiskB5.L1.TopII.psi_mass :
    (walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsNear x 2 4}).toReal = psiOut := by
  rw [HardDiskB5.L1.TopII.psi_mass_enn]
  symm
  unfold psiOut
  apply integral_eq_lintegral_of_nonneg_ae
  · exact Filter.Eventually.of_forall (fun y => mul_nonneg
      (by simpa only [dist_zero_left] using HardDiskB5.L1.TopII.lens_nonneg 0 y)
      ENNReal.toReal_nonneg)
  · apply Measurable.aestronglyMeasurable
    apply Measurable.mul
    · unfold lensArea; fun_prop
    · exact HardDiskB5.L1.TopII.lensN_measurable


private lemma HardDiskB5.L1.TopII.farnear_mass :
    (walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsNear x 2 3}).toReal = kappa12 := by
  have he : walkMeasure 4 {x : Fin 4 → Pt | IsFar x 0 1 ∧ IsNear x 2 3} =
      walkMeasure 4 {x : Fin 4 → Pt | x 0 + x 1 ∈ {y : Pt | 1 < ‖y‖ ∧ dist y e1 < 1}} := by
    apply measure_congr
    filter_upwards [HardDiskB5.L1.TopII.walk4_closed] with x hx
    have hc : x 2 + x 3 = e1 - (x 0 + x 1) := by rw [← hx]; abel
    change (1 < ‖x 0 + x 1‖ ∧ ‖x 2 + x 3‖ < 1) =
      (1 < ‖x 0 + x 1‖ ∧ dist (x 0 + x 1) e1 < 1)
    rw [hc]
    simp only [dist_eq_norm, norm_sub_rev]
  rw [he]
  have h := HardDiskB5.L1.TopII.pair_mass {y : Pt | 1 < ‖y‖ ∧ dist y e1 < 1}
    ((isOpen_lt continuous_const continuous_norm).measurableSet.inter
    (isOpen_lt (continuous_id.dist continuous_const) continuous_const).measurableSet)
  exact h.trans HardDiskB5.L1.TopII.kappa21_eq

theorem solution_s12568830 :
    ladderY 4 = 3 * kappa22 - (kappa11 + 2 * kappa12 + kappa22) ∧ ladderYt 4 = psiOut - kappa12 := by
  refine ⟨HardDiskB5.L1.TopII.Y4_identity, ?_⟩
  unfold ladderYt
  rw [HardDiskB5.L1.TopII.psi_mass, HardDiskB5.L1.TopII.farnear_mass]
