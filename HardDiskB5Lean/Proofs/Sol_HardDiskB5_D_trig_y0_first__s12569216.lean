private theorem HardDiskB5.D.trig_y0_first.pull (d : ℝ) :
    Dpull DGpart1 0 d =
    -(DarcXi 0 d 0 * DImTab DGt0 (Dshift (DarcU 0 d) 0) + DarcXi 0 d 4 * DImTab DGt1 (Dshift (DarcU 0 d) 4) + DarcXi 0 d 3 * DImTab DGt2 (Dshift (DarcU 0 d) 3) + DarcXi 0 d 2 * DImTab DGt3 (Dshift (DarcU 0 d) 2)) +
    (DarcXi 0 d 4 * DImTab DGt0 (Dshift (DarcU 0 d) 4) + DarcXi 0 d 3 * DImTab DGt1 (Dshift (DarcU 0 d) 3) + DarcXi 0 d 2 * DImTab DGt2 (Dshift (DarcU 0 d) 2) + DarcXi 0 d 1 * DImTab DGt3 (Dshift (DarcU 0 d) 1)) := by
  unfold Dpull
  rw [Fin.sum_univ_succ, Fin.sum_univ_four]
  norm_num [DarcB, DarcXb, Fin.val_succ]
  unfold DGpart1 DG1coef
  simp only [Fin.sum_univ_four]
  have hi00 : (0 : Fin 5) - Fin.castSucc (0 : Fin 4) = (0 : Fin 5) := by decide
  have hi01 : (0 : Fin 5) - Fin.castSucc (1 : Fin 4) = (4 : Fin 5) := by decide
  have hi02 : (0 : Fin 5) - Fin.castSucc (2 : Fin 4) = (3 : Fin 5) := by decide
  have hi03 : (0 : Fin 5) - Fin.castSucc (3 : Fin 4) = (2 : Fin 5) := by decide
  have hi40 : (Fin.succ (3 : Fin 4)) - Fin.castSucc (0 : Fin 4) = (4 : Fin 5) := by decide
  have hi41 : (Fin.succ (3 : Fin 4)) - Fin.castSucc (1 : Fin 4) = (3 : Fin 5) := by decide
  have hi42 : (Fin.succ (3 : Fin 4)) - Fin.castSucc (2 : Fin 4) = (2 : Fin 5) := by decide
  have hi43 : (Fin.succ (3 : Fin 4)) - Fin.castSucc (3 : Fin 4) = (1 : Fin 5) := by decide
  simp only [hi00, hi01, hi02, hi03, hi40, hi41, hi42, hi43, DGt]
  ring

