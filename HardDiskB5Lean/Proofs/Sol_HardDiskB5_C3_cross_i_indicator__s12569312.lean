    simp only [PiLp.add_apply, he0, HardDiskB5.CrossI.capEnd_zero]
    linarith
  obtain ⟨b, hb⟩ := HardDiskB5.CrossI.cap_replace (e1 + HardDiskB5.CrossI.capEnd a + z) y hy hy0 hb0
  have hc0 : (e1 + HardDiskB5.CrossI.capEnd a + HardDiskB5.CrossI.capEnd b) 0 ≤ 0 := by
    simp only [PiLp.add_apply, he0, HardDiskB5.CrossI.capEnd_zero]
    norm_num
  obtain ⟨c, hc⟩ := HardDiskB5.CrossI.cap_replace
    (e1 + HardDiskB5.CrossI.capEnd a + HardDiskB5.CrossI.capEnd b) z hz hz0 hc0
  have hend : 1 ≤ ‖e1 + HardDiskB5.CrossI.capEnd a + HardDiskB5.CrossI.capEnd b +
      HardDiskB5.CrossI.capEnd c‖ ^ 2 := by
    have hs : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
    cases a <;> cases b <;> cases c <;>
      simp [HardDiskB5.CrossI.norm_sq, HardDiskB5.CrossI.capEnd, e1, e2] <;> nlinarith
  have ha' : ‖e1 + HardDiskB5.CrossI.capEnd a + y + z‖ ^ 2 ≤ ‖e1 + x + y + z‖ ^ 2 := by
    simpa only [add_comm, add_left_comm, add_assoc] using ha
  have hb' : ‖e1 + HardDiskB5.CrossI.capEnd a + HardDiskB5.CrossI.capEnd b + z‖ ^ 2 ≤
      ‖e1 + HardDiskB5.CrossI.capEnd a + y + z‖ ^ 2 := by
    simpa only [add_comm, add_left_comm, add_assoc] using hb
  nlinarith [norm_nonneg (e1 + x + y + z)]

private theorem HardDiskB5.CrossI.unit_angle (z : Pt) (hz : ‖z‖ = 1) :
    0 < angE z ∧ angE z ≤ 2 * Real.pi ∧
      Real.cos (angE z) = z 0 ∧ Real.sin (angE z) = z 1 := by
  let c : ℂ := ⟨z 0, z 1⟩
  have hc : ‖c‖ = 1 := by
    have hsq : ‖c‖ ^ 2 = ‖z‖ ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply, HardDiskB5.CrossI.norm_sq]
      dsimp [c]
      ring
    nlinarith [norm_nonneg c]
  have hc0 : c ≠ 0 := by intro h; simpa only [h, norm_zero, zero_ne_one] using hc
  have hcos : Real.cos c.arg = z 0 := by simpa only [c, hc, div_one] using Complex.cos_arg hc0
  have hsin : Real.sin c.arg = z 1 := by simpa only [c, hc, div_one] using Complex.sin_arg c
  have hlo := Complex.neg_pi_lt_arg c
  have hhi := Complex.arg_le_pi c
  change 0 < (if 0 < c.arg then c.arg else c.arg + 2 * Real.pi) ∧
    (if 0 < c.arg then c.arg else c.arg + 2 * Real.pi) ≤ 2 * Real.pi ∧
    Real.cos (if 0 < c.arg then c.arg else c.arg + 2 * Real.pi) = z 0 ∧
    Real.sin (if 0 < c.arg then c.arg else c.arg + 2 * Real.pi) = z 1
  by_cases hp : 0 < c.arg
  · simp only [if_pos hp]
    exact ⟨hp, by linarith [Real.pi_pos], hcos, hsin⟩
  · simp only [if_neg hp, Real.cos_add_two_pi, Real.sin_add_two_pi]
    exact ⟨by linarith [Real.pi_pos], by linarith, hcos, hsin⟩

private theorem HardDiskB5.CrossI.circPt_angle (z : Pt) (hz : ‖z‖ = 1) :
    circPt (angE z) = z := by
  obtain ⟨_, _, hc, hs⟩ := HardDiskB5.CrossI.unit_angle z hz
  ext i
  fin_cases i
  · exact (HardDiskB5.CrossI.circPt_zero _).trans hc
  · exact (HardDiskB5.CrossI.circPt_one _).trans hs

private theorem HardDiskB5.CrossI.angle_circPt (t : ℝ) (ht : 0 < t) (ht2 : t ≤ 2 * Real.pi) :
    angE (circPt t) = t := by
  have he : (⟨Real.cos t, Real.sin t⟩ : ℂ) = (Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I := by
    apply Complex.ext <;>
      simp only [Complex.add_re, Complex.add_im, Complex.ofReal_re, Complex.ofReal_im,
        Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im, zero_mul, mul_zero,
        sub_zero, add_zero, zero_add, mul_one]
  have ha : angE (circPt t) =
      if 0 < Complex.arg ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I)
      then Complex.arg ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I)
      else Complex.arg ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I) + 2 * Real.pi := by
    simp only [angE, HardDiskB5.CrossI.circPt_zero, HardDiskB5.CrossI.circPt_one, he]
  rw [ha]
  by_cases hπ : t ≤ Real.pi
  · have harg := Complex.arg_cos_add_sin_mul_I (θ := t) ⟨by linarith [Real.pi_pos], hπ⟩
    have harg' : Complex.arg ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I) = t := by
      simpa only [← Complex.ofReal_cos, ← Complex.ofReal_sin] using harg
    rw [harg', if_pos ht]
  · have harg : Complex.arg ((Real.cos t : ℂ) + (Real.sin t : ℂ) * Complex.I) = t - 2 * Real.pi := by
      have hh := Complex.arg_cos_add_sin_mul_I (θ := t - 2 * Real.pi)
        ⟨by linarith, by linarith [Real.pi_pos]⟩
      simpa only [← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_sub_two_pi, Real.sin_sub_two_pi] using hh
    rw [harg, if_neg (by linarith)]
    ring

private theorem HardDiskB5.CrossI.circPt_period (t : ℝ) : circPt (t + 2 * Real.pi) = circPt t := by
  simp only [circPt, Real.cos_add_two_pi, Real.sin_add_two_pi]

private theorem HardDiskB5.CrossI.ccw_circPt (a b : ℝ) :
    ccwAng (circPt a) (circPt b) = angE (circPt (b - a)) := by
  unfold ccwAng
  congr 1
  ext i
  fin_cases i <;>
    simp [circPt, e1, e2, Real.cos_sub, Real.sin_sub] <;> ring

private theorem HardDiskB5.CrossI.ccw_sorted (a : Fin 4 → ℝ) (ha : StrictMono a)
    (hlo : ∀ i, 0 < a i) (hhi : ∀ i, a i ≤ 2 * Real.pi)
    (i j : Fin 4) (hij : i ≠ j) :
    ccwAng (circPt (a i)) (circPt (a j)) =
      if i < j then a j - a i else a j - a i + 2 * Real.pi := by
  rw [HardDiskB5.CrossI.ccw_circPt]
  by_cases hlt : i < j
  · rw [if_pos hlt]
    exact HardDiskB5.CrossI.angle_circPt _ (sub_pos.mpr (ha hlt)) (by linarith [hlo i, hhi j])
  · rw [if_neg hlt, ← HardDiskB5.CrossI.circPt_period (a j - a i)]
    have hji : j < i := lt_of_le_of_ne (le_of_not_gt hlt) hij.symm
    exact HardDiskB5.CrossI.angle_circPt _ (by linarith [hlo j, hhi i]) (by linarith [ha hji])

private theorem HardDiskB5.CrossI.cos120 : Real.cos (2 * Real.pi / 3) = -1 / 2 := by
  rw [show 2 * Real.pi / 3 = Real.pi - Real.pi / 3 by ring,
    Real.cos_pi_sub, Real.cos_pi_div_three]
  ring

private theorem HardDiskB5.CrossI.cos_far_iff (t : ℝ) (ht : 0 ≤ t) (ht2 : t ≤ 2 * Real.pi) :
    -1 / 2 < Real.cos t ↔ t < 2 * Real.pi / 3 ∨ 4 * Real.pi / 3 < t := by
  have mono (s : ℝ) (hs : 0 ≤ s) (hsπ : s ≤ Real.pi) :
      -1 / 2 < Real.cos s ↔ s < 2 * Real.pi / 3 := by
    constructor
    · intro h
      by_contra hn
      have hh := Real.cos_le_cos_of_nonneg_of_le_pi (by positivity : 0 ≤ 2 * Real.pi / 3)
        hsπ (le_of_not_gt hn)
      rw [HardDiskB5.CrossI.cos120] at hh
      linarith
    · intro h
      have hh := Real.cos_lt_cos_of_nonneg_of_le_pi hs
        (by linarith [Real.pi_pos] : 2 * Real.pi / 3 ≤ Real.pi) h
      simpa only [HardDiskB5.CrossI.cos120] using hh
  by_cases hπ : t ≤ Real.pi
  · rw [mono t ht hπ]
    constructor
    · exact Or.inl
    · intro h
      rcases h with h | h
      · exact h
      · linarith [Real.pi_pos]
  · have hc : Real.cos (2 * Real.pi - t) = Real.cos t := by
      rw [show 2 * Real.pi - t = -t + 2 * Real.pi by ring,
        Real.cos_add_two_pi, Real.cos_neg]
    have hh := mono (2 * Real.pi - t) (by linarith) (by linarith)
    rw [hc] at hh
    rw [hh]
    constructor
    · intro h
      right
      linarith
    · intro h
      rcases h with h | h <;> linarith [Real.pi_pos]

private theorem HardDiskB5.CrossI.pair_norm_sq (a b : ℝ) :
    ‖circPt a + circPt b‖ ^ 2 = 2 + 2 * Real.cos (b - a) := by
  simp only [HardDiskB5.CrossI.norm_sq, PiLp.add_apply,
    HardDiskB5.CrossI.circPt_zero, HardDiskB5.CrossI.circPt_one, Real.cos_sub]
  nlinarith [Real.cos_sq_add_sin_sq a, Real.cos_sq_add_sin_sq b]

private theorem HardDiskB5.CrossI.pair_far_iff (a b : ℝ) (hab : a ≤ b)
    (hspan : b - a ≤ 2 * Real.pi) :
    1 < ‖circPt a + circPt b‖ ↔ b - a < 2 * Real.pi / 3 ∨ 4 * Real.pi / 3 < b - a := by
  have hs := HardDiskB5.CrossI.pair_norm_sq a b
  have hn := norm_nonneg (circPt a + circPt b)
  have hcos : (1 < ‖circPt a + circPt b‖) ↔ -1 / 2 < Real.cos (b - a) := by
    constructor <;> intro h <;> nlinarith
  exact hcos.trans (HardDiskB5.CrossI.cos_far_iff _ (sub_nonneg.mpr hab) hspan)

private noncomputable def HardDiskB5.CrossI.rotate (t : ℝ) (z : Pt) : Pt :=
  (Real.cos t * z 0 + Real.sin t * z 1) • e1 +
    (Real.cos t * z 1 - Real.sin t * z 0) • e2

private theorem HardDiskB5.CrossI.rotate_zero (t : ℝ) (z : Pt) :
    HardDiskB5.CrossI.rotate t z 0 = Real.cos t * z 0 + Real.sin t * z 1 := by
  simp [HardDiskB5.CrossI.rotate, e1, e2]

private theorem HardDiskB5.CrossI.rotate_one (t : ℝ) (z : Pt) :
    HardDiskB5.CrossI.rotate t z 1 = Real.cos t * z 1 - Real.sin t * z 0 := by
  simp [HardDiskB5.CrossI.rotate, e1, e2]

private theorem HardDiskB5.CrossI.rotate_add (t : ℝ) (z w : Pt) :
    HardDiskB5.CrossI.rotate t (z + w) = HardDiskB5.CrossI.rotate t z + HardDiskB5.CrossI.rotate t w := by
  ext i
  fin_cases i <;> simp [HardDiskB5.CrossI.rotate, e1, e2] <;> ring

private theorem HardDiskB5.CrossI.rotate_norm (t : ℝ) (z : Pt) :
    ‖HardDiskB5.CrossI.rotate t z‖ = ‖z‖ := by
  have hs : ‖HardDiskB5.CrossI.rotate t z‖ ^ 2 = ‖z‖ ^ 2 := by
    simp only [HardDiskB5.CrossI.norm_sq, HardDiskB5.CrossI.rotate_zero,
      HardDiskB5.CrossI.rotate_one]
    have htr := Real.cos_sq_add_sin_sq t
    nlinarith [congrArg (fun v : ℝ => v * (z 0) ^ 2) htr,
      congrArg (fun v : ℝ => v * (z 1) ^ 2) htr]
  nlinarith [norm_nonneg (HardDiskB5.CrossI.rotate t z), norm_nonneg z]

private theorem HardDiskB5.CrossI.rotate_circPt (t a : ℝ) :
    HardDiskB5.CrossI.rotate t (circPt a) = circPt (a - t) := by
  ext i
  fin_cases i <;> simp [HardDiskB5.CrossI.rotate, circPt, e1, e2, Real.cos_sub, Real.sin_sub] <;> ring

private theorem HardDiskB5.CrossI.norm_shift (a b c d t : ℝ) :
    ‖circPt a + circPt b + circPt c + circPt d‖ =
      ‖circPt (a - t) + circPt (b - t) + circPt (c - t) + circPt (d - t)‖ := by
  rw [← HardDiskB5.CrossI.rotate_norm t (circPt a + circPt b + circPt c + circPt d)]
  simp only [HardDiskB5.CrossI.rotate_add, HardDiskB5.CrossI.rotate_circPt]

private theorem HardDiskB5.CrossI.projection_bound (a b c d t : ℝ) :
    Real.cos (a - t) + Real.cos (b - t) + Real.cos (c - t) + Real.cos (d - t) ≤
      ‖circPt a + circPt b + circPt c + circPt d‖ := by
  let z := HardDiskB5.CrossI.rotate t (circPt a + circPt b + circPt c + circPt d)
  have hz : z 0 ≤ ‖z‖ := by
    have hh := HardDiskB5.CrossI.norm_sq z
    nlinarith [sq_nonneg (z 1), norm_nonneg z]
  have hnorm : ‖z‖ = ‖circPt a + circPt b + circPt c + circPt d‖ :=
    HardDiskB5.CrossI.rotate_norm _ _
  rw [hnorm] at hz
  simpa only [z, HardDiskB5.CrossI.rotate_add, PiLp.add_apply,
    HardDiskB5.CrossI.rotate_circPt, HardDiskB5.CrossI.circPt_zero] using hz

private theorem HardDiskB5.CrossI.pair_center (a b : ℝ) :
    circPt a + circPt b = (2 * Real.cos ((b - a) / 2)) • circPt ((a + b) / 2) := by
  let m := (a + b) / 2
  let h := (b - a) / 2
  have ha : a = m - h := by dsimp [m, h]; ring
  have hb : b = m + h := by dsimp [m, h]; ring
  change circPt a + circPt b = (2 * Real.cos h) • circPt m
  calc
    _ = circPt (m - h) + circPt (m + h) := by rw [← ha, ← hb]
    _ = _ := by
      ext i
      fin_cases i <;> simp [circPt, e1, e2, Real.cos_sub, Real.cos_add, Real.sin_sub, Real.sin_add] <;> ring

private theorem HardDiskB5.CrossI.weighted_pair_norm (r s a b : ℝ) :
    ‖r • circPt a + s • circPt b‖ ^ 2 = r ^ 2 + s ^ 2 + 2 * r * s * Real.cos (b - a) := by
  simp only [HardDiskB5.CrossI.norm_sq, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul,
    HardDiskB5.CrossI.circPt_zero, HardDiskB5.CrossI.circPt_one, Real.cos_sub]
  linear_combination r ^ 2 * (Real.cos_sq_add_sin_sq a) + s ^ 2 * (Real.cos_sq_add_sin_sq b)

private theorem HardDiskB5.CrossI.four_norm_sq (a b c d : ℝ) :
    ‖circPt a + circPt b + circPt c + circPt d‖ ^ 2 =
      4 * (Real.cos ((b - a) / 2) ^ 2 + Real.cos ((d - c) / 2) ^ 2 +
        2 * Real.cos ((b - a) / 2) * Real.cos ((d - c) / 2) *
          Real.cos ((c + d - a - b) / 2)) := by
  rw [show circPt a + circPt b + circPt c + circPt d =
    (circPt a + circPt b) + (circPt c + circPt d) by abel,
    HardDiskB5.CrossI.pair_center, HardDiskB5.CrossI.pair_center,
    HardDiskB5.CrossI.weighted_pair_norm]
  rw [show (c + d) / 2 - (a + b) / 2 = (c + d - a - b) / 2 by ring]
  ring

private theorem HardDiskB5.CrossI.boundary_factor (a b : ℝ) :
    4 * (Real.cos a ^ 2 + Real.cos b ^ 2 +
      2 * Real.cos a * Real.cos b * Real.cos (2 * Real.pi / 3 + a + b)) - 1 =
      -8 * Real.sin (Real.pi / 3 - a) * Real.sin (Real.pi / 3 - b) *
        Real.cos (2 * Real.pi / 3 - a - b) := by
  have hs120 : Real.sin (2 * Real.pi / 3) = Real.sqrt 3 / 2 := by
    rw [show 2 * Real.pi / 3 = Real.pi - Real.pi / 3 by ring,
      Real.sin_pi_sub, Real.sin_pi_div_three]
  have hs : Real.sqrt 3 ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  simp only [Real.cos_add, Real.cos_sub, Real.sin_add, Real.sin_sub,
    Real.cos_pi_div_three, Real.sin_pi_div_three, HardDiskB5.CrossI.cos120, hs120]
  linear_combination
    (Real.sqrt 3 * (Real.cos a) ^ 2 * Real.cos b * Real.sin b +
      Real.sqrt 3 * Real.cos a * (Real.cos b) ^ 2 * Real.sin a -
      (Real.cos a) ^ 2 * (Real.cos b) ^ 2 - (Real.cos a) ^ 2 * (Real.sin b) ^ 2 -
      Real.cos a * Real.cos b * Real.sin a * Real.sin b - (Real.cos b) ^ 2 * (Real.sin a) ^ 2) * hs +
    (-3 * (Real.cos b) ^ 2 + (Real.sin b) ^ 2) * (Real.cos_sq_add_sin_sq a) +
    (1 - 4 * (Real.cos a) ^ 2) * (Real.cos_sq_add_sin_sq b)

private theorem HardDiskB5.CrossI.centers_small_norm (a b θ : ℝ)
    (ha0 : 0 ≤ a) (ha1 : a < Real.pi / 3) (hb0 : 0 ≤ b) (hb1 : b < Real.pi / 3)
    (hlo : 4 * Real.pi / 3 - a - b < θ) (hhi : θ < 2 * Real.pi / 3 + a + b) :
    4 * (Real.cos a ^ 2 + Real.cos b ^ 2 + 2 * Real.cos a * Real.cos b * Real.cos θ) < 1 := by
  have hab : Real.pi / 3 < a + b := by linarith
  have hca : 0 < Real.cos a := by
    have hh := Real.cos_lt_cos_of_nonneg_of_le_pi ha0
      (by linarith [Real.pi_pos] : Real.pi / 3 ≤ Real.pi) ha1
    rw [Real.cos_pi_div_three] at hh
    linarith
  have hcb : 0 < Real.cos b := by
    have hh := Real.cos_lt_cos_of_nonneg_of_le_pi hb0
      (by linarith [Real.pi_pos] : Real.pi / 3 ≤ Real.pi) hb1
    rw [Real.cos_pi_div_three] at hh
    linarith
  have cos_reflect (t : ℝ) : Real.cos (2 * Real.pi - t) = Real.cos t := by
    rw [show 2 * Real.pi - t = -t + 2 * Real.pi by ring, Real.cos_add_two_pi, Real.cos_neg]
  have heq : Real.cos (4 * Real.pi / 3 - a - b) = Real.cos (2 * Real.pi / 3 + a + b) := by
    convert cos_reflect (2 * Real.pi / 3 + a + b) using 1 <;> congr 1 <;> ring
  have hcos : Real.cos θ < Real.cos (2 * Real.pi / 3 + a + b) := by
    by_cases hθ : θ ≤ Real.pi
    · have hh := Real.cos_lt_cos_of_nonneg_of_le_pi
        (by linarith [Real.pi_pos] : 0 ≤ 4 * Real.pi / 3 - a - b) hθ hlo
      rwa [heq] at hh
    · have hh := Real.cos_lt_cos_of_nonneg_of_le_pi
        (by linarith [Real.pi_pos] : 0 ≤ 4 * Real.pi / 3 - a - b)
        (by linarith : 2 * Real.pi - θ ≤ Real.pi)
        (by linarith : 4 * Real.pi / 3 - a - b < 2 * Real.pi - θ)
      rwa [heq, cos_reflect] at hh
  have hsa : 0 ≤ Real.sin (Real.pi / 3 - a) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith [Real.pi_pos])
  have hsb : 0 ≤ Real.sin (Real.pi / 3 - b) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith [Real.pi_pos])
  have hcc : 0 ≤ Real.cos (2 * Real.pi / 3 - a - b) := by
    have hh := Real.cos_lt_cos_of_nonneg_of_le_pi
      (by linarith : 0 ≤ 2 * Real.pi / 3 - a - b)
      (by linarith [Real.pi_pos] : Real.pi / 3 ≤ Real.pi)
      (by linarith : 2 * Real.pi / 3 - a - b < Real.pi / 3)
    rw [Real.cos_pi_div_three] at hh
    linarith
  have hp := mul_nonneg (mul_nonneg hsa hsb) hcc
  have hfac := HardDiskB5.CrossI.boundary_factor a b
  have hlt := mul_lt_mul_of_pos_left hcos (mul_pos (mul_pos (by norm_num : (0 : ℝ) < 8) hca) hcb)
  nlinarith

private def HardDiskB5.CrossI.SmallGaps (a : Fin 4 → ℝ) : Prop :=
  a 1 - a 0 < 2 * Real.pi / 3 ∧ a 2 - a 1 < 2 * Real.pi / 3 ∧
    a 3 - a 2 < 2 * Real.pi / 3 ∧ 2 * Real.pi + a 0 - a 3 < 2 * Real.pi / 3

private theorem HardDiskB5.CrossI.gaps_sorted_iff (a : Fin 4 → ℝ) (ha : StrictMono a)
    (hlo : ∀ i, 0 < a i) (hhi : ∀ i, a i ≤ 2 * Real.pi) :
    gapsSmall (fun i => circPt (a i)) ↔ HardDiskB5.CrossI.SmallGaps a := by
  have hc01 : ccwAng (circPt (a 0)) (circPt (a 1)) = a 1 - a 0 := by
    simpa only [if_pos (show (0 : Fin 4) < 1 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 0 1 (by decide)
  have hc02 : ccwAng (circPt (a 0)) (circPt (a 2)) = a 2 - a 0 := by
    simpa only [if_pos (show (0 : Fin 4) < 2 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 0 2 (by decide)
  have hc03 : ccwAng (circPt (a 0)) (circPt (a 3)) = a 3 - a 0 := by
    simpa only [if_pos (show (0 : Fin 4) < 3 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 0 3 (by decide)
  have hc10 : ccwAng (circPt (a 1)) (circPt (a 0)) = a 0 - a 1 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (1 : Fin 4) < 0 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 1 0 (by decide)
  have hc12 : ccwAng (circPt (a 1)) (circPt (a 2)) = a 2 - a 1 := by
    simpa only [if_pos (show (1 : Fin 4) < 2 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 1 2 (by decide)
  have hc13 : ccwAng (circPt (a 1)) (circPt (a 3)) = a 3 - a 1 := by
    simpa only [if_pos (show (1 : Fin 4) < 3 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 1 3 (by decide)
  have hc20 : ccwAng (circPt (a 2)) (circPt (a 0)) = a 0 - a 2 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (2 : Fin 4) < 0 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 2 0 (by decide)
  have hc21 : ccwAng (circPt (a 2)) (circPt (a 1)) = a 1 - a 2 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (2 : Fin 4) < 1 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 2 1 (by decide)
  have hc23 : ccwAng (circPt (a 2)) (circPt (a 3)) = a 3 - a 2 := by
    simpa only [if_pos (show (2 : Fin 4) < 3 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 2 3 (by decide)
  have hc30 : ccwAng (circPt (a 3)) (circPt (a 0)) = a 0 - a 3 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (3 : Fin 4) < 0 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 3 0 (by decide)
  have hc31 : ccwAng (circPt (a 3)) (circPt (a 1)) = a 1 - a 3 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (3 : Fin 4) < 1 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 3 1 (by decide)
  have hc32 : ccwAng (circPt (a 3)) (circPt (a 2)) = a 2 - a 3 + 2 * Real.pi := by
    simpa only [if_neg (show ¬ (3 : Fin 4) < 2 by decide)] using
      HardDiskB5.CrossI.ccw_sorted a ha hlo hhi 3 2 (by decide)
  have h01 := ha (by decide : (0 : Fin 4) < 1)
  have h12 := ha (by decide : (1 : Fin 4) < 2)
  have h23 := ha (by decide : (2 : Fin 4) < 3)
  have hl0 := hlo 0
  have hh3 := hhi 3
  constructor
  · intro h
    change _ ∧ _ ∧ _ ∧ _
    refine ⟨?_, ?_, ?_, ?_⟩
    · obtain ⟨l, hl, ht⟩ := h 0
      fin_cases l
      · exact (hl rfl).elim
      · change ccwAng (circPt (a 0)) (circPt (a 1)) < 2 * Real.pi / 3 at ht
        rw [hc01] at ht
        linarith
      · change ccwAng (circPt (a 0)) (circPt (a 2)) < 2 * Real.pi / 3 at ht
        rw [hc02] at ht
        linarith
      · change ccwAng (circPt (a 0)) (circPt (a 3)) < 2 * Real.pi / 3 at ht
        rw [hc03] at ht
        linarith
    · obtain ⟨l, hl, ht⟩ := h 1
      fin_cases l
      · change ccwAng (circPt (a 1)) (circPt (a 0)) < 2 * Real.pi / 3 at ht
        rw [hc10] at ht
        linarith
      · exact (hl rfl).elim
      · change ccwAng (circPt (a 1)) (circPt (a 2)) < 2 * Real.pi / 3 at ht
        rw [hc12] at ht
        linarith
      · change ccwAng (circPt (a 1)) (circPt (a 3)) < 2 * Real.pi / 3 at ht
        rw [hc13] at ht
        linarith
    · obtain ⟨l, hl, ht⟩ := h 2
      fin_cases l
      · change ccwAng (circPt (a 2)) (circPt (a 0)) < 2 * Real.pi / 3 at ht
        rw [hc20] at ht
        linarith
      · change ccwAng (circPt (a 2)) (circPt (a 1)) < 2 * Real.pi / 3 at ht
        rw [hc21] at ht
        linarith
      · exact (hl rfl).elim
      · change ccwAng (circPt (a 2)) (circPt (a 3)) < 2 * Real.pi / 3 at ht
        rw [hc23] at ht
        linarith
    · obtain ⟨l, hl, ht⟩ := h 3
      fin_cases l
      · change ccwAng (circPt (a 3)) (circPt (a 0)) < 2 * Real.pi / 3 at ht
        rw [hc30] at ht
        linarith
      · change ccwAng (circPt (a 3)) (circPt (a 1)) < 2 * Real.pi / 3 at ht
        rw [hc31] at ht
        linarith
      · change ccwAng (circPt (a 3)) (circPt (a 2)) < 2 * Real.pi / 3 at ht
        rw [hc32] at ht
        linarith
      · exact (hl rfl).elim
  · rintro ⟨h01, h12, h23, h30⟩ k
    fin_cases k
    · change ∃ l : Fin 4, l ≠ (0 : Fin 4) ∧ ccwAng (circPt (a 0)) (circPt (a l)) < 2 * Real.pi / 3
      exact ⟨1, by decide, by simpa only [hc01] using h01⟩
    · change ∃ l : Fin 4, l ≠ (1 : Fin 4) ∧ ccwAng (circPt (a 1)) (circPt (a l)) < 2 * Real.pi / 3
      exact ⟨2, by decide, by simpa only [hc12] using h12⟩
    · change ∃ l : Fin 4, l ≠ (2 : Fin 4) ∧ ccwAng (circPt (a 2)) (circPt (a l)) < 2 * Real.pi / 3
      exact ⟨3, by decide, by simpa only [hc23] using h23⟩
    · change ∃ l : Fin 4, l ≠ (3 : Fin 4) ∧ ccwAng (circPt (a 3)) (circPt (a l)) < 2 * Real.pi / 3
      exact ⟨0, by decide, by rw [hc30]; linarith⟩

private theorem HardDiskB5.CrossI.sorted_small_norm (a : Fin 4 → ℝ) (ha : StrictMono a)
    (hg : HardDiskB5.CrossI.SmallGaps a) : ‖∑ i, circPt (a i)‖ < 1 := by
  have h01 := ha (by decide : (0 : Fin 4) < 1)
  have h23 := ha (by decide : (2 : Fin 4) < 3)
  obtain ⟨hg01, hg12, hg23, hg30⟩ := hg
  have hh := HardDiskB5.CrossI.centers_small_norm ((a 1 - a 0) / 2) ((a 3 - a 2) / 2)
    ((a 2 + a 3 - a 0 - a 1) / 2) (by linarith) (by linarith) (by linarith) (by linarith)
    (by linarith) (by linarith)
  rw [Fin.sum_univ_four]
  have hs := HardDiskB5.CrossI.four_norm_sq (a 0) (a 1) (a 2) (a 3)
  nlinarith [norm_nonneg (circPt (a 0) + circPt (a 1) + circPt (a 2) + circPt (a 3))]

private theorem HardDiskB5.CrossI.sorted_small_pairings (a : Fin 4 → ℝ) (ha : StrictMono a)
    (hlo : ∀ i, 0 < a i) (hhi : ∀ i, a i ≤ 2 * Real.pi)
    (hg : HardDiskB5.CrossI.SmallGaps a) :
    numFarPairings (fun i => circPt (a i)) = 2 := by
  have h01 := ha (by decide : (0 : Fin 4) < 1)
  have h12 := ha (by decide : (1 : Fin 4) < 2)
  have h23 := ha (by decide : (2 : Fin 4) < 3)
  obtain ⟨hg01, hg12, hg23, hg30⟩ := hg
  have hp (i j : Fin 4) (hij : i < j) :
      (1 < ‖circPt (a i) + circPt (a j)‖) ↔
        a j - a i < 2 * Real.pi / 3 ∨ 4 * Real.pi / 3 < a j - a i :=
    HardDiskB5.CrossI.pair_far_iff _ _ (ha hij).le (by linarith [hlo i, hhi j])
  have hf01 : 1 < ‖circPt (a 0) + circPt (a 1)‖ := (hp 0 1 (by decide)).2 (Or.inl hg01)
  have hf12 : 1 < ‖circPt (a 1) + circPt (a 2)‖ := (hp 1 2 (by decide)).2 (Or.inl hg12)
  have hf23 : 1 < ‖circPt (a 2) + circPt (a 3)‖ := (hp 2 3 (by decide)).2 (Or.inl hg23)
  have hf03 : 1 < ‖circPt (a 0) + circPt (a 3)‖ := (hp 0 3 (by decide)).2 (Or.inr (by linarith))
  have hn02 : ¬1 < ‖circPt (a 0) + circPt (a 2)‖ := by
    intro h
    rcases (hp 0 2 (by decide)).1 h with h | h <;> linarith
  have hn13 : ¬1 < ‖circPt (a 1) + circPt (a 3)‖ := by
    intro h
    rcases (hp 1 3 (by decide)).1 h with h | h <;> linarith
  simp only [HardDiskB5.CrossI.pairings_formula, HardDiskB5.CrossI.farIndicator,
    if_pos hf01, if_pos hf12, if_pos hf23, if_pos hf03, if_neg hn02, if_neg hn13]
  norm_num

private theorem HardDiskB5.CrossI.circPt_at_zero : circPt 0 = e1 := by simp [circPt]

private theorem HardDiskB5.CrossI.cos_cap (t : ℝ) (hlo : 2 * Real.pi / 3 ≤ t)
    (hhi : t ≤ 4 * Real.pi / 3) : Real.cos t ≤ -1 / 2 := by
  apply le_of_not_gt
  intro h
  rcases (HardDiskB5.CrossI.cos_far_iff t (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos])).1 h with h | h <;> linarith

private theorem HardDiskB5.CrossI.cap_four (a b c d : ℝ)
    (hb : Real.cos (b - a) ≤ -1 / 2) (hc : Real.cos (c - a) ≤ -1 / 2)
    (hd : Real.cos (d - a) ≤ -1 / 2) :
    1 ≤ ‖circPt a + circPt b + circPt c + circPt d‖ := by
  rw [HardDiskB5.CrossI.norm_shift a b c d a, sub_self, HardDiskB5.CrossI.circPt_at_zero]
  apply HardDiskB5.CrossI.three_cap_norm
  · exact HardDiskB5.CrossI.circPt_norm _
  · exact HardDiskB5.CrossI.circPt_norm _
  · exact HardDiskB5.CrossI.circPt_norm _
  · simpa only [HardDiskB5.CrossI.circPt_zero] using hb
  · simpa only [HardDiskB5.CrossI.circPt_zero] using hc
  · simpa only [HardDiskB5.CrossI.circPt_zero] using hd

private theorem HardDiskB5.CrossI.cos_centered (u w : ℝ) (hw0 : 0 ≤ w) (hwπ : w ≤ Real.pi)
    (hlo : -w ≤ u) (hhi : u ≤ w) : Real.cos w ≤ Real.cos u := by
  by_cases hu : 0 ≤ u
  · exact Real.cos_le_cos_of_nonneg_of_le_pi hu hwπ hhi
  · have hh := Real.cos_le_cos_of_nonneg_of_le_pi (by linarith : 0 ≤ -u) hwπ (by linarith : -u ≤ w)
    simpa only [Real.cos_neg] using hh

private theorem HardDiskB5.CrossI.cross_norm_normalized (b c d : ℝ)
    (hb0 : 0 ≤ b) (hbc : b ≤ c) (hcd : c ≤ d)
    (hc : c < 2 * Real.pi / 3) (hdb : d - b < 2 * Real.pi / 3) :
    1 < ‖e1 + circPt b + circPt c + circPt d‖ := by
  have hd0 : 0 ≤ d := hb0.trans (hbc.trans hcd)
  have hdu : d < 4 * Real.pi / 3 := by linarith
  have hp := HardDiskB5.CrossI.projection_bound 0 b c d (d / 2)
  simp only [zero_sub, Real.cos_neg, HardDiskB5.CrossI.circPt_at_zero] at hp
  rw [show d - d / 2 = d / 2 by ring] at hp
  by_cases hd : d < 2 * Real.pi / 3
  · have hbcos := HardDiskB5.CrossI.cos_centered (b - d / 2) (d / 2)
      (by linarith) (by linarith [Real.pi_pos]) (by linarith) (by linarith)
    have hccos := HardDiskB5.CrossI.cos_centered (c - d / 2) (d / 2)
      (by linarith) (by linarith [Real.pi_pos]) (by linarith) (by linarith)
    have hcos := Real.cos_lt_cos_of_nonneg_of_le_pi (by linarith : 0 ≤ d / 2)
      (by linarith [Real.pi_pos] : Real.pi / 3 ≤ Real.pi) (by linarith : d / 2 < Real.pi / 3)
    rw [Real.cos_pi_div_three] at hcos
    linarith
  · have hdl : 2 * Real.pi / 3 ≤ d := le_of_not_gt hd
    have hbcos := HardDiskB5.CrossI.cos_centered (b - d / 2) (2 * Real.pi / 3 - d / 2)
      (by linarith) (by linarith [Real.pi_pos]) (by linarith) (by linarith)
    have hccos := HardDiskB5.CrossI.cos_centered (c - d / 2) (2 * Real.pi / 3 - d / 2)
      (by linarith) (by linarith [Real.pi_pos]) (by linarith) (by linarith)
    have hcos := Real.cos_lt_cos_of_nonneg_of_le_pi (by linarith : 0 ≤ d / 2 - Real.pi / 3)
      (by linarith [Real.pi_pos] : Real.pi / 3 ≤ Real.pi)
      (by linarith : d / 2 - Real.pi / 3 < Real.pi / 3)
    rw [Real.cos_pi_div_three] at hcos
    have heq : Real.cos (d / 2) + Real.cos (2 * Real.pi / 3 - d / 2) =
        Real.cos (d / 2 - Real.pi / 3) := by
      calc
        _ = Real.cos (Real.pi / 3 + (d / 2 - Real.pi / 3)) +
            Real.cos (Real.pi / 3 - (d / 2 - Real.pi / 3)) := by
          congr 1 <;> congr 1 <;> ring
        _ = _ := by simp only [Real.cos_add, Real.cos_sub, Real.cos_pi_div_three]; ring
    linarith

private theorem HardDiskB5.CrossI.cross_norm (a b c d : ℝ) (hab : a ≤ b) (hbc : b ≤ c)
    (hcd : c ≤ d) (hc : c - a < 2 * Real.pi / 3) (hdb : d - b < 2 * Real.pi / 3) :
    1 < ‖circPt a + circPt b + circPt c + circPt d‖ := by
  rw [HardDiskB5.CrossI.norm_shift a b c d a, sub_self, HardDiskB5.CrossI.circPt_at_zero]
  apply HardDiskB5.CrossI.cross_norm_normalized (b - a) (c - a) (d - a)
  · linarith
  · linarith
  · linarith
  · exact hc
  · linarith

private theorem HardDiskB5.CrossI.first_gap_norm (a b c d : ℝ)
    (hab : 2 * Real.pi / 3 ≤ b - a) (hbc : b ≤ c) (hcd : c ≤ d)
    (hspan : d - a ≤ 4 * Real.pi / 3) :
    1 ≤ ‖circPt a + circPt b + circPt c + circPt d‖ := by
  apply HardDiskB5.CrossI.cap_four
  · exact HardDiskB5.CrossI.cos_cap _ hab (by linarith)
  · exact HardDiskB5.CrossI.cos_cap _ (by linarith) (by linarith)
  · exact HardDiskB5.CrossI.cos_cap _ (by linarith) hspan

private theorem HardDiskB5.CrossI.last_gap_norm (a b c d : ℝ)
    (hab : a ≤ b) (hbc : b ≤ c) (hcd : 2 * Real.pi / 3 ≤ d - c)
    (hspan : d - a ≤ 4 * Real.pi / 3) :
    1 ≤ ‖circPt a + circPt b + circPt c + circPt d‖ := by
  have hcos (u : ℝ) (hu : a ≤ u) (hv : u ≤ c) : Real.cos (u - d) ≤ -1 / 2 := by
    rw [show u - d = -(d - u) by ring, Real.cos_neg]
    exact HardDiskB5.CrossI.cos_cap _ (by linarith) (by linarith)
  have hh := HardDiskB5.CrossI.cap_four d a b c
    (hcos a le_rfl (hab.trans hbc)) (hcos b hab hbc) (hcos c (hab.trans hbc) le_rfl)
  simpa only [add_comm, add_left_comm, add_assoc] using hh

private theorem HardDiskB5.CrossI.span_pairings (a : Fin 4 → ℝ) (ha : Monotone a)
    (hspan : a 3 - a 0 ≤ 4 * Real.pi / 3) (hnorm : ‖∑ i, circPt (a i)‖ < 1) :
    numFarPairings (fun i => circPt (a i)) = 1 := by
  have h01 := ha (by decide : (0 : Fin 4) ≤ 1)
  have h12 := ha (by decide : (1 : Fin 4) ≤ 2)
  have h23 := ha (by decide : (2 : Fin 4) ≤ 3)
  have hn : ‖circPt (a 0) + circPt (a 1) + circPt (a 2) + circPt (a 3)‖ < 1 := by
    simpa only [Fin.sum_univ_four] using hnorm
  have hp (i j : Fin 4) (hij : i ≤ j) :
      (1 < ‖circPt (a i) + circPt (a j)‖) ↔ a j - a i < 2 * Real.pi / 3 := by
    have h0i : a 0 ≤ a i := ha (Fin.zero_le _)
    have hj3 : a j ≤ a 3 := ha (Fin.le_last _)
    have hh := HardDiskB5.CrossI.pair_far_iff _ _ (ha hij) (by linarith [Real.pi_pos])
    constructor
    · intro h
      rcases hh.1 h with h | h
      · exact h
      · linarith
    · intro h
      exact hh.2 (Or.inl h)
  have hg01 : a 1 - a 0 < 2 * Real.pi / 3 := by
    by_contra h
    have hh := HardDiskB5.CrossI.first_gap_norm (a 0) (a 1) (a 2) (a 3)
      (le_of_not_gt h) h12 h23 hspan
    linarith
  have hg23 : a 3 - a 2 < 2 * Real.pi / 3 := by
    by_contra h
    have hh := HardDiskB5.CrossI.last_gap_norm (a 0) (a 1) (a 2) (a 3)
      h01 h12 (le_of_not_gt h) hspan
    linarith
  have hcross : ¬(1 < ‖circPt (a 0) + circPt (a 2)‖ ∧ 1 < ‖circPt (a 1) + circPt (a 3)‖) := by
    rintro ⟨h02, h13⟩
    have hh := HardDiskB5.CrossI.cross_norm (a 0) (a 1) (a 2) (a 3) h01 h12 h23
      ((hp 0 2 (by decide)).1 h02) ((hp 1 3 (by decide)).1 h13)
    linarith
  have houter : ¬1 < ‖circPt (a 0) + circPt (a 3)‖ := by
    intro h
    have hg := (hp 0 3 (by decide)).1 h
    have hh := HardDiskB5.CrossI.cross_norm (a 0) (a 1) (a 2) (a 3) h01 h12 h23
      (by linarith) (by linarith)
    linarith
  have hf01 := (hp 0 1 (by decide)).2 hg01
  have hf23 := (hp 2 3 (by decide)).2 hg23
  simp only [HardDiskB5.CrossI.pairings_formula, HardDiskB5.CrossI.farIndicator,
    if_pos hf01, if_pos hf23, if_neg houter, one_mul, zero_mul, add_zero]
  by_cases h02 : 1 < ‖circPt (a 0) + circPt (a 2)‖
  · have h13 : ¬1 < ‖circPt (a 1) + circPt (a 3)‖ := fun h => hcross ⟨h02, h⟩
    rw [if_pos h02, if_neg h13]
    norm_num
  · rw [if_neg h02]
    norm_num

private theorem HardDiskB5.CrossI.mono_four (a b c d : ℝ) (hab : a ≤ b) (hbc : b ≤ c) (hcd : c ≤ d) :
    Monotone ![a, b, c, d] := by
  rw [Fin.monotone_iff_le_succ]
  intro i
  fin_cases i <;> first | exact hab | exact hbc | exact hcd

private theorem HardDiskB5.CrossI.circle_tuple (a b c d : ℝ) :
    (fun i : Fin 4 => circPt (![a, b, c, d] i)) = ![circPt a, circPt b, circPt c, circPt d] := by
  funext i
  fin_cases i <;> rfl

private theorem HardDiskB5.CrossI.pairings_cycle (p q r s : Pt) :
    numFarPairings ![q, r, s, p] = numFarPairings ![p, q, r, s] := by
  let σ : Equiv.Perm (Fin 4) := Equiv.swap 0 1 * Equiv.swap 1 2 * Equiv.swap 2 3
  have he : (![p, q, r, s] : Fin 4 → Pt) ∘ σ = ![q, r, s, p] := by
    funext i
    fin_cases i <;> simp [σ, Equiv.Perm.mul_apply, Equiv.swap_apply_def, Fin.ext_iff]
  rw [← he]
  exact HardDiskB5.CrossI.pairings_reindex _ _

private theorem HardDiskB5.CrossI.sorted_large_pairings (a : Fin 4 → ℝ) (ha : StrictMono a)
    (hlo : ∀ i, 0 < a i) (hhi : ∀ i, a i ≤ 2 * Real.pi)
    (hg : ¬HardDiskB5.CrossI.SmallGaps a) (hnorm : ‖∑ i, circPt (a i)‖ < 1) :
    numFarPairings (fun i => circPt (a i)) = 1 := by
  have h01 := ha (by decide : (0 : Fin 4) < 1)
  have h12 := ha (by decide : (1 : Fin 4) < 2)
  have h23 := ha (by decide : (2 : Fin 4) < 3)
  have h30 : a 3 < a 0 + 2 * Real.pi := by linarith [hlo 0, hhi 3]
  have htuple : (fun i => circPt (a i)) = ![circPt (a 0), circPt (a 1), circPt (a 2), circPt (a 3)] := by
    funext i
    fin_cases i <;> rfl
  have hn : ‖circPt (a 0) + circPt (a 1) + circPt (a 2) + circPt (a 3)‖ < 1 := by
    simpa only [Fin.sum_univ_four] using hnorm
  have hcyc1 := HardDiskB5.CrossI.pairings_cycle (circPt (a 0)) (circPt (a 1)) (circPt (a 2)) (circPt (a 3))
  have hcyc2 := (HardDiskB5.CrossI.pairings_cycle (circPt (a 1)) (circPt (a 2)) (circPt (a 3)) (circPt (a 0))).trans hcyc1
  have hcyc3 := (HardDiskB5.CrossI.pairings_cycle (circPt (a 2)) (circPt (a 3)) (circPt (a 0)) (circPt (a 1))).trans hcyc2
  have rot1 (hgap : 2 * Real.pi / 3 ≤ a 1 - a 0) : numFarPairings (fun i => circPt (a i)) = 1 := by
    let b : Fin 4 → ℝ := ![a 1, a 2, a 3, a 0 + 2 * Real.pi]
    have hb : Monotone b := HardDiskB5.CrossI.mono_four _ _ _ _ h12.le h23.le h30.le
    have hbnorm : ‖∑ i, circPt (b i)‖ < 1 := by
      rw [Fin.sum_univ_four]
      change ‖circPt (a 1) + circPt (a 2) + circPt (a 3) + circPt (a 0 + 2 * Real.pi)‖ < 1
      rw [HardDiskB5.CrossI.circPt_period]
      simpa only [add_comm, add_left_comm, add_assoc] using hn
    have hh := HardDiskB5.CrossI.span_pairings b hb (by change a 0 + 2 * Real.pi - a 1 ≤ 4 * Real.pi / 3; linarith) hbnorm
    change numFarPairings (fun i => circPt (![a 1, a 2, a 3, a 0 + 2 * Real.pi] i)) = 1 at hh
    rw [HardDiskB5.CrossI.circle_tuple, HardDiskB5.CrossI.circPt_period] at hh
    rw [htuple]
    linarith
  have rot2 (hgap : 2 * Real.pi / 3 ≤ a 2 - a 1) : numFarPairings (fun i => circPt (a i)) = 1 := by
    let b : Fin 4 → ℝ := ![a 2, a 3, a 0 + 2 * Real.pi, a 1 + 2 * Real.pi]
    have hb : Monotone b := HardDiskB5.CrossI.mono_four _ _ _ _ h23.le h30.le (by linarith)
    have hbnorm : ‖∑ i, circPt (b i)‖ < 1 := by
      rw [Fin.sum_univ_four]
      change ‖circPt (a 2) + circPt (a 3) + circPt (a 0 + 2 * Real.pi) + circPt (a 1 + 2 * Real.pi)‖ < 1
      simp only [HardDiskB5.CrossI.circPt_period]
      simpa only [add_comm, add_left_comm, add_assoc] using hn
    have hh := HardDiskB5.CrossI.span_pairings b hb (by change a 1 + 2 * Real.pi - a 2 ≤ 4 * Real.pi / 3; linarith) hbnorm
    change numFarPairings (fun i => circPt (![a 2, a 3, a 0 + 2 * Real.pi, a 1 + 2 * Real.pi] i)) = 1 at hh
    rw [HardDiskB5.CrossI.circle_tuple] at hh
    simp only [HardDiskB5.CrossI.circPt_period] at hh
    rw [htuple]
    linarith
  have rot3 (hgap : 2 * Real.pi / 3 ≤ a 3 - a 2) : numFarPairings (fun i => circPt (a i)) = 1 := by
    let b : Fin 4 → ℝ := ![a 3, a 0 + 2 * Real.pi, a 1 + 2 * Real.pi, a 2 + 2 * Real.pi]
    have hb : Monotone b := HardDiskB5.CrossI.mono_four _ _ _ _ h30.le (by linarith) (by linarith)
    have hbnorm : ‖∑ i, circPt (b i)‖ < 1 := by
      rw [Fin.sum_univ_four]
      change ‖circPt (a 3) + circPt (a 0 + 2 * Real.pi) + circPt (a 1 + 2 * Real.pi) + circPt (a 2 + 2 * Real.pi)‖ < 1
      simp only [HardDiskB5.CrossI.circPt_period]
      simpa only [add_comm, add_left_comm, add_assoc] using hn
    have hh := HardDiskB5.CrossI.span_pairings b hb (by change a 2 + 2 * Real.pi - a 3 ≤ 4 * Real.pi / 3; linarith) hbnorm
    change numFarPairings (fun i => circPt (![a 3, a 0 + 2 * Real.pi, a 1 + 2 * Real.pi, a 2 + 2 * Real.pi] i)) = 1 at hh
    rw [HardDiskB5.CrossI.circle_tuple] at hh
    simp only [HardDiskB5.CrossI.circPt_period] at hh
    rw [htuple]
    linarith
  by_cases hg01 : a 1 - a 0 < 2 * Real.pi / 3
  · by_cases hg12 : a 2 - a 1 < 2 * Real.pi / 3
    · by_cases hg23 : a 3 - a 2 < 2 * Real.pi / 3
      · have hg30 : 2 * Real.pi / 3 ≤ 2 * Real.pi + a 0 - a 3 := by
          by_contra h
          exact hg ⟨hg01, hg12, hg23, lt_of_not_ge h⟩
        exact HardDiskB5.CrossI.span_pairings a ha.monotone (by linarith) hnorm
      · exact rot3 (le_of_not_gt hg23)
    · exact rot2 (le_of_not_gt hg12)
  · exact rot1 (le_of_not_gt hg01)

private theorem HardDiskB5.CrossI.sorted_representation (x : Fin 4 → Pt)
    (hu : ∀ i, ‖x i‖ = 1) (hi : Function.Injective x) :
    ∃ (σ : Equiv.Perm (Fin 4)) (a : Fin 4 → ℝ), StrictMono a ∧
      (∀ i, 0 < a i) ∧ (∀ i, a i ≤ 2 * Real.pi) ∧ x ∘ σ = fun i => circPt (a i) := by
  let σ := Tuple.sort (fun i => angE (x i))
  let a := fun i => angE (x (σ i))
  have ha : Monotone a := by
    simpa only [Function.comp_def] using Tuple.monotone_sort (fun i => angE (x i))
  have hj : Function.Injective a := by
    intro i j hij
    apply σ.injective
    apply hi
    rw [← HardDiskB5.CrossI.circPt_angle (x (σ i)) (hu _),
      ← HardDiskB5.CrossI.circPt_angle (x (σ j)) (hu _)]
    exact congrArg circPt hij
  refine ⟨σ, a, ha.strictMono_of_injective hj, ?_, ?_, ?_⟩
  · exact fun i => (HardDiskB5.CrossI.unit_angle _ (hu (σ i))).1
  · exact fun i => (HardDiskB5.CrossI.unit_angle _ (hu (σ i))).2.1
  · funext i
    exact (HardDiskB5.CrossI.circPt_angle _ (hu (σ i))).symm

private theorem HardDiskB5.CrossI.small_generic (x : Fin 4 → Pt) (hx : HardDiskB5.CrossI.Generic x)
    (hg : gapsSmall x) : ‖∑ i, x i‖ < 1 ∧ numFarPairings x = 2 := by
  have hi : Function.Injective x := by
    intro i j hij
    by_contra hne
    exact hx.2.1 i j hne hij
  obtain ⟨σ, a, ha, hlo, hhi, he⟩ := HardDiskB5.CrossI.sorted_representation x hx.1 hi
  have hgσ := (HardDiskB5.CrossI.gaps_reindex x σ).2 hg
  rw [he] at hgσ
  have hga := (HardDiskB5.CrossI.gaps_sorted_iff a ha hlo hhi).1 hgσ
  have hsum : (∑ i, circPt (a i)) = ∑ i, x i := by
    calc
      _ = ∑ i, x (σ i) := by
        apply Finset.sum_congr rfl
        intro i _
        exact (congrFun he i).symm
      _ = _ := Equiv.sum_comp σ x
  have hs := HardDiskB5.CrossI.sorted_small_norm a ha hga
  have hn := HardDiskB5.CrossI.sorted_small_pairings a ha hlo hhi hga
  rw [hsum] at hs
  rw [← he, HardDiskB5.CrossI.pairings_reindex] at hn
  exact ⟨hs, hn⟩

private theorem HardDiskB5.CrossI.large_generic (x : Fin 4 → Pt) (hx : HardDiskB5.CrossI.Generic x)
    (hg : ¬gapsSmall x) (hnorm : ‖∑ i, x i‖ < 1) : numFarPairings x = 1 := by
  have hi : Function.Injective x := by
    intro i j hij
    by_contra hne
    exact hx.2.1 i j hne hij
  obtain ⟨σ, a, ha, hlo, hhi, he⟩ := HardDiskB5.CrossI.sorted_representation x hx.1 hi
  have hga : ¬HardDiskB5.CrossI.SmallGaps a := by
    intro h
    have hh := (HardDiskB5.CrossI.gaps_sorted_iff a ha hlo hhi).2 h
    rw [← he] at hh
    exact hg ((HardDiskB5.CrossI.gaps_reindex x σ).1 hh)
  have hsum : (∑ i, circPt (a i)) = ∑ i, x i := by
    calc
      _ = ∑ i, x (σ i) := by
        apply Finset.sum_congr rfl
        intro i _
        exact (congrFun he i).symm
      _ = _ := Equiv.sum_comp σ x
  have hn := HardDiskB5.CrossI.sorted_large_pairings a ha hlo hhi hga (by rwa [hsum])
  rw [← he, HardDiskB5.CrossI.pairings_reindex] at hn
  exact hn

theorem solution_s12569312 :
    ∀ᵐ x ∂freeCircle4, (if ‖∑ i, x i‖ < 1 then numFarPairings x - 1 else 0) = if gapsSmall x then (1 : ℝ) else 0 := by
  exact HardDiskB5.CrossI.of_pointwise HardDiskB5.CrossI.small_generic HardDiskB5.CrossI.large_generic
