    rw [← e1, ← e2]; ring
  rw [this, dist_o_circle0 H]
  rw [H.cos_angP] at hin
  nlinarith [H.nn_pos]

private lemma HardDiskB5.C4.N1in.G.Hyp.Ro_le_R0 {θ : ℝ} (hθ : cos (θ - bet lam) ≤ 0)
