    linarith [le_abs_self (r + w)]
  · intro h
    have h1 : r + w < √(w ^ 2 + k) := by linarith
    by_cases hw : 0 ≤ r + w
    · have := (Real.lt_sqrt hw).1 h1
      nlinarith
    · nlinarith

