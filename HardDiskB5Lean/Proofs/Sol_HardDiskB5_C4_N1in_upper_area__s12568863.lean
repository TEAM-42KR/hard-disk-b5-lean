    rw [← e1, ← e2]; ring
  rw [this, dist_o_circlev H]
  rw [H.cos_angQ] at hin
  nlinarith [H.ss_pos]

private lemma HardDiskB5.C4.N1in.G.Hyp.Ro_le_Rv {θ : ℝ} (hθ : 0 ≤ cos (θ + bet lam))
