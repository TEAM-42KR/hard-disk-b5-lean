open HardDiskB5.C4.N1in.G

private noncomputable def HardDiskB5.C4.N1in.G.R0 (lam θ : ℝ) : ℝ := -cos (θ - bet lam) + |cos (θ - bet lam)|
private noncomputable def HardDiskB5.C4.N1in.G.Rv (lam θ : ℝ) : ℝ := cos (θ + bet lam) + |cos (θ + bet lam)|
private noncomputable def HardDiskB5.C4.N1in.G.Ro (lam a b θ : ℝ) : ℝ :=
  rho (lam / 2 - a) (hh lam - b) (1 - (lam / 2 - a) ^ 2 - (hh lam - b) ^ 2) θ
private noncomputable def HardDiskB5.C4.N1in.G.mm (lam a b θ : ℝ) : ℝ := min (R0 lam θ) (min (Rv lam θ) (Ro lam a b θ))
private noncomputable def HardDiskB5.C4.N1in.G.th2 (lam a b : ℝ) : ℝ := (angA a b - angP a b + bet lam - π) / 2
private noncomputable def HardDiskB5.C4.N1in.G.th3 (lam a b : ℝ) : ℝ := (angB lam a b + angQ lam a b - 2 * π - bet lam) / 2

private lemma HardDiskB5.C4.N1in.G.X0_cos (c θ : ℝ) : -2 * cos (θ - c) * cos θ + cos c = cos (2 * θ + π - c) := by
  rw [show 2 * θ + π - c = (2 * θ - c) + π by ring, cos_add_pi]
  simp only [cos_sub, cos_two_mul, sin_two_mul]; ring
private lemma HardDiskB5.C4.N1in.G.X0_sin (c θ : ℝ) : -2 * cos (θ - c) * sin θ + sin c = sin (2 * θ + π - c) := by
  rw [show 2 * θ + π - c = (2 * θ - c) + π by ring, sin_add_pi]
  simp only [cos_sub, sin_sub, cos_two_mul, sin_two_mul]
  have := sin_sq_add_cos_sq θ
  linear_combination (-2 * sin c) * this
private lemma HardDiskB5.C4.N1in.G.Xv_cos (c θ : ℝ) : 2 * cos (θ + c) * cos θ - cos c = cos (2 * θ + c) := by
  rw [cos_add, cos_add, cos_two_mul, sin_two_mul]; ring
private lemma HardDiskB5.C4.N1in.G.Xv_sin (c θ : ℝ) : 2 * cos (θ + c) * sin θ + sin c = sin (2 * θ + c) := by
  rw [cos_add, sin_add, cos_two_mul, sin_two_mul]
  have := sin_sq_add_cos_sq θ
  linear_combination (-2 * sin c) * this

private lemma HardDiskB5.C4.N1in.G.R0_nonneg (lam θ : ℝ) : 0 ≤ R0 lam θ := by
  unfold R0; linarith [le_abs_self (cos (θ - bet lam))]
private lemma HardDiskB5.C4.N1in.G.Rv_nonneg (lam θ : ℝ) : 0 ≤ Rv lam θ := by
  unfold Rv; linarith [neg_abs_le (cos (θ + bet lam))]
private lemma HardDiskB5.C4.N1in.G.R0_of_nonpos {lam θ : ℝ} (h : cos (θ - bet lam) ≤ 0) : R0 lam θ = -2 * cos (θ - bet lam) := by
  unfold R0; rw [abs_of_nonpos h]; ring
private lemma HardDiskB5.C4.N1in.G.R0_of_nonneg {lam θ : ℝ} (h : 0 ≤ cos (θ - bet lam)) : R0 lam θ = 0 := by
  unfold R0; rw [abs_of_nonneg h]; ring
private lemma HardDiskB5.C4.N1in.G.Rv_of_nonneg {lam θ : ℝ} (h : 0 ≤ cos (θ + bet lam)) : Rv lam θ = 2 * cos (θ + bet lam) := by
  unfold Rv; rw [abs_of_nonneg h]; ring
private lemma HardDiskB5.C4.N1in.G.Rv_of_nonpos {lam θ : ℝ} (h : cos (θ + bet lam) ≤ 0) : Rv lam θ = 0 := by
  unfold Rv; rw [abs_of_nonpos h]; ring

private lemma HardDiskB5.C4.N1in.G.mm_nonneg {lam a b : ℝ} (H : Hyp lam a b) (θ : ℝ) : 0 ≤ mm lam a b θ := by
  have := H.Q_in
  exact le_min (R0_nonneg _ _) (le_min (Rv_nonneg _ _) (rho_nonneg (by linarith) _))

private lemma HardDiskB5.C4.N1in.G.continuous_mm (lam a b : ℝ) : Continuous (mm lam a b) := by
  unfold mm R0 Rv Ro
  have := continuous_rho (lam / 2 - a) (hh lam - b) (1 - (lam / 2 - a) ^ 2 - (hh lam - b) ^ 2)
  fun_prop

/-- distance identity for points on the circle around `0`. -/
private lemma HardDiskB5.C4.N1in.G.dist_o_circle0 {lam a b : ℝ} (H : Hyp lam a b) (γ : ℝ) :
    (cos γ - a) ^ 2 + (sin γ - b) ^ 2 = 1 - 2 * nn a b * cos (γ - angA a b) + nn a b ^ 2 := by
  have hn := H.nn_pos
  rw [cos_sub, H.cos_angA, H.sin_angA, nn_sq' a b]
  field_simp
  have := sin_sq_add_cos_sq γ
  linear_combination this

private lemma HardDiskB5.C4.N1in.G.dist_o_circlev {lam a b : ℝ} (H : Hyp lam a b) (γ : ℝ) :
    (cos γ + lam - a) ^ 2 + (sin γ - b) ^ 2
      = 1 - 2 * ss lam a b * cos (γ - angB lam a b) + ss lam a b ^ 2 := by
  have hn := H.ss_pos
  rw [cos_sub, H.cos_angB, H.sin_angB, ss_sq' lam a b]
  field_simp
  have := sin_sq_add_cos_sq γ
  linear_combination this

