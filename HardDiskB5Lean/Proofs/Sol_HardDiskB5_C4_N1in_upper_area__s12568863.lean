  have hQ1 := H.angQ_gt; have hQ2 := H.angQ_lt; have hB1 := H.angB_gt; have hB2 := H.angB_lt
  have hc1 : 0 ≤ cos (θ + bet lam) := by
    apply cos_nonneg_of_neg_pi_div_two_le_of_le <;> linarith
  have hc2 : cos (θ - bet lam) ≤ 0 := by
    rw [← cos_neg]; apply cos_nonpos_of_pi_div_two_le_of_le <;> linarith
  have hcos : cos θ ≤ 0 := by
    rw [← cos_neg]; apply cos_nonpos_of_pi_div_two_le_of_le <;> linarith
  have hsum := H.sum_cos θ
  have hRvR0 : Rv lam θ ≤ R0 lam θ := by
    rw [Rv_of_nonneg hc1, R0_of_nonpos hc2]; nlinarith [H.hl1]
  have hRoRv : Ro lam a b θ ≤ Rv lam θ := by
    rw [Rv_of_nonneg hc1]
    apply H.Ro_le_Rv hc1
    rw [← cos_neg, neg_sub]
    apply cos_le_of_mem (by linarith) <;> unfold th3 at h1 <;> linarith
  unfold mm
  rw [min_eq_right hRoRv, min_eq_right (hRoRv.trans hRvR0)]

private lemma HardDiskB5.C4.N1in.G.Hyp.mm_Ro2 {θ : ℝ} (h1 : -π / 2 ≤ θ) (h2 : θ ≤ th2 lam a b) :
