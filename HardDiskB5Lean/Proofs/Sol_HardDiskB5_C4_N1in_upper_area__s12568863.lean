  apply rho_le_of_notMem (by linarith) H.Q_in
  have e1 := Xv_cos (bet lam) θ; have e2 := Xv_sin (bet lam) θ
  rw [H.cos_bet] at e1; rw [sin_bet'] at e2
  have : (2 * cos (θ + bet lam) * cos θ + (lam / 2 - a)) ^ 2
