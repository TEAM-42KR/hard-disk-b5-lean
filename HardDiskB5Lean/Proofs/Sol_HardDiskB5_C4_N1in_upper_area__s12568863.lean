  have hQ1 := H.angQ_gt; have hQ2 := H.angQ_lt; have hQB := (abs_lt.1 H.QB).1
  have hc1 : 0 ≤ cos (θ + bet lam) := by
    apply cos_nonneg_of_neg_pi_div_two_le_of_le <;> linarith
  have hc2 : cos (θ - bet lam) ≤ 0 := by
    rw [← cos_neg]; apply cos_nonpos_of_pi_div_two_le_of_le <;> linarith
  have hcos : cos θ ≤ 0 := by
    rw [← cos_neg]; apply cos_nonpos_of_pi_div_two_le_of_le <;> linarith
  have hsum := H.sum_cos θ
