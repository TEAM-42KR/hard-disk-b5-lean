  rw [ss, ← Real.sqrt_sq_eq_abs]; exact Real.sqrt_lt_sqrt (sq_nonneg _) (by nlinarith [H.hb])

private lemma HardDiskB5.C4.N1in.G.Hyp.cos_angA : cos (angA a b) = a / nn a b := by
  have h := H.abs_a_lt; have hn := H.nn_pos
  rw [abs_lt] at h
  exact cos_arccos (by rw [le_div_iff₀ hn]; linarith) (by rw [div_le_iff₀ hn]; linarith)
private lemma HardDiskB5.C4.N1in.G.Hyp.sin_angA : sin (angA a b) = b / nn a b := by
  have hn := H.nn_pos
  rw [angA, sin_arccos]
  have : 1 - (a / nn a b) ^ 2 = (b / nn a b) ^ 2 := by
    field_simp; nlinarith [nn_sq' a b]
  rw [this, Real.sqrt_sq (div_nonneg H.hb.le hn.le)]
private lemma HardDiskB5.C4.N1in.G.Hyp.angA_pos : 0 < angA a b := by
  have h := H.abs_a_lt; have hn := H.nn_pos
  exact arccos_pos.2 (by rw [div_lt_one hn]; linarith [le_abs_self a])
private lemma HardDiskB5.C4.N1in.G.Hyp.angA_lt : angA a b < π := by
  have h := H.abs_a_lt; have hn := H.nn_pos
  rw [abs_lt] at h
  exact arccos_lt_pi.2 (by rw [lt_div_iff₀ hn]; linarith)

private lemma HardDiskB5.C4.N1in.G.Hyp.cos_angB : cos (angB lam a b) = (a - lam) / ss lam a b := by
  have h := H.abs_a_lam_lt; have hn := H.ss_pos
  rw [abs_lt] at h
  exact cos_arccos (by rw [le_div_iff₀ hn]; linarith) (by rw [div_le_iff₀ hn]; linarith)
private lemma HardDiskB5.C4.N1in.G.Hyp.sin_angB : sin (angB lam a b) = b / ss lam a b := by
  have hn := H.ss_pos
  rw [angB, sin_arccos]
  have : 1 - ((a - lam) / ss lam a b) ^ 2 = (b / ss lam a b) ^ 2 := by
    field_simp; nlinarith [ss_sq' lam a b]
  rw [this, Real.sqrt_sq (div_nonneg H.hb.le hn.le)]
private lemma HardDiskB5.C4.N1in.G.Hyp.angB_lt : angB lam a b < π := by
  have h := H.abs_a_lam_lt; have hn := H.ss_pos
  rw [abs_lt] at h
  exact arccos_lt_pi.2 (by rw [lt_div_iff₀ hn]; linarith)
private lemma HardDiskB5.C4.N1in.G.Hyp.angB_gt : 0 < angB lam a b := by
  have h := H.abs_a_lam_lt; have hn := H.ss_pos
  exact arccos_pos.2 (by rw [div_lt_one hn]; linarith [le_abs_self (a-lam)])

private lemma HardDiskB5.C4.N1in.G.Hyp.cos_angP : cos (angP a b) = nn a b / 2 :=
  cos_arccos (by linarith [H.nn_pos]) (by linarith [H.nn_lt_two])
omit H in
private lemma HardDiskB5.C4.N1in.G.Hyp.sin_angP : sin (angP a b) = √(1 - (nn a b / 2) ^ 2) := sin_arccos _
private lemma HardDiskB5.C4.N1in.G.Hyp.angP_gt : 0 < angP a b := by
  exact arccos_pos.2 (by linarith [H.nn_lt_two])
private lemma HardDiskB5.C4.N1in.G.Hyp.angP_lt : angP a b < π / 2 := arccos_lt_pi_div_two.2 (by linarith [H.nn_pos])

private lemma HardDiskB5.C4.N1in.G.Hyp.cos_angQ : cos (angQ lam a b) = ss lam a b / 2 :=
  cos_arccos (by linarith [H.ss_pos]) (by linarith [H.ss_lt_two])
omit H in
private lemma HardDiskB5.C4.N1in.G.Hyp.sin_angQ : sin (angQ lam a b) = √(1 - (ss lam a b / 2) ^ 2) := sin_arccos _
private lemma HardDiskB5.C4.N1in.G.Hyp.angQ_gt : 0 < angQ lam a b := by
  exact arccos_pos.2 (by linarith [H.ss_lt_two])
private lemma HardDiskB5.C4.N1in.G.Hyp.angQ_lt : angQ lam a b < π / 2 := arccos_lt_pi_div_two.2 (by linarith [H.ss_pos])

/-- The upper lens vertex lies in the open disk around `o`. -/
private lemma HardDiskB5.C4.N1in.G.Hyp.Q_in : (lam / 2 - a) ^ 2 + (hh lam - b) ^ 2 < 1 := H.hplus

private lemma HardDiskB5.C4.N1in.G.Hyp.QA : |bet lam - angA a b| < angP a b := by
  have hn := H.nn_pos; have h2 := H.hh_sq; have hq := H.Q_in; have hn2 := nn_sq' a b
  apply abs_lt_of_cos_lt
  · rw [abs_le]; constructor <;> linarith [H.bet_pos, H.bet_le, H.angA_pos, H.angA_lt, pi_pos]
  · linarith [H.angP_gt, pi_pos]
  rw [cos_sub, H.cos_bet, sin_bet', H.cos_angA, H.sin_angA, H.cos_angP]
  rw [show lam / 2 * (a / nn a b) + hh lam * (b / nn a b) = (lam * a + 2 * hh lam * b) / (2 * nn a b)
    by field_simp, lt_div_iff₀ (by positivity)]
  nlinarith

private lemma HardDiskB5.C4.N1in.G.Hyp.QB : |π - bet lam - angB lam a b| < angQ lam a b := by
  have hn := H.ss_pos; have h2 := H.hh_sq; have hq := H.Q_in; have hn2 := ss_sq' lam a b
  apply abs_lt_of_cos_lt
  · rw [abs_le]; constructor <;> linarith [H.bet_pos, H.bet_le, H.angB_gt, H.angB_lt, pi_pos]
  · linarith [H.angQ_gt, pi_pos]
  rw [show π - bet lam - angB lam a b = π - (bet lam + angB lam a b) by ring, cos_pi_sub, cos_add,
    H.cos_bet, sin_bet', H.cos_angB, H.sin_angB, H.cos_angQ]
  rw [show -(lam / 2 * ((a - lam) / ss lam a b) - hh lam * (b / ss lam a b))
      = (lam * (lam - a) + 2 * hh lam * b) / (2 * ss lam a b)
    by field_simp; ring, lt_div_iff₀ (by positivity)]
  nlinarith

private lemma HardDiskB5.C4.N1in.G.Hyp.CA (hc : 1 < (a - lam / 2) ^ 2 + (b + hh lam) ^ 2) : angP a b < bet lam + angA a b := by
  have hn := H.nn_pos; have h2 := H.hh_sq; have hn2 := nn_sq' a b
  by_contra hcon
  push_neg at hcon
  have h := cos_le_cos_of_nonneg_of_le_pi (by linarith [H.bet_pos, H.angA_pos])
    (by linarith [H.angP_lt, pi_pos]) hcon
  rw [cos_add, H.cos_bet, sin_bet', H.cos_angA, H.sin_angA, H.cos_angP] at h
  rw [show lam / 2 * (a / nn a b) - hh lam * (b / nn a b) = (lam * a - 2 * hh lam * b) / (2 * nn a b)
    by field_simp] at h
  have key := (le_div_iff₀ (by positivity)).1 h
  nlinarith

private lemma HardDiskB5.C4.N1in.G.Hyp.CB (hc : 1 < (a - lam / 2) ^ 2 + (b + hh lam) ^ 2) :
    angQ lam a b < π + bet lam - angB lam a b := by
  have hn := H.ss_pos; have h2 := H.hh_sq; have hn2 := ss_sq' lam a b
  by_contra hcon
  push_neg at hcon
  have h := cos_le_cos_of_nonneg_of_le_pi (by linarith [H.bet_pos, H.angB_lt])
    (by linarith [H.angQ_lt, pi_pos]) hcon
  rw [show π + bet lam - angB lam a b = π - (angB lam a b - bet lam) by ring, cos_pi_sub, cos_sub,
    H.cos_bet, sin_bet', H.cos_angB, H.sin_angB, H.cos_angQ] at h
  rw [show -((a - lam) / ss lam a b * (lam / 2) + b / ss lam a b * hh lam)
      = (lam * (lam - a) - 2 * hh lam * b) / (2 * ss lam a b)
    by field_simp; ring] at h
  have key := (le_div_iff₀ (by positivity)).1 h
  nlinarith

end

