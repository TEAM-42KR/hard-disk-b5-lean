    rw [← e1, ← e2]; ring
  rw [this, dist_o_circle0 H]
  rw [H.cos_angP] at hout
  nlinarith [H.nn_pos]

private lemma HardDiskB5.C4.N1in.G.Hyp.sum_cos (θ : ℝ) : cos (θ + bet lam) + cos (θ - bet lam) = lam * cos θ := by
  rw [cos_add, cos_sub, H.cos_bet]; ring

private lemma HardDiskB5.C4.N1in.G.Hyp.mm_Rv {θ : ℝ} (hc : 1 < (a - lam / 2) ^ 2 + (b + hh lam) ^ 2)
    (h1 : -π / 2 - bet lam ≤ θ) (h2 : θ ≤ th3 lam a b) :
    mm lam a b θ = 2 * cos (θ + bet lam) := by
