private lemma HardDiskB5.C4.N1in.G.Hyp.mm_left {θ : ℝ} (h1 : -π ≤ θ) (h2 : θ ≤ -π / 2 - bet lam) : mm lam a b θ = 0 := by
  have hb1 := H.bet_pos; have hb2 := H.bet_le
