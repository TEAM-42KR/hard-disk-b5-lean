  by_cases hp : (a = i ∧ b = j) ∨ (a = j ∧ b = i)
  · simp [hp]
  by_cases hab : a < b
  · simp [hp, pairFactor, hab, vk_adj, ne_of_lt hab, ovl]
  · simp [hp, pairFactor, hab]

