private def vkClose (i j : Fin 5) (x : Fin 5 → Pt) : Prop :=
  ∀ a b, a ≠ b → ¬ ((a = i ∧ b = j) ∨ (a = j ∧ b = i)) → dist (x a) (x b) < 1

private lemma vk_factor (i j a b : Fin 5) (x : Fin 5 → Pt) :
