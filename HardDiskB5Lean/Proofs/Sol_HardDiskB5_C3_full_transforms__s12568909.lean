    ⟨fun a s _ => measure_preimage_add _ _ _⟩
  have hfd : (∫⁻ x in Set.Ico c (c + T), f x) = ∫⁻ x in Set.Ico 0 T, f x := by
    calc
      _ = ∫⁻ x in Set.Ioc c (c + T), f x := setLIntegral_congr Ico_ae_eq_Ioc
      _ = ∫⁻ x in Set.Ioc 0 (0 + T), f x :=
        (isAddFundamentalDomain_Ioc hT c).setLIntegral_eq
          (isAddFundamentalDomain_Ioc hT 0) f hf.map_vadd_zmultiples
      _ = ∫⁻ x in Set.Ico 0 T, f x := by
        simpa only [zero_add] using
          (setLIntegral_congr (f := f) (μ := volume)
            (Ico_ae_eq_Ioc (a := 0) (b := T))).symm
  calc
    _ = ∫⁻ x : ℝ, (Set.Ico c (c + T)).indicator f (x + c) := by
      rw [← lintegral_indicator measurableSet_Ico]
      apply lintegral_congr
      intro x
      have hx : x + c ∈ Set.Ico c (c + T) ↔ x ∈ Set.Ico 0 T := by
        simp only [Set.mem_Ico]
        constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
      simp only [Set.indicator_apply, hx]
    _ = ∫⁻ x : ℝ, (Set.Ico c (c + T)).indicator f x :=
      lintegral_add_right_eq_self _ c
    _ = ∫⁻ x in Set.Ico 0 T, f x :=
      (lintegral_indicator measurableSet_Ico f).trans hfd

private theorem FT.Dens.arc_disk (y : Pt) : arcMeasure (disk y) = ENNReal.ofReal (C1.b ‖y‖) := by
  classical
  have hmeas : Measurable circPt := by unfold circPt; fun_prop
  have hd (c : Pt) : MeasurableSet (disk c) := Metric.isOpen_ball.measurableSet
  have hunit (t : ℝ) : ‖circPt t‖ = 1 := by
    have hsq : ‖circPt t‖ ^ 2 = 1 := by
      rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
      simp [circPt, e1, e2]
    nlinarith [norm_nonneg (circPt t)]
  have harc (c : Pt) : arcMeasure (disk c) =
      ∫⁻ t in Set.Ico 0 (2 * Real.pi), (disk c).indicator (fun _ => (1 : ENNReal)) (circPt t) := by
    calc
      _ = ∫⁻ x : Pt, (disk c).indicator (fun _ => (1 : ENNReal)) x ∂arcMeasure :=
        (lintegral_indicator_one (hd c)).symm
      _ = _ := by
        rw [arcMeasure, lintegral_map (measurable_const.indicator (hd c)) hmeas]
  have hsq (r t φ : ℝ) : ‖circPt t - r • circPt φ‖ ^ 2 =
      1 + r ^ 2 - 2 * r * Real.cos (t - φ) := by
    rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two, Real.cos_sub]
    simp [circPt, e1, e2]
    have hφ := congrArg (fun z : ℝ => r ^ 2 * z) (Real.sin_sq_add_cos_sq φ)
    nlinarith [Real.sin_sq_add_cos_sq t]
  have hrot (r φ : ℝ) : arcMeasure (disk (r • circPt φ)) = arcMeasure (disk (r • e1)) := by
    let g : ℝ → ENNReal := fun t => (disk (r • e1)).indicator (fun _ => 1) (circPt t)
    have hperiod : Function.Periodic g (2 * Real.pi) := by
      intro t
      simp [g, circPt, Real.cos_add, Real.sin_add]
    have hmem (t : ℝ) : circPt t ∈ disk (r • circPt φ) ↔ circPt (t - φ) ∈ disk (r • e1) := by
      have h0 : circPt 0 = e1 := by simp [circPt]
      have hnorm : ‖circPt t - r • circPt φ‖ = ‖circPt (t - φ) - r • e1‖ := by
        apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
        rw [hsq, ← h0, hsq, sub_zero]
      simpa only [disk, Metric.mem_ball, dist_eq_norm, hnorm]
    rw [harc, harc]
    calc
      _ = ∫⁻ t in Set.Ico 0 (2 * Real.pi), g (t + -φ) := by
        apply lintegral_congr
        intro t
        simp only [g, Set.indicator_apply, ← sub_eq_add_neg, hmem]
      _ = _ := FT.Dens.periodic_lintegral_shift
        (2 * Real.pi) (by positivity) g hperiod (-φ)
  by_cases hy0 : y = 0
  · subst y
    have hp : circPt ⁻¹' disk (0 : Pt) = ∅ := by
      ext t
      simp [disk, Metric.mem_ball, dist_zero_right, hunit]
    rw [arcMeasure, Measure.map_apply hmeas (hd 0), hp, measure_empty]
    simp [C1.b]
  by_cases hy2 : ‖y‖ < 2
  · let z : ℂ := ⟨y 0, y 1⟩
    have hn : ‖z‖ = ‖y‖ := by
      apply (sq_eq_sq₀ (norm_nonneg z) (norm_nonneg y)).mp
      rw [Complex.sq_norm, EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
      simp [z, Complex.normSq_apply]
      ring
    have hy : y = ‖y‖ • circPt (Complex.arg z) := by
      ext i
      fin_cases i
      · simpa [circPt, e1, e2, ← hn, z] using (Complex.norm_mul_cos_arg z).symm
      · simpa [circPt, e1, e2, ← hn, z] using (Complex.norm_mul_sin_arg z).symm
    have hp : 0 < ‖y‖ := norm_pos_iff.mpr hy0
    calc
      _ = arcMeasure (disk (‖y‖ • e1)) := by
        conv_lhs => rw [hy]
        exact hrot ‖y‖ (Complex.arg z)
      _ = _ := by
        rw [FT.Dens.arc_disk_axis ‖y‖ hp hy2]
        simp [C1.b, hp, hy2]
  · have hp : circPt ⁻¹' disk y = ∅ := by
      ext t
      simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
      intro ht
      change dist (circPt t) y < 1 at ht
      rw [dist_comm, dist_eq_norm] at ht
      have hle := norm_add_le (circPt t) (y - circPt t)
      have he : circPt t + (y - circPt t) = y := by abel
      rw [he, hunit] at hle
      linarith
    rw [arcMeasure, Measure.map_apply hmeas (hd y), hp, measure_empty]
    simp [C1.b, hy2]

private theorem FT.Dens.mixed (b₁ b₂ : Bool) (hne : b₁ ≠ b₂) :
    Measure.map (fun z : Pt × Pt => z.1 + z.2) ((stepLaw b₁).prod (stepLaw b₂)) =
    volume.withDensity (fun y : Pt => ENNReal.ofReal (pairDensity b₁ b₂ ‖y‖)) := by
  haveI : IsFiniteMeasure arcMeasure := by unfold arcMeasure; infer_instance
  have hm : (volume.restrict (disk (0 : Pt))).conv arcMeasure =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (C1.b ‖y‖)) := by
    rw [Measure.conv, FT.Dens.disk_conv arcMeasure]
    congr 1
    funext y
    exact FT.Dens.arc_disk y
  cases b₁ <;> cases b₂
  · exact (hne rfl).elim
  · have hm' := (Measure.conv_comm arcMeasure (volume.restrict (disk (0 : Pt)))).trans hm
    simpa [stepLaw, pairDensity, Measure.conv] using hm'
  · simpa [stepLaw, pairDensity, Measure.conv] using hm
  · exact (hne rfl).elim

private theorem FT.Dens.circle_sum_injective_sheet (b : Bool) :
    Set.InjOn (fun p : ℝ × ℝ => (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2))
      {p : ℝ × ℝ | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
        0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))} := by
  rintro p ⟨hp1, hp2, hp3⟩ q ⟨hq1, hq2, hq3⟩ he
  let A := Real.cos p.1 + Real.cos p.2
  let B := Real.sin p.1 + Real.sin p.2
  have hA : A = Real.cos q.1 + Real.cos q.2 := congrArg Prod.fst he
  have hB : B = Real.sin q.1 + Real.sin q.2 := congrArg Prod.snd he
  have hpN : A ^ 2 + B ^ 2 = 2 + 2 * Real.cos (p.1 - p.2) := by
    dsimp [A, B]
    rw [Real.cos_sub]
    nlinarith only [Real.sin_sq_add_cos_sq p.1, Real.sin_sq_add_cos_sq p.2]
  have hqN : A ^ 2 + B ^ 2 = 2 + 2 * Real.cos (q.1 - q.2) := by
    rw [hA, hB, Real.cos_sub]
    nlinarith only [Real.sin_sq_add_cos_sq q.1, Real.sin_sq_add_cos_sq q.2]
  have hcos : Real.cos (p.1 - p.2) = Real.cos (q.1 - q.2) := by linarith only [hpN, hqN]
  have hs2 : Real.sin (p.1 - p.2) ^ 2 = Real.sin (q.1 - q.2) ^ 2 := by
    have hp := Real.sin_sq_add_cos_sq (p.1 - p.2)
    rw [hcos] at hp
    nlinarith only [hp, Real.sin_sq_add_cos_sq (q.1 - q.2)]
  have hsin : Real.sin (p.1 - p.2) = Real.sin (q.1 - q.2) := by
    cases b
    · simp only [Bool.false_eq_true, ↓reduceIte] at hp3 hq3
      have hsq : (-Real.sin (p.1 - p.2)) ^ 2 = (-Real.sin (q.1 - q.2)) ^ 2 := by simpa only [neg_sq] using hs2
      have hh := (sq_eq_sq₀ hp3.le hq3.le).mp hsq
      linarith only [hh]
    · simp only [↓reduceIte] at hp3 hq3
      exact (sq_eq_sq₀ hp3.le hq3.le).mp hs2
  have hdetp : A * Real.sin p.1 - B * Real.cos p.1 = Real.sin (p.1 - p.2) := by
    dsimp [A, B]
    rw [Real.sin_sub]
    ring
  have hdetq : A * Real.sin q.1 - B * Real.cos q.1 = Real.sin (q.1 - q.2) := by
    rw [hA, hB, Real.sin_sub]
    ring
  have hnz : A ^ 2 + B ^ 2 ≠ 0 := by
    intro hz
    have ha : A = 0 := by nlinarith only [hz, sq_nonneg B]
    have hb : B = 0 := by nlinarith only [hz, sq_nonneg A]
    have hs0 : Real.sin (p.1 - p.2) = 0 := by rw [ha, hb] at hdetp; simpa using hdetp.symm
    cases b <;> simp [hs0] at hp3
  have hdotp : A * Real.cos p.1 + B * Real.sin p.1 = (A ^ 2 + B ^ 2) / 2 := by
    dsimp [A, B]
    nlinarith only [Real.sin_sq_add_cos_sq p.1, Real.sin_sq_add_cos_sq p.2]
  have hdotq : A * Real.cos q.1 + B * Real.sin q.1 = (A ^ 2 + B ^ 2) / 2 := by
    rw [hA, hB]
    nlinarith only [Real.sin_sq_add_cos_sq q.1, Real.sin_sq_add_cos_sq q.2]
  have hlin1 : A * (Real.cos p.1 - Real.cos q.1) + B * (Real.sin p.1 - Real.sin q.1) = 0 := by
    nlinarith only [hdotp, hdotq]
  have hlin2 : A * (Real.sin p.1 - Real.sin q.1) - B * (Real.cos p.1 - Real.cos q.1) = 0 := by
    nlinarith only [hdetp, hdetq, hsin]
  have hx : (A ^ 2 + B ^ 2) * (Real.cos p.1 - Real.cos q.1) = 0 := by
    have h1 := congrArg (fun z : ℝ => A * z) hlin1
    have h2 := congrArg (fun z : ℝ => B * z) hlin2
    nlinarith only [h1, h2]
  have hy : (A ^ 2 + B ^ 2) * (Real.sin p.1 - Real.sin q.1) = 0 := by
    have h1 := congrArg (fun z : ℝ => B * z) hlin1
    have h2 := congrArg (fun z : ℝ => A * z) hlin2
    nlinarith only [h1, h2]
  have hc1 : Real.cos p.1 = Real.cos q.1 :=
    sub_eq_zero.mp ((mul_eq_zero.mp hx).resolve_left hnz)
  have hs1 : Real.sin p.1 = Real.sin q.1 :=
    sub_eq_zero.mp ((mul_eq_zero.mp hy).resolve_left hnz)
  have hc2 : Real.cos p.2 = Real.cos q.2 := by dsimp [A] at hA; linarith only [hA, hc1]
  have hs2' : Real.sin p.2 = Real.sin q.2 := by dsimp [B] at hB; linarith only [hB, hs1]
  have hinj : Set.InjOn Circle.exp (Set.Ico 0 (2 * Real.pi)) :=
    Circle.exp_injOn_Ico (by linarith)
  have heq (x y : ℝ) (hc : Real.cos x = Real.cos y) (hs : Real.sin x = Real.sin y) :
      Circle.exp x = Circle.exp y := by
    apply Subtype.ext
    simp only [Circle.coe_exp, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, hc, hs]
  exact Prod.ext (hinj hp1 hq1 (heq _ _ hc1 hs1)) (hinj hp2 hq2 (heq _ _ hc2 hs2'))

private theorem FT.Dens.circle_sum_sheet_image (b : Bool) :
    (fun p : ℝ × ℝ => (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2)) ''
      {p : ℝ × ℝ | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
        0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))} =
    {y : ℝ × ℝ | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4} := by
  classical
  have angle_rep (x y : ℝ) (hxy : x ^ 2 + y ^ 2 = 1) :
      ∃ t ∈ Set.Ico 0 (2 * Real.pi), Real.cos t = x ∧ Real.sin t = y := by
    let z : ℂ := ⟨x, y⟩
    have hn : ‖z‖ = 1 := by
      have hs : ‖z‖ ^ 2 = 1 := by
        rw [Complex.sq_norm, Complex.normSq_apply]
        dsimp [z]
        nlinarith only [hxy]
      nlinarith only [hs, norm_nonneg z]
    have hc : Real.cos (Complex.arg z) = x := by
      simpa only [hn, one_mul] using Complex.norm_mul_cos_arg z
    have hs : Real.sin (Complex.arg z) = y := by
      simpa only [hn, one_mul] using Complex.norm_mul_sin_arg z
    by_cases ha : 0 ≤ Complex.arg z
    · exact ⟨Complex.arg z, ⟨ha, by linarith [Complex.arg_le_pi z, Real.pi_pos]⟩, hc, hs⟩
    · refine ⟨Complex.arg z + 2 * Real.pi, ⟨?_, ?_⟩, ?_, ?_⟩
      · linarith [Complex.neg_pi_lt_arg z, Real.pi_pos]
      · linarith
      · simpa [Real.cos_add] using hc
      · simpa [Real.sin_add] using hs
  ext y
  constructor
  · rintro ⟨p, ⟨hp1, hp2, hp3⟩, rfl⟩
    have hsn : Real.sin (p.1 - p.2) ≠ 0 := by
      intro h0
      cases b <;> simp [h0] at hp3
    have hN : (Real.cos p.1 + Real.cos p.2) ^ 2 + (Real.sin p.1 + Real.sin p.2) ^ 2 =
        2 + 2 * Real.cos (p.1 - p.2) := by
      rw [Real.cos_sub]
      nlinarith only [Real.sin_sq_add_cos_sq p.1, Real.sin_sq_add_cos_sq p.2]
    change 0 < (Real.cos p.1 + Real.cos p.2) ^ 2 + (Real.sin p.1 + Real.sin p.2) ^ 2 ∧ _
    constructor
    · by_contra h
      have hc : Real.cos (p.1 - p.2) = -1 := by
        nlinarith only [hN, not_lt.mp h, Real.neg_one_le_cos (p.1 - p.2)]
      have hs := Real.sin_sq_add_cos_sq (p.1 - p.2)
      rw [hc] at hs
      exact hsn (by nlinarith only [hs])
    · by_contra h
      have hc : Real.cos (p.1 - p.2) = 1 := by
        nlinarith only [hN, not_lt.mp h, Real.cos_le_one (p.1 - p.2)]
      have hs := Real.sin_sq_add_cos_sq (p.1 - p.2)
      rw [hc] at hs
      exact hsn (by nlinarith only [hs])
  · intro hy
    obtain ⟨hy0, hy4⟩ := hy
    let Q := y.1 ^ 2 + y.2 ^ 2
    have hQ : Q = y.1 ^ 2 + y.2 ^ 2 := rfl
    have hQ0 : 0 < Q := hy0
    have hQ4 : Q < 4 := hy4
    let t := Real.sqrt (4 - Q) / (2 * Real.sqrt Q)
    have ht : 0 < t := div_pos (Real.sqrt_pos.mpr (by linarith))
      (mul_pos (by norm_num) (Real.sqrt_pos.mpr hQ0))
    have htq : t ^ 2 * Q = (4 - Q) / 4 := by
      dsimp [t]
      rw [div_pow, mul_pow, Real.sq_sqrt hQ0.le, Real.sq_sqrt (by linarith : 0 ≤ 4 - Q)]
      field_simp
      ring
    let uc := y.1 / 2 - t * y.2
    let us := y.2 / 2 + t * y.1
    let vc := y.1 / 2 + t * y.2
    let vs := y.2 / 2 - t * y.1
    have haux := congrArg (fun z : ℝ => t ^ 2 * z) hQ
    have hu : uc ^ 2 + us ^ 2 = 1 := by
      dsimp [uc, us]
      nlinarith only [htq, hQ, haux]
    have hv : vc ^ 2 + vs ^ 2 = 1 := by
      dsimp [vc, vs]
      nlinarith only [htq, hQ, haux]
    obtain ⟨θ, hθm, hθc, hθs⟩ := angle_rep uc us hu
    obtain ⟨φ, hφm, hφc, hφs⟩ := angle_rep vc vs hv
    have hs : Real.sin (θ - φ) = t * Q := by
      rw [Real.sin_sub, hθs, hφc, hθc, hφs, hQ]
      dsimp [uc, us, vc, vs]
      ring
    have hyc : Real.cos θ + Real.cos φ = y.1 := by rw [hθc, hφc]; dsimp [uc, vc]; ring
    have hys : Real.sin θ + Real.sin φ = y.2 := by rw [hθs, hφs]; dsimp [us, vs]; ring
    cases b
    · refine ⟨(φ, θ), ⟨hφm, hθm, ?_⟩, ?_⟩
      · simp only [Bool.false_eq_true, ↓reduceIte]
        have he : φ - θ = -(θ - φ) := by ring
        rw [he, Real.sin_neg, neg_neg, hs]
        exact mul_pos ht hQ0
      · exact Prod.ext (by simpa only [add_comm] using hyc) (by simpa only [add_comm] using hys)
    · refine ⟨(θ, φ), ⟨hθm, hφm, ?_⟩, ?_⟩
      · simp only [↓reduceIte]
        rw [hs]
        exact mul_pos ht hQ0
      · exact Prod.ext hyc hys

private theorem FT.Dens.twoCircle_signed_change_of_variables (b : Bool) (h : ℝ × ℝ → ENNReal) :
    (∫⁻ y in {y : ℝ × ℝ | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4}, h y) =
    ∫⁻ p in {p : ℝ × ℝ | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
      0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))},
      ENNReal.ofReal |Real.sin (p.1 - p.2)| *
        h (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2) := by
  let S : Set (ℝ × ℝ) := {p | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧ p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
    0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))}
  have hs : MeasurableSet S := by cases b <;> dsimp [S] <;> measurability
  rw [← FT.Dens.circle_sum_sheet_image b]
  exact FT.Dens.twoCircle_change_of_variables S hs
    (FT.Dens.circle_sum_injective_sheet b) h


private noncomputable def FT.chart : Pt ≃ᵐ (ℝ × ℝ) :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

private theorem FT.chart_preserving : MeasurePreserving FT.chart :=
  (volume_preserving_finTwoArrow ℝ).comp (PiLp.volume_preserving_ofLp (Fin 2))

private theorem FT.chart_norm_sq (p : ℝ × ℝ) :
    ‖FT.chart.symm p‖ ^ 2 = p.1 ^ 2 + p.2 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
  rfl

private theorem FT.chart_sum (p : ℝ × ℝ) :
    FT.chart.symm (Real.cos p.1 + Real.cos p.2, Real.sin p.1 + Real.sin p.2) =
      circPt p.1 + circPt p.2 := by
  ext i
  fin_cases i <;> simp [FT.chart, circPt, e1, e2, EuclideanSpace.single_apply]

private theorem FT.region (p : ℝ × ℝ) :
    (0 < ‖FT.chart.symm p‖ ∧ ‖FT.chart.symm p‖ < 2) ↔
      (0 < p.1 ^ 2 + p.2 ^ 2 ∧ p.1 ^ 2 + p.2 ^ 2 < 4) := by
  have hn := norm_nonneg (FT.chart.symm p)
  have hs := FT.chart_norm_sq p
  constructor <;> rintro ⟨h0, h2⟩ <;> constructor <;> nlinarith

private theorem FT.a_measurable : Measurable C1.a := by
  unfold C1.a
  apply Measurable.ite
    ((measurableSet_lt measurable_const measurable_id).inter
      (measurableSet_lt measurable_id measurable_const))
  · exact measurable_const.div (measurable_id.mul
      (Real.continuous_sqrt.measurable.comp (measurable_const.sub (measurable_id.pow_const 2))))
  · exact measurable_const

private theorem FT.a_nonneg (r : ℝ) : 0 ≤ C1.a r := by
  unfold C1.a
  split_ifs with h
  · exact div_nonneg (by norm_num) (mul_nonneg h.1.le (Real.sqrt_nonneg _))
  · rfl

private theorem FT.sin_ne_ae : ∀ᵐ p : ℝ × ℝ, Real.sin (p.1 - p.2) ≠ 0 := by
  rw [Measure.volume_eq_prod]
  apply (Measure.ae_prod_iff_ae_ae (by measurability : MeasurableSet {p : ℝ × ℝ | Real.sin (p.1 - p.2) ≠ 0})).2
  apply Filter.Eventually.of_forall
  intro a
  have hc : Set.Countable {b : ℝ | Real.sin (a - b) = 0} := by
    refine (Set.countable_range (fun n : ℤ => a - n * Real.pi)).mono ?_
    intro b hb
    obtain ⟨n, hn⟩ := Real.sin_eq_zero_iff.mp hb
    exact ⟨n, by linarith⟩
  rw [ae_iff]
  simpa only [not_not] using hc.measure_zero (volume : Measure ℝ)

private theorem FT.jac_a (p : ℝ × ℝ) (hp : Real.sin (p.1 - p.2) ≠ 0) :
    ENNReal.ofReal |Real.sin (p.1 - p.2)| *
      ENNReal.ofReal (C1.a ‖circPt p.1 + circPt p.2‖) = 2 := by
  let r := ‖circPt p.1 + circPt p.2‖
  have hg := (FT.Dens.circle_sum_geometry p.1 p.2).2
  have hrn : 0 ≤ r := norm_nonneg _
  have hprod : 0 < r * Real.sqrt (4 - r ^ 2) := by
    have hpos := abs_pos.mpr hp
    change |Real.sin (p.1 - p.2)| = r * Real.sqrt (4 - r ^ 2) / 2 at hg
    linarith
  have hr : 0 < r := by nlinarith [Real.sqrt_nonneg (4 - r ^ 2)]
  have hs : 0 < Real.sqrt (4 - r ^ 2) := by nlinarith
  have hr2 : r < 2 := by
    have := Real.sqrt_pos.mp hs
    nlinarith
  have he : |Real.sin (p.1 - p.2)| * C1.a r = 2 := by
    rw [C1.a, if_pos ⟨hr, hr2⟩]
    change |Real.sin (p.1 - p.2)| = r * Real.sqrt (4 - r ^ 2) / 2 at hg
    rw [hg]
    field_simp [ne_of_gt hr, ne_of_gt hs]
    norm_num
  rw [← ENNReal.ofReal_mul (abs_nonneg _), he]
  norm_num

private theorem FT.circle_density :
    Measure.map (fun z : Pt × Pt => z.1 + z.2) (arcMeasure.prod arcMeasure) =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖)) := by
  classical
  let U : Set (ℝ × ℝ) := {y | 0 < y.1 ^ 2 + y.2 ^ 2 ∧ y.1 ^ 2 + y.2 ^ 2 < 4}
  let T : Set (ℝ × ℝ) := Set.Ico 0 (2 * Real.pi) ×ˢ Set.Ico 0 (2 * Real.pi)
  let S (b : Bool) : Set (ℝ × ℝ) := {p | p.1 ∈ Set.Ico 0 (2 * Real.pi) ∧
    p.2 ∈ Set.Ico 0 (2 * Real.pi) ∧
    0 < (if b then Real.sin (p.1 - p.2) else -Real.sin (p.1 - p.2))}
  have hU : MeasurableSet U := by dsimp [U]; measurability
  have hS (b : Bool) : MeasurableSet (S b) := by cases b <;> dsimp [S] <;> measurability
  have hT : MeasurableSet T := measurableSet_Ico.prod measurableSet_Ico
  refine Measure.ext_of_lintegral _ fun h hh => ?_
  let g : ℝ × ℝ → ENNReal := fun p => h (circPt p.1 + circPt p.2)
  let d : ℝ × ℝ → ENNReal := fun y => ENNReal.ofReal (C1.a ‖FT.chart.symm y‖) * h (FT.chart.symm y)
  have hd (y : ℝ × ℝ) : d y = U.indicator d y := by
    by_cases hy : y ∈ U
    · simp [hy]
    · have hr : ¬(0 < ‖FT.chart.symm y‖ ∧ ‖FT.chart.symm y‖ < 2) := by
        simpa only [FT.region, Set.mem_setOf_eq, U] using hy
      rw [Set.indicator_of_notMem hy]
      dsimp [d]
      rw [C1.a, if_neg hr]
      simp
  have hdU : (∫⁻ y : ℝ × ℝ, d y) = ∫⁻ y in U, d y := by
    rw [← lintegral_indicator hU]
    exact lintegral_congr hd
  have hsheet (b : Bool) : (∫⁻ y : ℝ × ℝ, d y) = 2 * ∫⁻ p in S b, g p := by
    rw [hdU, FT.Dens.twoCircle_signed_change_of_variables b]
    rw [← lintegral_const_mul' (2 : ENNReal) _ (by norm_num)]
    apply setLIntegral_congr_fun (hS b)
    intro p hp
    have hn : Real.sin (p.1 - p.2) ≠ 0 := by
      cases b <;> simp only [S, Set.mem_setOf_eq, Bool.false_eq_true, ite_false, ite_true] at hp <;> linarith [hp.2.2]
    dsimp [d, g]
    rw [FT.chart_sum, ← mul_assoc, FT.jac_a p hn]
  have hsum : (∫⁻ p in T, g p) = (∫⁻ p in S true, g p) + ∫⁻ p in S false, g p := by
    have hdisj : Disjoint (S true) (S false) := by
      refine Set.disjoint_left.mpr ?_
      intro p hp hq
      have hp' : 0 < Real.sin (p.1 - p.2) := hp.2.2
      have hq' : 0 < -Real.sin (p.1 - p.2) := hq.2.2
      linarith
    rw [← lintegral_union (hS false) hdisj]
    apply setLIntegral_congr
    filter_upwards [FT.sin_ne_ae] with p hp
    have hm : p ∈ T ↔ p ∈ S true ∪ S false := by
      simp only [T, S, Set.mem_prod, Set.mem_setOf_eq, Set.mem_union, ite_true, Bool.false_eq_true, ite_false]
      rcases lt_or_gt_of_ne hp with hneg | hpos
      · constructor
        · rintro ⟨h1, h2⟩; exact Or.inr ⟨h1, h2, by linarith⟩
        · rintro (⟨h1, h2, _⟩ | ⟨h1, h2, _⟩) <;> exact ⟨h1, h2⟩
      · constructor
        · rintro ⟨h1, h2⟩; exact Or.inl ⟨h1, h2, hpos⟩
        · rintro (⟨h1, h2, _⟩ | ⟨h1, h2, _⟩) <;> exact ⟨h1, h2⟩
    exact propext hm
  have hmain : (∫⁻ p in T, g p) = ∫⁻ y : ℝ × ℝ, d y := by
    apply (ENNReal.mul_left_inj (by norm_num : (2 : ENNReal) ≠ 0) (by norm_num : (2 : ENNReal) ≠ ⊤)).mp
    rw [mul_comm _ 2, mul_comm _ 2, hsum, mul_add, ← hsheet true, ← hsheet false, two_mul]
  have hc : Measurable circPt := by unfold circPt; fun_prop
  have ha : Measurable (fun z : Pt × Pt => z.1 + z.2) := measurable_fst.add measurable_snd
  calc
    _ = ∫⁻ z : Pt × Pt, h (z.1 + z.2) ∂(arcMeasure.prod arcMeasure) := lintegral_map hh ha
    _ = ∫⁻ p in T, g p := by
      rw [arcMeasure, Measure.map_prod_map _ _ hc hc]
      calc
        _ = ∫⁻ p : ℝ × ℝ, h (circPt p.1 + circPt p.2)
            ∂((volume.restrict (Set.Ico 0 (2 * Real.pi))).prod
              (volume.restrict (Set.Ico 0 (2 * Real.pi)))) :=
          lintegral_map (f := fun z : Pt × Pt => h (z.1 + z.2)) (hh.comp ha) (hc.prodMap hc)
        _ = _ := by rw [Measure.prod_restrict]; rfl
    _ = ∫⁻ y : ℝ × ℝ, d y := hmain
    _ = ∫⁻ y : Pt, ENNReal.ofReal (C1.a ‖y‖) * h y := by
      exact (FT.chart_preserving.symm.lintegral_map_equiv
        (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖) * h y) FT.chart.symm).symm
    _ = _ := (lintegral_withDensity_eq_lintegral_mul volume
      (FT.a_measurable.comp measurable_norm).ennreal_ofReal hh).symm

private theorem FT.b_measurable : Measurable C1.b := by
  unfold C1.b
  apply Measurable.ite
    ((measurableSet_lt measurable_const measurable_id).inter
      (measurableSet_lt measurable_id measurable_const))
  · have h : Continuous (fun r : ℝ => 2 * Real.arccos (r / 2)) := by fun_prop
    exact h.measurable
  · exact measurable_const

private theorem FT.c_measurable : Measurable C1.c := by
  unfold C1.c
  apply Measurable.ite
    ((measurableSet_lt measurable_const measurable_id).inter
      (measurableSet_lt measurable_id measurable_const))
  · have h : Continuous lensArea := by unfold lensArea; fun_prop
    exact h.measurable
  · exact measurable_const

private theorem FT.b_nonneg (r : ℝ) : 0 ≤ C1.b r := by
  unfold C1.b
  split_ifs
  · exact mul_nonneg (by norm_num) (Real.arccos_nonneg _)
  · rfl

private theorem FT.c_nonneg (r : ℝ) : 0 ≤ C1.c r := by
  unfold C1.c
  split_ifs with hr
  · rw [← HardDiskB5.LensAreaFormula r hr.1.le hr.2.le]
    exact ENNReal.toReal_nonneg
  · rfl

private theorem FT.step_finite (b : Bool) : IsFiniteMeasure (stepLaw b) := by
  cases b
  · change IsFiniteMeasure arcMeasure
    unfold arcMeasure
    infer_instance
  · change IsFiniteMeasure (volume.restrict (disk (0 : Pt)))
    exact ⟨by simpa only [Measure.restrict_apply_univ, disk] using
      (measure_ball_lt_top (x := (0 : Pt)) (r := (1 : ℝ)))⟩

private theorem FT.density (b₁ b₂ : Bool) :
    Measure.map (fun z : Pt × Pt => z.1 + z.2) ((stepLaw b₁).prod (stepLaw b₂)) =
      volume.withDensity (fun y : Pt => ENNReal.ofReal (pairDensity b₁ b₂ ‖y‖)) := by
  cases b₁ <;> cases b₂
  · simpa [stepLaw, pairDensity] using FT.circle_density
  · exact FT.Dens.mixed false true (by decide)
  · exact FT.Dens.mixed true false (by decide)
  · exact FT.Dens.disk_disk

private theorem FT.density_integrable {μ ν : Measure Pt} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (f : Pt → ℝ) (hf : Measurable f) (hf0 : ∀ x, 0 ≤ f x)
    (hd : Measure.map (fun z : Pt × Pt => z.1 + z.2) (μ.prod ν) =
      volume.withDensity (fun x => ENNReal.ofReal (f x))) : Integrable f := by
  haveI : IsFiniteMeasure (volume.withDensity (fun x => ENNReal.ofReal (f x))) := by
    rw [← hd]
    infer_instance
  refine ⟨hf.aestronglyMeasurable, (hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall hf0)).2 ?_⟩
  have hmass : (∫⁻ x, ENNReal.ofReal (f x)) =
      (volume.withDensity (fun x => ENNReal.ofReal (f x))) Set.univ := by
    rw [withDensity_apply _ MeasurableSet.univ]
    simp only [Measure.restrict_univ]
  rw [hmass]
  exact measure_lt_top _ _

private noncomputable def FT.wave (ξ x : Pt) : ℂ :=
  Complex.exp (-(Complex.I * (inner ℝ x ξ : ℝ)))

private theorem FT.wave_continuous (ξ : Pt) : Continuous (FT.wave ξ) := by
  unfold FT.wave
  fun_prop

private theorem FT.wave_add (ξ x y : Pt) : FT.wave ξ (x + y) = FT.wave ξ x * FT.wave ξ y := by
  simp only [FT.wave, inner_add_left, Complex.ofReal_add, mul_add, neg_add, Complex.exp_add]

private theorem FT.pair_fourier {μ ν : Measure Pt} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (f : Pt → ℝ) (hf : Measurable f) (hf0 : ∀ x, 0 ≤ f x)
    (hd : Measure.map (fun z : Pt × Pt => z.1 + z.2) (μ.prod ν) =
      volume.withDensity (fun x => ENNReal.ofReal (f x))) (ξ : Pt) :
    (∫ x, FT.wave ξ x * (f x : ℂ)) =
      (∫ x, FT.wave ξ x ∂μ) * ∫ y, FT.wave ξ y ∂ν := by
  have ha : Measurable (fun z : Pt × Pt => z.1 + z.2) := measurable_fst.add measurable_snd
  calc
    _ = ∫ x, FT.wave ξ x ∂volume.withDensity (fun x => ENNReal.ofReal (f x)) := by
      rw [integral_withDensity_eq_integral_toReal_smul hf.ennreal_ofReal
        (Filter.Eventually.of_forall (fun x => ENNReal.ofReal_lt_top))]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by
        dsimp only
        rw [ENNReal.toReal_ofReal (hf0 x)]
        simp only [Complex.real_smul, mul_comm]
    _ = ∫ z : Pt × Pt, FT.wave ξ (z.1 + z.2) ∂μ.prod ν := by
      rw [← hd]
      exact integral_map ha.aemeasurable (FT.wave_continuous ξ).aestronglyMeasurable
    _ = ∫ z : Pt × Pt, FT.wave ξ z.1 * FT.wave ξ z.2 ∂μ.prod ν := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun z => FT.wave_add ξ z.1 z.2
    _ = _ := integral_prod_mul _ _

private theorem FT.J0_neg (k : ℝ) : J0 (-k) = J0 k := by
  unfold J0
  congr 1
  apply intervalIntegral.integral_congr
  intro t ht
  simp only [neg_mul, Real.cos_neg]

private theorem FT.J1_neg (k : ℝ) : J1 (-k) = -J1 k := by
  unfold J1
  simp only [neg_mul, Real.sin_neg, mul_neg, intervalIntegral.integral_neg, neg_div]

private theorem FT.J0_abs (k : ℝ) : J0 |k| = J0 k := by
  by_cases hk : 0 ≤ k
  · rw [abs_of_nonneg hk]
  · rw [abs_of_neg (lt_of_not_ge hk), FT.J0_neg]

private theorem FT.J1_ratio_abs (k : ℝ) : J1 |k| / |k| = J1 k / k := by
  by_cases hk : 0 ≤ k
  · rw [abs_of_nonneg hk]
  · rw [abs_of_neg (lt_of_not_ge hk), FT.J1_neg, neg_div_neg_eq]

private theorem FT.hankel_abs (f : ℝ → ℝ) (k : ℝ) : hankel f |k| = hankel f k := by
  unfold hankel
  apply integral_congr_ae
  exact Filter.Eventually.of_forall fun r => by
    dsimp only
    by_cases hk : 0 ≤ k
    · rw [abs_of_nonneg hk]
    · rw [abs_of_neg (lt_of_not_ge hk), neg_mul, FT.J0_neg]

private theorem FT.axis_norm (k : ℝ) : ‖k • e1‖ = |k| := by
  simp [norm_smul, e1]

private theorem FT.axis_ne {k : ℝ} (hk : k ≠ 0) : k • e1 ≠ 0 := by
  intro h
  have h' := congrArg norm h
  rw [FT.axis_norm, norm_zero, abs_eq_zero] at h'
  exact hk h'

private theorem FT.from_pair {μ ν : Measure Pt} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (f : ℝ → ℝ) (hf : Measurable f) (hf0 : ∀ r, 0 ≤ f r)
    (hd : Measure.map (fun z : Pt × Pt => z.1 + z.2) (μ.prod ν) =
      volume.withDensity (fun x => ENNReal.ofReal (f ‖x‖))) (ξ : Pt) :
    ((2 * Real.pi * hankel f ‖ξ‖ : ℝ) : ℂ) =
      (∫ x, FT.wave ξ x ∂μ) * ∫ y, FT.wave ξ y ∂ν := by
  have hfi : Integrable (fun x : Pt => f ‖x‖) :=
    FT.density_integrable (fun x : Pt => f ‖x‖) (hf.comp measurable_norm)
      (fun x => hf0 ‖x‖) hd
  rw [← (HardDiskB5.C3.radial_fourier f hfi).1 ξ]
  exact FT.pair_fourier (fun x : Pt => f ‖x‖) (hf.comp measurable_norm)
    (fun x => hf0 ‖x‖) hd ξ

theorem solution_s12568909 :
    (∀ k : ℝ, hankel C1.a k = 2 * Real.pi * J0 k ^ 2) ∧
    (∀ k : ℝ, k ≠ 0 → hankel C1.b k = 2 * Real.pi * J0 k * J1 k / k) ∧
    (∀ k : ℝ, k ≠ 0 → hankel C1.c k = 2 * Real.pi * J1 k ^ 2 / k ^ 2) := by
  haveI : IsFiniteMeasure arcMeasure := by unfold arcMeasure; infer_instance
  haveI : IsFiniteMeasure (volume.restrict (disk (0 : Pt))) := FT.step_finite true
  have hp : (2 * Real.pi : ℝ) ≠ 0 := mul_ne_zero (by norm_num) Real.pi_ne_zero
  refine ⟨?_, ?_, ?_⟩
  · intro k
    have he := FT.from_pair C1.a FT.a_measurable FT.a_nonneg FT.circle_density (k • e1)
    change ((2 * Real.pi * hankel C1.a ‖k • e1‖ : ℝ) : ℂ) = _ at he
    change _ = (∫ x, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ))) ∂arcMeasure) *
      ∫ x, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ))) ∂arcMeasure at he
    rw [HardDiskB5.C3.circle_fourier, FT.axis_norm] at he
    have hr : 2 * Real.pi * hankel C1.a |k| =
        (2 * Real.pi * J0 |k|) * (2 * Real.pi * J0 |k|) := by exact_mod_cast he
    rw [FT.hankel_abs, FT.J0_abs] at hr
    apply mul_left_cancel₀ hp
    calc
      (2 * Real.pi) * hankel C1.a k = _ := hr
      _ = (2 * Real.pi) * (2 * Real.pi * J0 k ^ 2) := by ring
  · intro k hk
    have hd : Measure.map (fun z : Pt × Pt => z.1 + z.2)
        (arcMeasure.prod (volume.restrict (disk 0))) =
        volume.withDensity (fun x : Pt => ENNReal.ofReal (C1.b ‖x‖)) := by
      simpa [stepLaw, pairDensity] using FT.Dens.mixed false true (by decide)
    have he := FT.from_pair C1.b FT.b_measurable FT.b_nonneg hd (k • e1)
    change _ = (∫ x, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ))) ∂arcMeasure) *
      ∫ x in disk 0, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ))) at he
    rw [HardDiskB5.C3.circle_fourier, HardDiskB5.C3.disk_fourier _ (FT.axis_ne hk), FT.axis_norm] at he
    have hr : 2 * Real.pi * hankel C1.b |k| =
        (2 * Real.pi * J0 |k|) * (2 * Real.pi * J1 |k| / |k|) := by exact_mod_cast he
    rw [FT.hankel_abs, FT.J0_abs, mul_div_assoc, FT.J1_ratio_abs] at hr
    apply mul_left_cancel₀ hp
    calc
      (2 * Real.pi) * hankel C1.b k = _ := hr
      _ = (2 * Real.pi) * (2 * Real.pi * J0 k * J1 k / k) := by ring
  · intro k hk
    have hd : Measure.map (fun z : Pt × Pt => z.1 + z.2)
        ((volume.restrict (disk 0)).prod (volume.restrict (disk 0))) =
        volume.withDensity (fun x : Pt => ENNReal.ofReal (C1.c ‖x‖)) := by
      simpa [stepLaw, pairDensity] using FT.Dens.disk_disk
    have he := FT.from_pair C1.c FT.c_measurable FT.c_nonneg hd (k • e1)
    change _ = (∫ x in disk 0, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ)))) *
      ∫ x in disk 0, Complex.exp (-(Complex.I * (inner ℝ x (k • e1) : ℝ))) at he
    rw [HardDiskB5.C3.disk_fourier _ (FT.axis_ne hk), FT.axis_norm] at he
    have hr : 2 * Real.pi * hankel C1.c |k| =
        (2 * Real.pi * J1 |k| / |k|) * (2 * Real.pi * J1 |k| / |k|) := by exact_mod_cast he
    simp only [FT.hankel_abs, mul_div_assoc, FT.J1_ratio_abs] at hr
    have hval : hankel C1.c k = 2 * Real.pi * (J1 k / k) ^ 2 := by
      apply mul_left_cancel₀ hp
      calc
        (2 * Real.pi) * hankel C1.c k = _ := hr
        _ = (2 * Real.pi) * (2 * Real.pi * (J1 k / k) ^ 2) := by ring
    simpa only [div_pow, mul_div_assoc] using hval
