private theorem FT.Dens.arc_disk_axis (r : ℝ) (hr0 : 0 < r) (hr2 : r < 2) :
    arcMeasure (disk (r • e1)) = ENNReal.ofReal (2 * Real.arccos (r / 2)) := by
  classical
  let a := Real.arccos (r / 2)
  have ha0 : 0 < a := Real.arccos_pos.mpr (by linarith)
  have haπ : a < Real.pi := Real.arccos_lt_pi.mpr (by linarith)
  have hca : Real.cos a = r / 2 := Real.cos_arccos (by linarith) (by linarith)
  have hc (t : ℝ) (ht0 : 0 ≤ t) (htπ : t ≤ Real.pi) :
      (r / 2 < Real.cos t) ↔ t < a := by
    rw [← hca]
    constructor
    · intro h
      by_contra hn
      have hh := Real.cos_le_cos_of_nonneg_of_le_pi ha0.le htπ (le_of_not_gt hn)
      linarith
    · intro h
      exact Real.cos_lt_cos_of_nonneg_of_le_pi ht0 haπ.le h
  have hm (t : ℝ) : circPt t ∈ disk (r • e1) ↔ r / 2 < Real.cos t := by
    have hsq : ‖circPt t - r • e1‖ ^ 2 = 1 + r ^ 2 - 2 * r * Real.cos t := by
      rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]
      simp [circPt, e1, e2]
      nlinarith [Real.sin_sq_add_cos_sq t]
    change dist (circPt t) (r • e1) < 1 ↔ _
    rw [dist_eq_norm]
    constructor
    · intro h
      have hlt : ‖circPt t - r • e1‖ ^ 2 < 1 := by nlinarith [norm_nonneg (circPt t - r • e1)]
      nlinarith
    · intro h
      have hlt : ‖circPt t - r • e1‖ ^ 2 < 1 := by nlinarith
      nlinarith [norm_nonneg (circPt t - r • e1)]
  have hs : (circPt ⁻¹' disk (r • e1)) ∩ Set.Ico 0 (2 * Real.pi) =
      Set.Ico 0 a ∪ Set.Ioo (2 * Real.pi - a) (2 * Real.pi) := by
    ext t
    simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_Ico, Set.mem_union, Set.mem_Ioo, hm]
    constructor
    · rintro ⟨hcos, ht0, ht2π⟩
      by_cases htπ : t ≤ Real.pi
      · exact Or.inl ⟨ht0, (hc t ht0 htπ).mp hcos⟩
      · have hcos' : r / 2 < Real.cos (2 * Real.pi - t) := by
          simpa [Real.cos_sub] using hcos
        have hlt := (hc (2 * Real.pi - t) (by linarith) (by linarith)).mp hcos'
        exact Or.inr ⟨by linarith, ht2π⟩
    · rintro (⟨ht0, hta⟩ | ⟨htlo, hthi⟩)
      · exact ⟨(hc t ht0 (by linarith)).mpr hta, ht0, by linarith⟩
      · have hcos' := (hc (2 * Real.pi - t) (by linarith) (by linarith)).mpr (by linarith)
        refine ⟨?_, by linarith, hthi⟩
        simpa [Real.cos_sub] using hcos'
  have hmeas : Measurable circPt := by unfold circPt; fun_prop
  have hD : MeasurableSet (disk (r • e1)) := Metric.isOpen_ball.measurableSet
  have hpre : MeasurableSet (circPt ⁻¹' disk (r • e1)) := hmeas hD
  rw [arcMeasure, Measure.map_apply hmeas hD, Measure.restrict_apply hpre, hs]
  have hdisj : Disjoint (Set.Ico 0 a) (Set.Ioo (2 * Real.pi - a) (2 * Real.pi)) := by
    refine Set.disjoint_left.mpr ?_
    intro t ht ht'
    have h1 := ht.2
    have h2 := ht'.1
    linarith
  rw [measure_union hdisj measurableSet_Ioo, Real.volume_Ico, Real.volume_Ioo]
  rw [sub_zero, show 2 * Real.pi - (2 * Real.pi - a) = a by ring,
    ← ENNReal.ofReal_add ha0.le ha0.le]
  congr 1
  dsimp [a]
  ring

private theorem FT.Dens.periodic_lintegral_shift (T : ℝ) (hT : 0 < T) (f : ℝ → ENNReal)
    (hf : Function.Periodic f T) (c : ℝ) :
    (∫⁻ x in Set.Ico 0 T, f (x + c)) = ∫⁻ x in Set.Ico 0 T, f x := by
