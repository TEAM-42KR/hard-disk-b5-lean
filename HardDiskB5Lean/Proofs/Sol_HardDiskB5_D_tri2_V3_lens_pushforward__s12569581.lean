  funext p
  by_cases hb : p ∈ HDLens4.box
  · by_cases hd : 0 < HDLens4.delta p
    · have ht : p ∈ HDLens4.tri := ⟨hb.1, hb.2.1, hb.2.2.1, hb.2.2.2, hd⟩
      simp only [Set.indicator_of_mem ht, Set.indicator_of_mem hb]
