  measurable_toFun := measurable_fst.neg.prodMk
    (measurable_pi_lambda _ fun k =>
      ((measurable_pi_apply _).comp measurable_snd).sub measurable_fst)
  measurable_invFun := measurable_fst.neg.prodMk
    (measurable_pi_lambda _ fun k =>
      ((measurable_pi_apply _).comp measurable_snd).sub measurable_fst)

private lemma repin_mp (a b : Fin 5) : MeasurePreserving (repin a b) volume volume := by
  let et := MeasurableEquiv.piCongrLeft (fun _ => Pt) (swapTail a b)
  have het : MeasurePreserving et volume volume :=
    volume_measurePreserving_piCongrLeft (fun _ => Pt) (swapTail a b)
  change MeasurePreserving
    (fun z : Pt × ({k : Fin 5 // k ≠ a ∧ k ≠ b} → Pt) =>
      (-z.1, fun k : {k : Fin 5 // k ≠ b ∧ k ≠ a} =>
        z.2 ⟨k.val,k.property.2,k.property.1⟩ - z.1))
    ((volume : Measure Pt).prod volume) ((volume : Measure Pt).prod volume)
  refine (Measure.measurePreserving_neg (volume : Measure Pt)).skew_product
    (μc := (volume : Measure ({k : Fin 5 // k ≠ a ∧ k ≠ b} → Pt)))
    (μd := (volume : Measure ({k : Fin 5 // k ≠ b ∧ k ≠ a} → Pt)))
    (g := fun (p : Pt) (y : {k : Fin 5 // k ≠ a ∧ k ≠ b} → Pt)
      (k : {k : Fin 5 // k ≠ b ∧ k ≠ a}) => y ⟨k.val,k.property.2,k.property.1⟩ - p) ?_ ?_
  · exact measurable_pi_lambda _ fun k =>
      ((measurable_pi_apply _).comp measurable_snd).sub measurable_fst
  · apply Filter.Eventually.of_forall
    intro p
    exact ((measurePreserving_sub_right
      (volume : Measure ({k : Fin 5 // k ≠ b ∧ k ≠ a} → Pt)) (fun _ => p)).comp het).map_eq

private lemma cw_translate {m : ℕ} (H : SimpleGraph (Fin m)) (x : Fin m → Pt) (p : Pt) :
    contactWeight H ⊥ (fun k => x k - p) = contactWeight H ⊥ x := by
  have hd (a b : Fin m) : dist (x a - p) (x b - p) = dist (x a) (x b) := by
    simp only [dist_eq_norm]
    congr 1
    abel
  simp [contactWeight, pairFactor, ovl, hd]

private lemma pinConfig_repin (a b : Fin 5) (hab : a ≠ b)
    (z : Pt × ({k : Fin 5 // k ≠ a ∧ k ≠ b} → Pt)) :
    pinConfig b a ((repin a b) z).1 ((repin a b) z).2 =
      fun k => pinConfig a b z.1 z.2 k - z.1 := by
  funext k
  by_cases hka : k = a
  · subst k
    simp [pinConfig, hab, repin]
  by_cases hkb : k = b
  · subst k
    simp [pinConfig, hab.symm, repin]
  · simp [pinConfig, hka, hkb, repin]

private lemma AV_repin (H : SimpleGraph (Fin 5)) (a b : Fin 5) (hab : a ≠ b) :
    AV H a = AV H b := by
  rw [anchor_split H a b hab, anchor_split H b a hab.symm]
  calc
    _ = ∫ z : Pt × ({k : Fin 5 // k ≠ a ∧ k ≠ b} → Pt),
      contactWeight H ⊥ (pinConfig b a ((repin a b) z).1 ((repin a b) z).2) := by
      apply integral_congr_ae
      filter_upwards with z
      rw [pinConfig_repin a b hab, cw_translate]
    _ = _ := (repin_mp a b).integral_comp'
      (fun z => contactWeight H ⊥ (pinConfig b a z.1 z.2))

private def zeroTailEquiv : Fin 4 ≃ {k : Fin 5 // k ≠ 0} where
  toFun k := ⟨k.succ, Fin.succ_ne_zero k⟩
  invFun k := k.val.pred k.property
  left_inv k := Fin.pred_succ k
  right_inv k := Subtype.ext (Fin.succ_pred k.val k.property)

private lemma AV_zero (H : SimpleGraph (Fin 5)) : AV H 0 = VH (n := 4) H := by
  let e : (Fin 4 → Pt) ≃ᵐ ({k : Fin 5 // k ≠ 0} → Pt) :=
    MeasurableEquiv.piCongrLeft (fun _ => Pt) zeroTailEquiv
  have he : MeasurePreserving e volume volume :=
    volume_measurePreserving_piCongrLeft (fun _ => Pt) zeroTailEquiv
  unfold AV VH VHF
  rw [← he.integral_comp']
  apply integral_congr_ae
  filter_upwards with y
  congr 1
  funext k
  refine Fin.cases ?_ (fun k => ?_) k
  · simp [anchored]
  · simp only [anchored, dif_neg (Fin.succ_ne_zero k), Fin.cons_succ]
    exact MeasurableEquiv.piCongrLeft_apply_apply zeroTailEquiv (β := fun _ => Pt) y k

private lemma anchored_integrable (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) (r : Fin 5) :
    Integrable (fun y : {k : Fin 5 // k ≠ r} → Pt => contactWeight H ⊥ (anchored r y)) := by
  refine compact_integrable _ ?_ ?_ 4 (by norm_num) ?_
  · apply cw_measurable
    intro k
    unfold anchored
    split_ifs <;> fun_prop
  · intro y
    rw [Real.norm_eq_abs, abs_of_nonneg (cw_bounds H _).1]
    exact (cw_bounds H _).2
  · intro y hy k
    have hk := cw_anchor_support H i j hij hpol r (anchored r y)
      (by simp [anchored]) hy k
    simpa [anchored, k.property] using hk.le

private lemma pin_integrable (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) :
    Integrable (fun z : Pt × ({k : Fin 5 // k ≠ i ∧ k ≠ j} → Pt) =>
      contactWeight H ⊥ (pinConfig i j z.1 z.2)) := by
  have ht := ((doubleSplit_mp i j hij).symm (doubleSplit i j hij)).integrable_comp_of_integrable
    (anchored_integrable H i j hij hpol i)
  simpa only [Function.comp_def, anchored_doubleSplit] using ht

private lemma plane_disintegration (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) :
    VH (n := 4) H = ∫ p : Pt,
      (if H.Adj i j then ovl 0 p else 1) * Vpin H ⊥ i j p := by
  have hv : VH (n := 4) H = AV H i := by
    rw [← AV_zero H]
    by_cases hi : (0 : Fin 5) = i
    · rw [hi]
    · exact AV_repin H 0 i hi
  rw [hv, anchor_split H i j hij]
  change (∫ z : Pt × ({k : Fin 5 // k ≠ i ∧ k ≠ j} → Pt),
    contactWeight H ⊥ (pinConfig i j z.1 z.2) ∂(volume : Measure Pt).prod volume) = _
  rw [integral_prod _ (pin_integrable H i j hij hpol)]
  apply integral_congr_ae
  filter_upwards with p
  have hc (y : {k : Fin 5 // k ≠ i ∧ k ≠ j} → Pt) :
      contactWeight H ⊥ (pinConfig i j p y) =
        (if H.Adj i j then ovl 0 p else 1) * contactWeightExcept H ⊥ i j (pinConfig i j p y) := by
    rw [cw_extract H i j hij]
    simp [pinConfig, hij.symm]
  simp_rw [hc]
  rw [integral_const_mul]
  rfl

private lemma unit_ball_real : (volume : Measure Pt).real (Metric.ball 0 1) = Real.pi := by
  have hv := InnerProductSpace.volume_ball_of_dim_even (E := Pt) (k := 1)
    (by simp [finrank_euclideanSpace]) (0 : Pt) (1 : ℝ)
  simpa [Measure.real, Real.pi_nonneg] using congrArg ENNReal.toReal hv

private lemma polar_Ioi (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) :
    VH (n := 4) H = 2 * Real.pi * ∫ lam in Set.Ioi (0 : ℝ),
      lam * ((if H.Adj i j then (if lam < 1 then 1 else 0 : ℝ) else 1) *
        Vpin H ⊥ i j (lam • e1)) := by
  rw [plane_disintegration H i j hij hpol]
  have hr : (fun p : Pt => (if H.Adj i j then ovl 0 p else 1) * Vpin H ⊥ i j p) =
      fun p : Pt => (if H.Adj i j then (if ‖p‖ < 1 then 1 else 0 : ℝ) else 1) *
        Vpin H ⊥ i j (‖p‖ • e1) := by
    funext p
    rw [vp_radial H i j p]
    simp only [ovl, dist_zero_left]
  rw [hr]
  simpa only [finrank_euclideanSpace, Fintype.card_fin, unit_ball_real,
    Nat.reduceSub, pow_one, nsmul_eq_mul, Nat.cast_ofNat, smul_eq_mul, mul_assoc] using
      integral_fun_norm_addHaar (volume : Measure Pt) (fun lam : ℝ =>
        (if H.Adj i j then (if lam < 1 then 1 else 0 : ℝ) else 1) *
          Vpin H ⊥ i j (lam • e1))

private lemma radial_truncate (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) :
    (∫ lam in Set.Ioi (0 : ℝ),
      lam * ((if H.Adj i j then (if lam < 1 then 1 else 0 : ℝ) else 1) *
        Vpin H ⊥ i j (lam • e1))) =
      ∫ lam in (0 : ℝ)..(if H.Adj i j then 1 else 2), lam * Vpin H ⊥ i j (lam • e1) := by
  let r : ℝ := if H.Adj i j then 1 else 2
  have hr : 0 ≤ r := by dsimp [r]; split_ifs <;> norm_num
  change (∫ lam in Set.Ioi (0 : ℝ),
      lam * ((if H.Adj i j then (if lam < 1 then 1 else 0 : ℝ) else 1) *
        Vpin H ⊥ i j (lam • e1))) = ∫ lam in (0 : ℝ)..r, lam * Vpin H ⊥ i j (lam • e1)
  rw [intervalIntegral.integral_of_le hr, integral_Ioc_eq_integral_Ioo]
  calc
    _ = ∫ lam in Set.Ioo (0 : ℝ) r,
        lam * ((if H.Adj i j then (if lam < 1 then 1 else 0 : ℝ) else 1) *
          Vpin H ⊥ i j (lam • e1)) := by
      apply setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
        (fun lam h => h.1)
      intro lam h
      have hnonneg : 0 ≤ lam := h.1.le
      have hrle : r ≤ lam := le_of_not_gt (by
        intro hl
        exact h.2 ⟨h.1,hl⟩)
      by_cases ha : H.Adj i j
      · have hl : ¬lam < 1 := not_lt_of_ge (by simpa only [r, ha, ite_true] using hrle)
        simp only [ha, ite_true, hl, ite_false, zero_mul, mul_zero]
      · have hl : 2 ≤ lam := by simpa only [r, ha, ite_false] using hrle
        have hp : 2 ≤ ‖lam • e1‖ := by
          simpa only [norm_smul, e1_norm, Real.norm_eq_abs, abs_of_nonneg hnonneg, mul_one] using hl
        rw [vp_zero H i j hij hpol _ hp]
        simp only [mul_zero]
    _ = _ := by
      apply setIntegral_congr_fun measurableSet_Ioo
      intro lam h
      by_cases ha : H.Adj i j
      · have hl : lam < 1 := by simpa only [r, ha, ite_true] using h.2
        simp only [ha, ite_true, hl, one_mul]
      · simp only [ha, ite_false, one_mul]

theorem solution_s12568727 (H : SimpleGraph (Fin 5)) (i j : Fin 5) (hij : i ≠ j)
    (hpol : ∀ k : Fin 5, k ≠ i → k ≠ j → H.Adj i k ∧ H.Adj j k) :
    VH (n := 4) H = 2 * Real.pi *
      ∫ lam in (0 : ℝ)..(if H.Adj i j then 1 else 2), lam * Vpin H ⊥ i j (lam • e1) := by
  rw [polar_Ioi H i j hij hpol, radial_truncate H i j hij hpol]
