      simp only [C1.b, h0, h2, and_self, ite_true]
    · have hemp : {t : ℝ | t ∈ Set.Ioo 0 (2 * Real.pi) ∧ ‖c - circPt t‖ < 1} = ∅ := by
        apply Set.eq_empty_iff_forall_notMem.mpr
        intro t ht
        have hle := norm_add_le (circPt t) (c - circPt t)
        have he : circPt t + (c - circPt t) = c := by abel
        rw [he, k1_circ_unit] at hle
        linarith [ht.2]
      rw [hemp]
      simp [C1.b, h2]
  · have hc : c = 0 := norm_eq_zero.mp (le_antisymm (le_of_not_gt h0) (norm_nonneg _))
    subst c
    have hemp : {t : ℝ | t ∈ Set.Ioo 0 (2 * Real.pi) ∧ ‖(0 : Pt) - circPt t‖ < 1} = ∅ := by
      ext t
      simp [k1_circ_unit]
    rw [hemp]
    simp [C1.b]

private def k1_mu : Measure ℝ := volume.restrict (Set.Ioo 0 (2 * Real.pi))
private instance k1_mu_finite : IsFiniteMeasure k1_mu := by unfold k1_mu; infer_instance

private def k1_sum (z : ℝ × ℝ) : Pt := circPt z.1 + circPt z.2
private theorem k1_sum_meas : Measurable k1_sum :=
  (k1_circ_meas.comp measurable_fst).add (k1_circ_meas.comp measurable_snd)

private def k1_density : Measure Pt :=
  volume.withDensity (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖))

private theorem k1_pair_map : Measure.map k1_sum (k1_mu.prod k1_mu) = k1_density := by
  have hm : Measure.map circPt k1_mu = arcMeasure := by
    rw [k1_mu, restrict_Ioo_eq_restrict_Ico]
    rfl
  have hprod := Measure.map_prod_map k1_mu k1_mu k1_circ_meas k1_circ_meas
  rw [hm] at hprod
  have hadd : Measurable (fun z : Pt × Pt => z.1 + z.2) := measurable_fst.add measurable_snd
  calc
    _ = Measure.map (fun z : Pt × Pt => z.1 + z.2)
        (Measure.map (Prod.map circPt circPt) (k1_mu.prod k1_mu)) :=
      (Measure.map_map hadd (k1_circ_meas.prodMap k1_circ_meas)).symm
    _ = Measure.map (fun z : Pt × Pt => z.1 + z.2) (arcMeasure.prod arcMeasure) := by rw [← hprod]
    _ = k1_density := by
      simpa only [stepLaw, Bool.false_eq_true, if_false, pairDensity, Bool.false_and,
        Bool.false_or, k1_density] using HardDiskB5.Shared.B_eq3_2_densities false false

private theorem k1_pair_g_integrable :
    Integrable (fun z : ℝ × ℝ => k1_g (k1_sum z)) (k1_mu.prod k1_mu) :=
  Integrable.of_bound (k1_g_meas.comp k1_sum_meas).aestronglyMeasurable (4 * Real.pi)
    (Filter.Eventually.of_forall (fun z => k1_g_bound (k1_sum z)))

private theorem k1_pair_reduction : Integrable k1_f ∧
    (∫ z : ℝ × ℝ, k1_g (k1_sum z) ∂(k1_mu.prod k1_mu)) = ∫ y : Pt, k1_f y := by
  have hd : Measurable (fun y : Pt => ENNReal.ofReal (C1.a ‖y‖)) :=
    (k1_a_meas.comp measurable_norm).ennreal_ofReal
  have ht : ∀ᵐ y : Pt, ENNReal.ofReal (C1.a ‖y‖) < ⊤ :=
    Filter.Eventually.of_forall (fun _ => ENNReal.ofReal_lt_top)
  have hgint : Integrable k1_g k1_density := by
    rw [← k1_pair_map]
    exact (integrable_map_measure k1_g_meas.aestronglyMeasurable k1_sum_meas.aemeasurable).2
      k1_pair_g_integrable
  have hf : Integrable k1_f := by
    apply ((integrable_withDensity_iff_integrable_smul'
      (μ := (volume : Measure Pt)) hd ht).1 hgint).congr
    filter_upwards [] with y
    change (ENNReal.ofReal (C1.a ‖y‖)).toReal * k1_g y = C1.a ‖y‖ * k1_g y
    rw [ENNReal.toReal_ofReal (k1_a_nonneg ‖y‖)]
  refine ⟨hf, ?_⟩
  calc
    _ = ∫ y : Pt, k1_g y ∂k1_density := by
      rw [← k1_pair_map]
      exact (integral_map k1_sum_meas.aemeasurable k1_g_meas.aestronglyMeasurable).symm
    _ = ∫ y : Pt, k1_f y := by
      rw [k1_density, integral_withDensity_eq_integral_toReal_smul hd ht]
      simp only [ENNReal.toReal_ofReal (k1_a_nonneg _), smul_eq_mul, k1_f]

private theorem k1_fubini : 4 * c4K1 = ∫ y : Pt, k1_f y := by
  classical
  let F : ℝ × ℝ × ℝ → ℝ := fun θ =>
    if ‖e1 - circPt θ.1 - circPt θ.2.1 - circPt θ.2.2‖ < 1 then
      c4Kat (circPt θ.1 + circPt θ.2.1) else 0
  have hFmeas : Measurable F := by
    have hd : Measurable (fun θ : ℝ × ℝ × ℝ =>
        ‖e1 - circPt θ.1 - circPt θ.2.1 - circPt θ.2.2‖) :=
      (((measurable_const.sub (k1_circ_meas.comp measurable_fst)).sub
        (k1_circ_meas.comp (measurable_fst.comp measurable_snd))).sub
        (k1_circ_meas.comp (measurable_snd.comp measurable_snd))).norm
    exact Measurable.ite (measurableSet_lt hd measurable_const)
      (k1_Kat_meas.comp ((k1_circ_meas.comp measurable_fst).add
        (k1_circ_meas.comp (measurable_fst.comp measurable_snd)))) measurable_const
  have hFbound (θ : ℝ × ℝ × ℝ) : ‖F θ‖ ≤ 2 := by
    dsimp [F]
    split_ifs
    · exact k1_K_bound _ _
    · simp
  have hFint : Integrable F (k1_mu.prod (k1_mu.prod k1_mu)) :=
    Integrable.of_bound hFmeas.aestronglyMeasurable 2 (Filter.Eventually.of_forall hFbound)
  have hFi (a : ℝ) : Integrable (fun z : ℝ × ℝ => F (a, z)) (k1_mu.prod k1_mu) :=
    Integrable.of_bound (hFmeas.comp (measurable_const.prodMk measurable_id)).aestronglyMeasurable
      2 (Filter.Eventually.of_forall (fun z => hFbound (a, z)))
  have hm : (volume : Measure (ℝ × ℝ × ℝ)).restrict c4box =
      k1_mu.prod (k1_mu.prod k1_mu) := by
    unfold c4box k1_mu
    rw [Measure.prod_restrict, Measure.prod_restrict]
    rfl
  have hinit : 4 * c4K1 = ∫ θ in c4box, F θ := by
    change 4 * (1 / 4 * ∫ θ in c4box, F θ) = ∫ θ in c4box, F θ
    ring
  calc
    4 * c4K1 = ∫ a, ∫ b, ∫ c, F (a, b, c) ∂k1_mu ∂k1_mu ∂k1_mu := by
      rw [hinit, hm, integral_prod F hFint]
      apply integral_congr_ae
      filter_upwards [] with a
      exact integral_prod _ (hFi a)
    _ = ∫ a, ∫ b, k1_g (circPt a + circPt b) ∂k1_mu ∂k1_mu := by
      apply integral_congr_ae
      filter_upwards [] with a
      apply integral_congr_ae
      filter_upwards [] with b
      simpa only [F, k1_mu, k1_g, sub_add_eq_sub_sub] using
        k1_slice (e1 - circPt a - circPt b) (c4Kat (circPt a + circPt b))
    _ = ∫ z : ℝ × ℝ, k1_g (k1_sum z) ∂(k1_mu.prod k1_mu) :=
      (integral_prod _ k1_pair_g_integrable).symm
    _ = ∫ y : Pt, k1_f y := k1_pair_reduction.2

private theorem k1_a_chart (r : ℝ) (h0 : 0 < r) (h2 : r < 2) :
    C1.a r = 2 / c1Y (1 - r ^ 2 / 2) := by
  have hrad : 0 < 4 - r ^ 2 := by nlinarith
  have hs : 0 < Real.sqrt (4 - r ^ 2) := Real.sqrt_pos.mpr hrad
  have hid : 1 - (1 - r ^ 2 / 2) ^ 2 = (r / 2) ^ 2 * (4 - r ^ 2) := by ring
  unfold C1.a c1Y
  rw [if_pos ⟨h0, h2⟩, hid, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by linarith : 0 ≤ r / 2)]
  field_simp
  <;> ring

private theorem k1_b_chart (r : ℝ) (h0 : 0 < r) (h2 : r < 2) :
    C1.b r = c1L (1 - r ^ 2 / 2) := by
  have he : c1L (1 - r ^ 2 / 2) = 2 * Real.arccos (r / 2) := by
    unfold c1L
    apply Real.arccos_eq_of_eq_cos
    · exact mul_nonneg (by norm_num) (Real.arccos_nonneg _)
    · have hh := Real.arccos_le_pi_div_two.mpr (show 0 ≤ r / 2 by linarith)
      linarith
    · rw [Real.cos_two_mul, Real.cos_arccos (by linarith) (by linarith)]
      ring
  simp only [C1.b, h0, h2, and_self, ite_true, he]

private theorem k1_chart_reflect (y : Pt) :
    c4chart (e1 - y) = ((c4chart y).2, (c4chart y).1) := by
  have he : e1 - (e1 - y) = y := by abel
  simp only [c4chart, he]

private theorem k1_Kat_reflect (y : Pt) : c4Kat (e1 - y) = c4Kat y := by
  unfold c4Kat
  rw [k1_chart_reflect]
  exact k1_K_symm _ _

private def k1_phys (s : Bool) (y : Pt) : ℝ :=
  k1_f (if s then e1 - y else y)

private def k1_G (s : Bool) (z : ℝ × ℝ) : ℝ :=
  if s then 2 * c4K z.1 z.2 * c1L z.1 / c1Y z.2
  else 2 * c4K z.1 z.2 * c1L z.2 / c1Y z.1

private def k1_S : Set Pt := {y : Pt | ‖y‖ < 2 ∧ ‖e1 - y‖ < 2}

private theorem k1_S_meas : MeasurableSet k1_S :=
  (measurableSet_lt measurable_norm measurable_const).inter
    (measurableSet_lt (measurable_const.sub measurable_id).norm measurable_const)

private theorem k1_phys_int (s : Bool) : Integrable (k1_phys s) := by
  cases s
  · exact k1_pair_reduction.1
  · exact ((Measure.measurePreserving_sub_left (volume : Measure Pt) e1).integrable_comp
      k1_pair_reduction.1.aestronglyMeasurable).2 k1_pair_reduction.1

private theorem k1_phys_integral (s : Bool) : ∫ y : Pt, k1_phys s y = ∫ y : Pt, k1_f y := by
  cases s
  · rfl
  · change (∫ y : Pt, k1_f (e1 - y)) = ∫ y : Pt, k1_f y
    have hm := (Measure.measurePreserving_sub_left (volume : Measure Pt) e1).map_eq
    calc
      _ = ∫ y : Pt, k1_f y ∂(Measure.map (fun y : Pt => e1 - y) volume) :=
        (integral_map (measurable_const.sub measurable_id).aemeasurable
          k1_f_meas.aestronglyMeasurable).symm
      _ = _ := by rw [hm]

private theorem k1_phys_chart (s : Bool) (y : Pt)
    (hy0 : 0 < ‖y‖) (hy2 : ‖y‖ < 2) (he0 : 0 < ‖e1 - y‖) (he2 : ‖e1 - y‖ < 2) :
    k1_phys s y = k1_G s (c4chart y) := by
  have he : e1 - (e1 - y) = y := by abel
  cases s
  · simp only [k1_phys, Bool.false_eq_true, if_false, k1_f, k1_g]
    rw [k1_a_chart ‖y‖ hy0 hy2, k1_b_chart ‖e1 - y‖ he0 he2]
    simp only [k1_G, Bool.false_eq_true, if_false, c4Kat, c4chart]
    ring
  · simp only [k1_phys, Bool.true_eq, if_true, k1_f, k1_g, he, k1_Kat_reflect]
    rw [k1_a_chart ‖e1 - y‖ he0 he2, k1_b_chart ‖y‖ hy0 hy2]
    simp only [k1_G, Bool.true_eq, if_true, c4Kat, c4chart]
    ring

private theorem k1_phys_zero (s : Bool) (y : Pt) (hy : y ∉ k1_S) : k1_phys s y = 0 := by
  have he : e1 - (e1 - y) = y := by abel
  change ¬(‖y‖ < 2 ∧ ‖e1 - y‖ < 2) at hy
  by_cases h : ‖y‖ < 2
  · have hn : ¬‖e1 - y‖ < 2 := fun ht => hy ⟨h, ht⟩
    cases s <;> simp [k1_phys, k1_f, k1_g, he, C1.a, C1.b, hn]
  · cases s <;> simp [k1_phys, k1_f, k1_g, he, C1.a, C1.b, h]

private theorem k1_phys_chart_ae (s : Bool) :
    k1_phys s =ᵐ[volume.restrict k1_S] (fun y => k1_G s (c4chart y)) := by
  filter_upwards [ae_restrict_mem k1_S_meas,
    (volume.restrict k1_S).ae_ne (0 : Pt), (volume.restrict k1_S).ae_ne e1] with y hy hy0 hye
  exact k1_phys_chart s y (norm_pos_iff.mpr hy0) hy.1
    (norm_pos_iff.mpr (sub_ne_zero.mpr hye.symm)) hy.2

private theorem k1_result (s : Bool) :
    4 * c4K1 = ∫ z in c1Domain, 4 / Real.sqrt (chartH z.1 z.2) * k1_G s z := by
  have hphysical : IntegrableOn (fun y => k1_G s (c4chart y)) k1_S :=
    (k1_phys_int s).integrableOn.congr (k1_phys_chart_ae s)
  have hchart : IntegrableOn (fun z => k1_G s z / Real.sqrt (chartH z.1 z.2)) c1Domain :=
    k1_sheet_back true (k1_G s) hphysical
  calc
    4 * c4K1 = ∫ y : Pt, k1_phys s y :=
      k1_fubini.trans (k1_phys_integral s).symm
    _ = ∫ y in k1_S, k1_phys s y :=
      (setIntegral_eq_integral_of_forall_compl_eq_zero (k1_phys_zero s)).symm
    _ = ∫ y in k1_S, k1_G s (c4chart y) := integral_congr_ae (k1_phys_chart_ae s)
    _ = ∫ z in c1Domain, 4 / Real.sqrt (chartH z.1 z.2) * k1_G s z :=
      HardDiskB5.C4.chart_cov (k1_G s) hchart

theorem solution_s12569092 :
    4 * c4K1 = 8 * ∫ z in c1Domain, c4K z.1 z.2 * c1L z.2 / (c1Y z.1 * Real.sqrt (chartH z.1 z.2)) ∧
    4 * c4K1 = 8 * ∫ z in c1Domain, c4K z.1 z.2 * c1L z.1 / (c1Y z.2 * Real.sqrt (chartH z.1 z.2)) := by
  constructor
  · calc
      4 * c4K1 = ∫ z in c1Domain, 4 / Real.sqrt (chartH z.1 z.2) * k1_G false z :=
        k1_result false
      _ = 8 * ∫ z in c1Domain,
          c4K z.1 z.2 * c1L z.2 / (c1Y z.1 * Real.sqrt (chartH z.1 z.2)) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards [] with z
        simp only [k1_G, Bool.false_eq_true, if_false, div_eq_mul_inv, mul_inv_rev]
        ring
  · calc
      4 * c4K1 = ∫ z in c1Domain, 4 / Real.sqrt (chartH z.1 z.2) * k1_G true z :=
        k1_result true
      _ = 8 * ∫ z in c1Domain,
          c4K z.1 z.2 * c1L z.1 / (c1Y z.2 * Real.sqrt (chartH z.1 z.2)) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards [] with z
        simp only [k1_G, Bool.true_eq, if_true, div_eq_mul_inv, mul_inv_rev]
        ring
