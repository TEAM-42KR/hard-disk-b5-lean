    {x : Fin 2 → ℝ | (1 / 4 : ℝ) < |s 0 * x 1 - s 1 * x 0|}.indicator
      (fun x => h ![4 - (x 0) ^ 2 - (x 1) ^ 2,
        4 - (s 0 - x 0) ^ 2 - (s 1 - x 1) ^ 2])
  have hs : MeasurableSet {x : Fin 2 → ℝ | (1 / 4 : ℝ) < |s 0 * x 1 - s 1 * x 0|} := by
    exact (isOpen_lt continuous_const (by fun_prop)).measurableSet
  have hg : Integrable g := hc.1.integrable_indicator hs
  have hp : Integrable (g ∘ WithLp.ofLp : Pt → ℝ) :=
    PiLp.volume_preserving_ofLp (ι := Fin 2) |>.integrable_comp_of_integrable hg
  have heq : {y : Pt | (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|}.indicator
      (fun y => h (cvPtChart s y)) = (g ∘ WithLp.ofLp : Pt → ℝ) := by
    funext y
    change (if (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0| then h (cvPtChart s y) else 0) =
      (if (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0| then
        h ![4 - (y 0) ^ 2 - (y 1) ^ 2,
          4 - (s 0 - y 0) ^ 2 - (s 1 - y 1) ^ 2] else 0)
    split_ifs
    · congr 1
      unfold cvPtChart
      simp only [cvNormSq, PiLp.sub_apply, sub_add_eq_sub_sub]
    · rfl
  have hieq : (∫ y : Pt, (g ∘ WithLp.ofLp) y) = ∫ x, g x :=
    (PiLp.volume_preserving_ofLp (ι := Fin 2)).integral_comp
      (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.measurableEmbedding g
  constructor
  · apply (integrable_indicator_iff (cvHighMeas s)).mp
    rw [heq]
    exact hp
  · rw [← integral_indicator (cvHighMeas s), heq, hieq]
    change (∫ x, g x) ≤ 2 * ∫ z, h z
    unfold g
    rw [integral_indicator hs]
    exact hc.2

private theorem cvHighError (n : ℕ) (s y : Pt) (hs : ‖s‖ ^ 2 ≤ 5 / 4)
    (hy : (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|) :
    C1.a ‖y‖ * cvDefect n ‖s-y‖ ≤ 1024 * cvTail n (cvPtChart s y) := by
  have hlev : 0 ≤ cvLevel n := le_trans (by norm_num) (cvLevelPos n)
  by_cases ht : C1.a ‖s-y‖ ≤ cvLevel n
  · have hz : cvDefect n ‖s-y‖ = 0 := by simp only [cvDefect, min_eq_left ht, sub_self]
    rw [hz, mul_zero]
    exact mul_nonneg (by norm_num) (cvTailNonneg _ _)
  have hr := cvHighRadii s y hs hy
  have hb1 := cvABound _ hr.1
  have hb2 := cvABound _ hr.2
  have hIf : cvLevel n < 32 * cvRoot (4 - ‖s-y‖ ^ 2) := lt_of_lt_of_le (lt_of_not_ge ht) hb2
  change C1.a ‖y‖ * cvDefect n ‖s-y‖ ≤
    1024 * (if cvLevel n < 32 * cvRoot (4 - ‖s-y‖ ^ 2) then
      cvRoot (4 - ‖y‖ ^ 2) * cvRoot (4 - ‖s-y‖ ^ 2) else 0)
  rw [if_pos hIf]
  calc
    C1.a ‖y‖ * cvDefect n ‖s-y‖ ≤ C1.a ‖y‖ * C1.a ‖s-y‖ :=
      mul_le_mul_of_nonneg_left (cvDefectUpper n _) (cvANonneg _)
    _ ≤ (32 * cvRoot (4 - ‖y‖ ^ 2)) * (32 * cvRoot (4 - ‖s-y‖ ^ 2)) :=
      mul_le_mul hb1 hb2 (cvANonneg _) (mul_nonneg (by norm_num) (cvRootNonneg _))
    _ = 1024 * (cvRoot (4 - ‖y‖ ^ 2) * cvRoot (4 - ‖s-y‖ ^ 2)) := by ring

private theorem cvErrorPointwise (n : ℕ) (s y : Pt)
    (hslo : 3 / 4 ≤ ‖s‖ ^ 2) (hshi : ‖s‖ ^ 2 ≤ 5 / 4) :
    C1.a ‖y‖ * cvDefect n ‖s-y‖ ≤ 32 * cvDefect n ‖s-y‖ +
      1024 * {y : Pt | (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|}.indicator
        (fun y => cvTail n (cvPtChart s y)) y := by
  have hq := cvDefectNonneg n ‖s-y‖
  have ht : 0 ≤ {y : Pt | (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|}.indicator
      (fun y => cvTail n (cvPtChart s y)) y := by
    change 0 ≤ if (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0| then cvTail n (cvPtChart s y) else 0
    split_ifs
    · exact cvTailNonneg _ _
    · exact le_rfl
  rcases cvSupportCover s y hslo hshi with hz | (hm | hh)
  · have hprod := mul_le_mul_of_nonneg_left (cvDefectUpper n ‖s-y‖) (cvANonneg ‖y‖)
    nlinarith
  · rcases hm with hm | hm
    · have hb := mul_le_mul_of_nonneg_right (cvAMidBound _ hm.1 hm.2) hq
      nlinarith
    · have hle : C1.a ‖s-y‖ ≤ cvLevel n := le_trans (cvAMidBound _ hm.1 hm.2) (cvLevelPos n)
      have hz : cvDefect n ‖s-y‖ = 0 := by simp only [cvDefect, min_eq_left hle, sub_self]
      rw [hz, mul_zero, mul_zero, zero_add]
      positivity
  · rw [Set.indicator_of_mem hh]
    have hb := cvHighError n s y hshi hh
    nlinarith

private theorem cvErrorBound (n : ℕ) (s : Pt) (hslo : 3 / 4 ≤ ‖s‖ ^ 2)
    (hshi : ‖s‖ ^ 2 ≤ 5 / 4) :
    |(∫ y : Pt, C1.a ‖y‖ * C1.a ‖s-y‖) -
      (∫ y : Pt, C1.a ‖y‖ * min (C1.a ‖s-y‖) (cvLevel n))| ≤
        32 * (∫ y : Pt, cvDefect n ‖y‖) + 2048 * ∫ z, cvTail n z := by
  have hf := cvIntBand s hslo hshi
  have hlev : 0 ≤ cvLevel n := le_trans (by norm_num) (cvLevelPos n)
  have hg := cvClipInt s (cvLevel n) hlev
  have he : Integrable (fun y : Pt => C1.a ‖y‖ * cvDefect n ‖s-y‖) := by
    convert hf.sub hg using 1
    funext y
    dsimp only [Pi.sub_apply]
    unfold cvDefect
    ring
  have hqt : Integrable (fun y : Pt => cvDefect n ‖s-y‖) :=
    (integrable_comp_sub_left (fun y : Pt => cvDefect n ‖y‖) s).mpr (cvDefectInt n)
  have htail := cvPullPt s (cvTail n) (cvTailMeas n) (cvTailInt n) (cvTailNonneg n)
  have hti := htail.1.integrable_indicator (cvHighMeas s)
  have hdiff : (∫ y : Pt, C1.a ‖y‖ * C1.a ‖s-y‖) -
      (∫ y : Pt, C1.a ‖y‖ * min (C1.a ‖s-y‖) (cvLevel n)) =
        ∫ y : Pt, C1.a ‖y‖ * cvDefect n ‖s-y‖ := by
    calc
      _ = ∫ y : Pt, C1.a ‖y‖ * C1.a ‖s-y‖ -
          C1.a ‖y‖ * min (C1.a ‖s-y‖) (cvLevel n) := (integral_sub hf hg).symm
      _ = _ := integral_congr_ae (Filter.Eventually.of_forall (fun y => by
        change C1.a ‖y‖ * C1.a ‖s-y‖ - C1.a ‖y‖ * min (C1.a ‖s-y‖) (cvLevel n) =
          C1.a ‖y‖ * cvDefect n ‖s-y‖
        unfold cvDefect
        ring))
  rw [hdiff, abs_of_nonneg (integral_nonneg (fun y => mul_nonneg (cvANonneg _) (cvDefectNonneg n _)))]
  calc
    (∫ y : Pt, C1.a ‖y‖ * cvDefect n ‖s-y‖) ≤
        ∫ y : Pt, 32 * cvDefect n ‖s-y‖ +
          1024 * {y : Pt | (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|}.indicator
            (fun y => cvTail n (cvPtChart s y)) y :=
      integral_mono_ae he ((hqt.const_mul 32).add (hti.const_mul 1024))
        (Filter.Eventually.of_forall (fun y => cvErrorPointwise n s y hslo hshi))
    _ = 32 * (∫ y : Pt, cvDefect n ‖s-y‖) +
        1024 * ∫ y in {y : Pt | (1 / 4 : ℝ) < |s 0 * y 1 - s 1 * y 0|},
          cvTail n (cvPtChart s y) := by
      rw [integral_add (hqt.const_mul 32) (hti.const_mul 1024), integral_const_mul,
        integral_const_mul, integral_indicator (cvHighMeas s)]
    _ ≤ 32 * (∫ y : Pt, cvDefect n ‖s-y‖) + 2048 * ∫ z, cvTail n z := by
      nlinarith [htail.2]
    _ = 32 * (∫ y : Pt, cvDefect n ‖y‖) + 2048 * ∫ z, cvTail n z := by
      rw [integral_sub_left_eq_self (fun y : Pt => cvDefect n ‖y‖) volume s]

theorem solution_s12569615 :
    ∃ b : ℕ → ℝ, Filter.Tendsto b Filter.atTop (nhds 0) ∧
      ∀ (n : ℕ) (s : Pt), (3 / 4 : ℝ) ≤ ‖s‖ ^ 2 → ‖s‖ ^ 2 ≤ 5 / 4 →
        |(∫ y : Pt, C1.a ‖y‖ * C1.a ‖s - y‖) -
          (∫ y : Pt, C1.a ‖y‖ * min (C1.a ‖s - y‖) ((n : ℝ) + 32))| ≤ b n := by
  refine ⟨fun n => 32 * (∫ y : Pt, cvDefect n ‖y‖) + 2048 * ∫ z, cvTail n z, ?_, ?_⟩
  · have h := (cvDefectDecay.const_mul 32).add (cvTailDecay.const_mul 2048)
    simpa only [mul_zero, add_zero] using h
  · intro n s hslo hshi
    exact cvErrorBound n s hslo hshi
